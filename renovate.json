{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^typescript/template/package\\.json$/"],
      "matchStrings": ["\"(?<depName>@?[a-z0-9][^\"]*)\": \"\\^(?<currentValue>\\d[^\"]*)\""],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^typescript/template/package\\.json$/"],
      "matchStrings": ["\"packageManager\": \"yarn@(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "yarn",
      "packageNameTemplate": "@yarnpkg/cli-dist",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Emulator images; the Jinja blocks in this file stop the docker-compose manager from parsing it",
      "managerFilePatterns": ["/^shared/docker-compose\\.yml$/"],
      "matchStrings": ["image: (?<depName>[^:\\s]+):(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Atmos for the generated deploy workflow and the infrastructure CI",
      "managerFilePatterns": ["/^copier\\.yml$/"],
      "matchStrings": ["\\n    atmos: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "cloudposse/atmos",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Terraform for the generated deploy workflow and the infrastructure CI",
      "managerFilePatterns": ["/^copier\\.yml$/"],
      "matchStrings": ["\\n    terraform: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group non-major dependency updates per language template",
      "matchFileNames": ["python/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python dependencies (non-major)"
    },
    {
      "matchFileNames": ["typescript/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "typescript dependencies (non-major)"
    },
    {
      "matchFileNames": ["dotnet/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dotnet dependencies (non-major)"
    },
    {
      "matchFileNames": ["go/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go dependencies (non-major)"
    },
    {
      "matchFileNames": ["tests/integration/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "integration test dependencies (non-major)",
      "description": "The integration tests do not run on pull requests, so these updates wait for a review",
      "automerge": false
    },
    {
      "description": "Group GitHub Actions updates together",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "The Cosmos DB vNext emulator is tagged by release date (vnext-EN<yyyymmdd>)",
      "matchPackageNames": ["mcr.microsoft.com/cosmosdb/linux/azure-cosmos-emulator"],
      "versioning": "regex:^vnext-EN(?<major>\\d{8})$"
    },
    {
      "description": "@types/node follows the Node.js runtime the clouds support, so its major moves with the runtime",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
