{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node", "jest"],
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "strict": false,
    "paths": {
      "@config/*": ["./config/*"],
      "@controllers": ["./controllers/index"],
      "@services": ["./services/index"],
      "@repositories": ["./repositories/index"],
      "@models": ["./types/models/index"],
      "@errors": ["./types/errors/index"],
      "@utils": ["./utils/index"]
    }
  }
}
