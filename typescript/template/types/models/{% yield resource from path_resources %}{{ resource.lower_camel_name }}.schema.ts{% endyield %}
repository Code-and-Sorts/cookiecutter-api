{%- set r = resource.name -%}
import { z } from 'zod';
import { BaseIdentifier, BaseSchema } from './base.schema';

// The fields clients send and receive. Add fields here: they flow into the request,
// update, response and stored entity schemas below.
export const {{ r }}Schema = z.object({
    name: z.string().min(1),
});

// POST and PUT bodies: every field required, unknown fields (including id and the
// system fields) rejected.
export const {{ r }}RequestSchema = {{ r }}Schema.strict();

// PATCH bodies: every field optional but still validated, unknown fields rejected.
export const {{ r }}UpdateSchema = {{ r }}Schema.partial().strict();

export const {{ r }}ResponseSchema = z.object({
    ...BaseIdentifier.shape,
    ...{{ r }}Schema.shape,
});

export const {{ r }}EntitySchema = z.object({
    ...{{ r }}Schema.shape,
    ...BaseSchema.shape,
});

export type {{ r }}Record = z.infer<typeof {{ r }}EntitySchema>;

export type {{ r }} = z.infer<typeof {{ r }}Schema>;

export type {{ r }}Response = z.infer<typeof {{ r }}ResponseSchema>;

export type {{ r }}Update = z.infer<typeof {{ r }}UpdateSchema>;
