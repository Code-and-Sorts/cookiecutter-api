{%- from 'shared/_fields.jinja' import REQUEST_KINDS -%}
{%- from 'typescript/_model.jinja' import field_imports, model_types -%}
{%- set r = resource.name -%}
{%- set kinds = REQUEST_KINDS | selectattr(0, "in", resource.operations) | list -%}
{%- set body %}
{{ model_types(r, r ~ "Record", resource.fields, kinds) }}
{%- endset -%}
{% if kinds %}import { z } from 'zod';
{% endif %}{{ field_imports(body) }}import {
{%- for kind in kinds | map(attribute=1) %}
    Base{{ kind }}RequestSchema,
{%- endfor %}
    BaseEntity,
    BaseResponse,
    toBaseResponse,
} from './base.schema';
{{ body }}
