{%- set r = resource.name -%}
{%- set c = resource.name | to_lower_camel -%}
{%- set ops = resource.operations -%}
{%- if cloud_service == 'GCP Cloud Function' -%}
import * as ff from '@google-cloud/functions-framework';
{%- else -%}
import { APIGatewayProxyEvent, APIGatewayProxyResult } from 'aws-lambda';
{%- endif %}
import { {{ c }}Controller } from '@config/container';
{%- if ops | select('in', ['create', 'update', 'replace']) | list %}
import { {{ r }} } from '@models';
{%- endif %}
import { jsonResponse, notAllowed } from './response';
{%- if cloud_service == 'GCP Cloud Function' %}

// Handles /{{ resource.endpoint }} and /{{ resource.endpoint }}/{id}. Errors propagate to the entry point.
export const {{ c }}Routes = async (req: ff.Request, res: ff.Response, id?: string): Promise<void> => {
  switch (req.method) {
    case 'GET': {
      if (id) {
{%- if "get_by_id" in ops %}
        return jsonResponse(res, 200, await {{ c }}Controller.get(id));
{%- else %}
        return notAllowed(res);
{%- endif %}
      }
{%- if "list" in ops %}
      return jsonResponse(res, 200, await {{ c }}Controller.list(req.query.limit as string | undefined));
{%- else %}
      return notAllowed(res);
{%- endif %}
    }
    case 'POST': {
{%- if "create" in ops %}
      return jsonResponse(res, 201, await {{ c }}Controller.post(req.body as {{ r }}));
{%- else %}
      return notAllowed(res);
{%- endif %}
    }
    case 'PATCH': {
{%- if "update" in ops %}
      return jsonResponse(res, 200, await {{ c }}Controller.update({ ...(req.body as {{ r }}), id }));
{%- else %}
      return notAllowed(res);
{%- endif %}
    }
    case 'PUT': {
{%- if "replace" in ops %}
      return jsonResponse(res, 200, await {{ c }}Controller.replace({ ...(req.body as {{ r }}), id }));
{%- else %}
      return notAllowed(res);
{%- endif %}
    }
    case 'DELETE': {
{%- if "delete" in ops %}
      if (!id) return jsonResponse(res, 400, { error: 'Missing item ID.' });
      await {{ c }}Controller.delete(id);
      return jsonResponse(res, 200, { message: `{{ resource.endpoint }} with ID ${id} deleted.` });
{%- else %}
      return notAllowed(res);
{%- endif %}
    }
    default:
      return notAllowed(res);
  }
};
{%- else %}

// Handles /{{ resource.endpoint }} and /{{ resource.endpoint }}/{id}. Errors propagate to the handler.
export const {{ c }}Routes = async (event: APIGatewayProxyEvent, id?: string): Promise<APIGatewayProxyResult> => {
  switch (event.httpMethod) {
    case 'GET': {
      if (id) {
{%- if "get_by_id" in ops %}
        return jsonResponse(200, await {{ c }}Controller.get(id));
{%- else %}
        return notAllowed();
{%- endif %}
      }
{%- if "list" in ops %}
      return jsonResponse(200, await {{ c }}Controller.list(event.queryStringParameters?.limit ?? undefined));
{%- else %}
      return notAllowed();
{%- endif %}
    }
    case 'POST': {
{%- if "create" in ops %}
      const item: {{ r }} = JSON.parse(event.body || '{}');
      return jsonResponse(201, await {{ c }}Controller.post(item));
{%- else %}
      return notAllowed();
{%- endif %}
    }
    case 'PATCH': {
{%- if "update" in ops %}
      const item: {{ r }} = JSON.parse(event.body || '{}');
      return jsonResponse(200, await {{ c }}Controller.update({ ...item, id }));
{%- else %}
      return notAllowed();
{%- endif %}
    }
    case 'PUT': {
{%- if "replace" in ops %}
      const item: {{ r }} = JSON.parse(event.body || '{}');
      return jsonResponse(200, await {{ c }}Controller.replace({ ...item, id }));
{%- else %}
      return notAllowed();
{%- endif %}
    }
    case 'DELETE': {
{%- if "delete" in ops %}
      if (!id) {
        return jsonResponse(400, { error: 'Missing item ID.' });
      }
      await {{ c }}Controller.delete(id);
      return jsonResponse(200, { message: `{{ resource.endpoint }} with ID ${id} deleted.` });
{%- else %}
      return notAllowed();
{%- endif %}
    }
    default:
      return notAllowed();
  }
};
{%- endif %}
