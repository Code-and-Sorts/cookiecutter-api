import { APIGatewayProxyEvent, APIGatewayProxyResult } from 'aws-lambda';
import {
{%- for resource in resources %}
  {{ resource.name | to_lower_camel }}Controller,
{%- endfor %}
} from '@config/inversity.config';
import {
{%- for resource in resources %}
  {{ resource.name }},
{%- endfor %}
} from '@models';
import { detectError } from '@utils';

const jsonResponse = (statusCode: number, body: unknown): APIGatewayProxyResult => ({
  statusCode,
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify(body),
});

const notAllowed = () => jsonResponse(405, { error: 'Method not allowed.' });
{% for resource in resources %}
{%- set c = resource.name | to_lower_camel %}
const handle{{ resource.name }} = async (event: APIGatewayProxyEvent, id?: string): Promise<APIGatewayProxyResult> => {
  switch (event.httpMethod) {
    case 'GET': {
      if (id) {
{%- if "get_by_id" in resource.operations %}
        return jsonResponse(200, await {{ c }}Controller.get(id));
{%- else %}
        return notAllowed();
{%- endif %}
      }
{%- if "list" in resource.operations %}
      return jsonResponse(200, await {{ c }}Controller.list(event.queryStringParameters?.limit ?? undefined));
{%- else %}
      return notAllowed();
{%- endif %}
    }
    case 'POST': {
{%- if "create" in resource.operations %}
      const item: {{ resource.name }} = JSON.parse(event.body || '{}');
      return jsonResponse(201, await {{ c }}Controller.post(item));
{%- else %}
      return notAllowed();
{%- endif %}
    }
    case 'PATCH': {
{%- if "update" in resource.operations %}
      const item: {{ resource.name }} = JSON.parse(event.body || '{}');
      return jsonResponse(200, await {{ c }}Controller.update({ id, ...item }));
{%- else %}
      return notAllowed();
{%- endif %}
    }
    case 'PUT': {
{%- if "replace" in resource.operations %}
      const item: {{ resource.name }} = JSON.parse(event.body || '{}');
      return jsonResponse(200, await {{ c }}Controller.replace({ id, ...item }));
{%- else %}
      return notAllowed();
{%- endif %}
    }
    case 'DELETE': {
{%- if "delete" in resource.operations %}
      if (!id) {
        return jsonResponse(400, { error: 'Missing item ID.' });
      }
      await {{ c }}Controller.delete(id);
      return jsonResponse(200, { message: `{{ resource.endpoint }} with ID ${id} deleted.` });
{%- else %}
      return notAllowed();
{%- endif %}
    }
    default:
      return notAllowed();
  }
};
{% endfor %}
export const handler = async (event: APIGatewayProxyEvent): Promise<APIGatewayProxyResult> => {
  // ``resource`` is the API Gateway route template (e.g. "/cats/{id}"); its
  // first segment is the literal endpoint used to resolve the resource.
  const routePath = (event.resource || event.path || '').replace(/\/+$/, '');
  if (event.httpMethod === 'GET' && routePath.endsWith('/health')) {
    return jsonResponse(200, { status: 'ok' });
  }

  const endpoint = routePath.split('/').filter(Boolean)[0];
  const id = event.pathParameters?.id;

  try {
    switch (endpoint) {
{%- for resource in resources %}
      case '{{ resource.endpoint }}':
        return await handle{{ resource.name }}(event, id);
{%- endfor %}
      default:
        return jsonResponse(404, { error: 'Not found.' });
    }
  } catch (error) {
    const errorResponse = detectError(error);
    return jsonResponse(errorResponse.status, errorResponse.body);
  }
};
