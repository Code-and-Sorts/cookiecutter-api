import { context } from '@opentelemetry/api';
import { APIGatewayProxyEvent, APIGatewayProxyResult } from 'aws-lambda';
import {
  errorResponse,
{%- if health_endpoint %}
  healthRoutes,
{%- endif %}
  notFound,
{%- for resource in resources %}
  {{ resource.name | to_lower_camel }}Routes,
{%- endfor %}
} from '@routes';
import { loggerProvider, traceContext } from '@utils';

// template.yaml maps only the enabled operations; API Gateway answers other paths and methods itself.
const dispatch = async (event: APIGatewayProxyEvent): Promise<APIGatewayProxyResult> => {
  const segments = (event.resource || event.path || '').split('/').filter(Boolean);
  const endpoint = segments[0];
  const id = segments.length > 1 ? event.pathParameters?.id : undefined;

  try {
    if (segments.length > 2 || (segments.length === 2 && id === undefined)) {
      return notFound();
    }
    switch (endpoint) {
{%- if health_endpoint %}
      case '{{ health_endpoint }}':
        return id === undefined ? await healthRoutes(event) : notFound();
{%- endif %}
{%- for resource in resources %}
      case '{{ resource.endpoint }}':
        return await {{ resource.name | to_lower_camel }}Routes(event, id);
{%- endfor %}
      default:
        return notFound();
    }
  } catch (error) {
    return errorResponse(error);
  }
};

export const handler = async (event: APIGatewayProxyEvent): Promise<APIGatewayProxyResult> => {
  try {
    return await context.with(traceContext(event.headers), () => dispatch(event));
  } finally {
    // Lambda freezes the process once the handler returns, so batched records are sent now.
    await loggerProvider.forceFlush();
  }
};
