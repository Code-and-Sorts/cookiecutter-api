import { APIGatewayProxyEvent, APIGatewayProxyResult } from 'aws-lambda';
import { controllers } from '@config/inversity.config';
import { Item } from '@models';
import { detectError } from '@utils';

// Endpoint -> its container and enabled operations.
const RESOURCES: Record<string, { container: string; operations: string[] }> = {
{%- for resource in resources %}
  '{{ resource.endpoint }}': { container: '{{ resource.container }}', operations: {{ resource.operations | tojson }} },
{%- endfor %}
};

const jsonResponse = (statusCode: number, body: unknown): APIGatewayProxyResult => ({
  statusCode,
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify(body),
});

const notAllowed = () => jsonResponse(405, { error: 'Method not allowed.' });

export const handler = async (event: APIGatewayProxyEvent): Promise<APIGatewayProxyResult> => {
  // ``resource`` is the API Gateway route template (e.g. "/cats/{id}"); its
  // first segment is the literal endpoint used to resolve the resource.
  const routePath = (event.resource || event.path || '').replace(/\/+$/, '');
  if (event.httpMethod === 'GET' && routePath.endsWith('/health')) {
    return jsonResponse(200, { status: 'ok' });
  }

  const endpoint = routePath.split('/').filter(Boolean)[0];
  const id = event.pathParameters?.id;
  const resource = RESOURCES[endpoint];
  if (!resource) {
    return jsonResponse(404, { error: 'Not found.' });
  }

  const controller = controllers[resource.container];
  const has = (op: string) => resource.operations.includes(op);

  try {
    switch (event.httpMethod) {
      case 'GET': {
        if (id) {
          if (!has('get_by_id')) return notAllowed();
          return jsonResponse(200, await controller.get(id));
        }
        if (!has('list')) return notAllowed();
        return jsonResponse(200, await controller.list(event.queryStringParameters?.limit ?? undefined));
      }

      case 'POST': {
        if (!has('create')) return notAllowed();
        const item: Item = JSON.parse(event.body || '{}');
        return jsonResponse(201, await controller.post(item));
      }

      case 'PATCH': {
        if (!has('update')) return notAllowed();
        const item: Item = JSON.parse(event.body || '{}');
        return jsonResponse(200, await controller.update({ id, ...item }));
      }

      case 'PUT': {
        if (!has('replace')) return notAllowed();
        const item: Item = JSON.parse(event.body || '{}');
        return jsonResponse(200, await controller.replace({ id, ...item }));
      }

      case 'DELETE': {
        if (!has('delete')) return notAllowed();
        if (!id) {
          return jsonResponse(400, { error: 'Missing item ID.' });
        }
        await controller.delete(id);
        return jsonResponse(200, { message: `${endpoint} with ID ${id} deleted.` });
      }

      default:
        return notAllowed();
    }
  } catch (error) {
    const errorResponse = detectError(error);
    return jsonResponse(errorResponse.status, errorResponse.body);
  }
};
