{
  "name": "{{project_endpoint}}",
  "version": "1.0.0",
  "description": "{{project_description}}",
  "packageManager": "yarn@4.18.1",
  "type": "module",
{%- if cloud_service == 'Azure Function App' %}
  "main": "dist/functions/*.js",
{%- endif %}
{%- if cloud_service == 'GCP Cloud Function' %}
  "main": "dist/main.js",
{%- endif %}
{%- if cloud_service == 'AWS Lambda' %}
  "main": "dist/lambda.js",
  "files": [
    "dist"
  ],
{%- endif %}
  "engines": {
    "node": ">={{ runtime.node }}"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && tsc-alias",
{%- if cloud_service == 'Azure Function App' %}
    "start": "func start --typescript",
{%- endif %}
{%- if cloud_service == 'GCP Cloud Function' %}
    "start": "functions-framework --target=api",
{%- endif %}
{%- if cloud_service == 'AWS Lambda' %}
    "start": "node dist/lambda.js",
{%- endif %}
    "emulator:up": "docker compose up -d --wait",
    "emulator:seed": "rm -rf dist-scripts && tsc -p tsconfig.scripts.json && tsc-alias -p tsconfig.scripts.json && DOTENV_CONFIG_PATH=.env.emulator DOTENV_CONFIG_OVERRIDE=true node dist-scripts/scripts/bootstrapEmulator.js",
    "emulator:down": "docker compose down -v",
    "emulator:logs": "docker compose logs -f",
{%- if cloud_service == 'Azure Function App' %}
    "start:emulator": "yarn build && DOTENV_CONFIG_PATH=.env.emulator DOTENV_CONFIG_OVERRIDE=true func start --typescript",
{%- endif %}
{%- if infra_containers %}
    "start:container": "docker compose --profile api up --build api",
{%- endif %}
{%- if cloud_service == 'GCP Cloud Function' %}
    "start:emulator": "yarn build && DOTENV_CONFIG_PATH=.env.emulator DOTENV_CONFIG_OVERRIDE=true functions-framework --target=api",
{%- endif %}
{%- if cloud_service == 'AWS Lambda' %}
    "start:emulator": "yarn build && sam build && AWS_ACCESS_KEY_ID=emulator AWS_SECRET_ACCESS_KEY=emulator sam local start-api --warm-containers LAZY --env-vars env.emulator.json --docker-network {{ project_endpoint }}-emulator",
{%- endif %}
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --verbose --coverage",
    "lint": "eslint .",
    "format": "eslint --fix . && prettier --write .",
    "audit": "yarn npm audit --severity moderate"
  },
  "dependencies": {
{%- if cloud_service == 'Azure Function App' %}
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.13.3",
{%- endif %}
{%- if cloud_service == 'GCP Cloud Function' %}
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/functions-framework": "^5.0.5",
{%- endif %}
{%- if cloud_service == 'AWS Lambda' %}
    "@aws-sdk/client-dynamodb": "^3.1139.0",
    "@aws-sdk/lib-dynamodb": "^3.1139.0",
{%- endif %}
    "dotenv": "^18.0.3",
    "inversify": "^8.2.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
{%- if cloud_service == 'Azure Function App' %}
    "@types/node": "^22.20.4",
{%- else %}
    "@types/node": "^24.19.0",
{%- endif %}
{%- if cloud_service == 'Azure Function App' %}
    "azure-functions-core-tools": "^4.15.1",
{%- endif %}
{%- if cloud_service == 'AWS Lambda' %}
    "@types/aws-lambda": "^8.10.163",
{%- endif %}
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.13",
    "tsc-alias": "^1.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "author": "{{author}}",
  "license": "ISC"
}
