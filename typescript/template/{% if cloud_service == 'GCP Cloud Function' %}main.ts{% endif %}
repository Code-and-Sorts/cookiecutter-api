import * as ff from '@google-cloud/functions-framework';
import { controllers } from '@config/inversity.config';
import { Item } from '@models';
import { detectError } from '@utils';

// Endpoint -> its container and enabled operations.
const RESOURCES: Record<string, { container: string; operations: string[] }> = {
{%- for resource in resources %}
  '{{ resource.endpoint }}': { container: '{{ resource.container }}', operations: {{ resource.operations | tojson }} },
{%- endfor %}
};

const jsonResponse = (res: ff.Response, status: number, body: unknown): void => {
  res.status(status).json(body);
};

const notAllowed = (res: ff.Response) => jsonResponse(res, 405, { error: 'Method not allowed.' });

ff.http('api', async (req: ff.Request, res: ff.Response) => {
  const cleanPath = req.path.replace(/\/+$/, '');
  if (cleanPath.endsWith('/health')) {
    return jsonResponse(res, 200, { status: 'ok' });
  }

  const segments = cleanPath.split('/').filter(Boolean);
  const endpoint = segments[0];
  const id = segments[1];
  const resource = RESOURCES[endpoint];
  if (!resource) {
    return jsonResponse(res, 404, { error: 'Not found.' });
  }

  const controller = controllers[resource.container];
  const has = (op: string) => resource.operations.includes(op);

  try {
    switch (req.method) {
      case 'GET': {
        if (id) {
          if (!has('get_by_id')) return notAllowed(res);
          return jsonResponse(res, 200, await controller.get(id));
        }
        if (!has('list')) return notAllowed(res);
        return jsonResponse(res, 200, await controller.list(req.query.limit as string | undefined));
      }

      case 'POST': {
        if (!has('create')) return notAllowed(res);
        const created = await controller.post(req.body as Item);
        return jsonResponse(res, 201, created);
      }

      case 'PATCH': {
        if (!has('update')) return notAllowed(res);
        const updated = await controller.update({ id, ...(req.body as Item) });
        return jsonResponse(res, 200, updated);
      }

      case 'PUT': {
        if (!has('replace')) return notAllowed(res);
        const replaced = await controller.replace({ id, ...(req.body as Item) });
        return jsonResponse(res, 200, replaced);
      }

      case 'DELETE': {
        if (!has('delete')) return notAllowed(res);
        if (!id) return jsonResponse(res, 400, { error: 'Missing item ID.' });
        await controller.delete(id);
        return jsonResponse(res, 200, { message: `${endpoint} with ID ${id} deleted.` });
      }

      default:
        return notAllowed(res);
    }
  } catch (error) {
    const errorResponse = detectError(error);
    return res.status(errorResponse.status).send(errorResponse.body);
  }
});
