import * as ff from '@google-cloud/functions-framework';
import {
  jsonResponse,
{%- for resource in resources %}
  {{ resource.name | to_lower_camel }}Routes,
{%- endfor %}
} from '@routes';
import { detectError } from '@utils';

ff.http('api', async (req: ff.Request, res: ff.Response) => {
  const cleanPath = req.path.replace(/\/+$/, '');
  const segments = cleanPath.split('/').filter(Boolean);
  const endpoint = segments[0];
  const id = segments[1];

  if (endpoint === 'health' && !id) {
    return jsonResponse(res, 200, { status: 'ok' });
  }

  try {
    switch (endpoint) {
{%- for resource in resources %}
      case '{{ resource.endpoint }}':
        return await {{ resource.name | to_lower_camel }}Routes(req, res, id);
{%- endfor %}
      default:
        return jsonResponse(res, 404, { error: 'Not found.' });
    }
  } catch (error) {
    const errorResponse = detectError(error);
    return res.status(errorResponse.status).send(errorResponse.body);
  }
});
