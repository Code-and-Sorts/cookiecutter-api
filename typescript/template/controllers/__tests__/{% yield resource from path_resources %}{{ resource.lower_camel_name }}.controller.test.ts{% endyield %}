{%- from 'typescript/_model.jinja' import literal -%}
{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set client = (base_fields | rejectattr("system") | list) + resource.fields -%}
{%- set system = base_fields | selectattr("system") | list -%}
{%- set body_ops = [("create", "post"), ("update", "update"), ("replace", "replace")] | selectattr(0, "in", ops) | list -%}
{%- macro sample(fields) -%}
{ {%- for f in fields %}{{ " " if loop.first }}{{ f.name }}: {{ literal(f.sample) }}{{ ", " if not loop.last else " " }}{% endfor -%} }
{%- endmacro -%}
{%- macro call(op, method, body, user="") -%}
mockController.{{ method }}({% if op != "create" %}mockValidGuid, {% endif %}{{ body }}{% if user %}, '{{ user }}'{% endif %})
{%- endmacro -%}
import { describe, it, expect, beforeEach, jest } from '@jest/globals';
import { {{ r }}Controller } from '@controllers';
import { {{ r }}Service, SchemaValidator } from '@services';
import { NotFoundError, ValidationError } from '@errors';
import { MockFn } from '../../test/mocks';

describe('{{ r }}Controller', () => {
    const mockGet = jest.fn<MockFn>();
    const mockList = jest.fn<MockFn>();
    const mockCreate = jest.fn<MockFn>();
    const mockUpdate = jest.fn<MockFn>();
    const mockReplace = jest.fn<MockFn>();
    const mockDelete = jest.fn<MockFn>();

    class Mock{{ r }}Service {
        get = mockGet;
        list = mockList;
        create = mockCreate;
        update = mockUpdate;
        replace = mockReplace;
        delete = mockDelete;
    }

    beforeEach(() => {
        jest.resetAllMocks();
    });

    const mockValidGuid = '91ed1c70-5412-449a-b949-80542a4eb3d5';
    const mockInvalidGuid = 'invalid-guid';
    const mockService = new Mock{{ r }}Service() as unknown as {{ r }}Service;
    const mockController = new {{ r }}Controller(mockService, new SchemaValidator());

    const expectNotFound = async (call: Promise<unknown>, id: string) => {
        await expect(call).rejects.toBeInstanceOf(NotFoundError);
        await expect(call).rejects.toMatchObject({ statusCode: 404, message: `{{ r }} with id ${id} was not found.` });
    };
{%- if body_ops %}

    const expectBadRequest = async (call: Promise<unknown>) => {
        await expect(call).rejects.toBeInstanceOf(ValidationError);
        await expect(call).rejects.toMatchObject({ statusCode: 400 });
    };

    // Server-managed fields a body may never set.
    const systemFields: Record<string, unknown> = {{ sample(system) }};
    // Per accepted field: a wrongly typed value, null unless nullable, and values just outside each rule.
    const invalidValues: Record<string, unknown[]> = {
{%- for f in client %}
        {{ f.name }}: [{{ literal(f.invalid) }}{% if not f.nullable %}, null{% endif %}{% for v in f.violations %}, {{ literal(v) }}{% endfor %}],
{%- endfor %}
    };
    // Values exactly on a rule's bound, which a body may hold.
    const boundaryValues: [string, unknown][] = [
{%- for f in client %}
{%- for v in f.boundaries %}
        ['{{ f.name }}', {{ literal(v) }}],
{%- endfor %}
{%- endfor %}
    ];

    // Bodies an operation must reject, each wrapped so it.each passes it as one argument.
    const invalidBodies = (valid: Record<string, unknown>, required: string[], refused: Record<string, unknown>): unknown[][] =>
        [
            [],
            'not an object',
            null,
            { ...valid, not_a_field: 1 },
            ...Object.entries({ ...systemFields, ...refused }).map(([name, value]) => ({ ...valid, [name]: value })),
            ...Object.keys(valid).flatMap((name) => invalidValues[name].map((value) => ({ ...valid, [name]: value }))),
            ...required.map((name) => Object.fromEntries(Object.entries(valid).filter(([field]) => field !== name))),
        ].map((body) => [body]);
{%- endif %}
{%- for op, method in body_ops %}
{%- set accepted = client | selectattr("in_" ~ op) | list %}
{%- set refused = client | rejectattr("in_" ~ op) | list %}
{%- set required = accepted | selectattr("required") | rejectattr("has_default") | list if op != "update" else [] %}
{%- set mock = {"create": "mockCreate", "update": "mockUpdate", "replace": "mockReplace"}[op] %}

    describe('{{ method }}', () => {
        const valid: Record<string, unknown> = {{ sample(accepted) }};

        it('should pass the validated body and user id to the service', async () => {
            await {{ call(op, method, "valid", "mockUser") }};
            expect({{ mock }}).toHaveBeenCalledWith({% if op != "create" %}mockValidGuid, {% endif %}valid, 'mockUser');
        });
{%- if op == "update" %}

        it('should accept an empty body and leave every field out', async () => {
            await mockController.update(mockValidGuid, {});
            expect(mockUpdate).toHaveBeenCalledWith(mockValidGuid, {}, undefined);
        });
{%- for f in accepted if f.nullable %}

        it('should pass null to clear {{ f.name }}', async () => {
            await mockController.update(mockValidGuid, { {{ f.name }}: null });
            expect(mockUpdate).toHaveBeenCalledWith(mockValidGuid, { {{ f.name }}: null }, undefined);
        });
{%- endfor %}
{%- else %}
{%- set left_out = accepted | rejectattr("required") | list + accepted | selectattr("required") | selectattr("has_default") | list %}
{%- if left_out %}

        it('should give fields left out their defaults', async () => {
            await {{ call(op, method, sample(required)) }};
            const sent = {{ mock }}.mock.calls[0][{{ 0 if op == "create" else 1 }}] as Record<string, unknown>;
{%- for f in left_out %}
{%- if f.dynamic %}
            expect(sent.{{ f.name }}).toEqual(expect.any(String));
{%- elif f.has_default %}
            expect(sent.{{ f.name }}).toEqual({{ literal(f.default) }});
{%- else %}
            expect(sent).not.toHaveProperty('{{ f.name }}');
{%- endif %}
{%- endfor %}
        });
{%- endif %}
{%- endif %}
{%- for f in accepted if f.type == "date-time" %}

        it('should hold {{ f.name }} in UTC with milliseconds', async () => {
            await {{ call(op, method, "{ ...valid, " ~ f.name ~ ": '2026-01-31T11:30:00+02:00' }") }};
            const sent = {{ mock }}.mock.calls[0][{{ 0 if op == "create" else 1 }}] as Record<string, unknown>;
            expect(sent.{{ f.name }}).toEqual('2026-01-31T09:30:00.000Z');
        });
{%- endfor %}

        it.each(invalidBodies(valid, {{ required | map(attribute="name") | list | tojson }}, {{ sample(refused) }}))('should return 400 for %j', async (body) => {
            await expectBadRequest({{ call(op, method, "body") }});
            expect({{ mock }}).not.toHaveBeenCalled();
        });
{%- if accepted | selectattr("boundaries") | list %}

        it.each(boundaryValues.filter(([name]) => name in valid))('should accept %s = %j on a rule bound', async (name, value) => {
            await {{ call(op, method, "{ ...valid, [name]: value }") }};
            const sent = {{ mock }}.mock.calls[0][{{ 0 if op == "create" else 1 }}] as Record<string, unknown>;
            expect(sent[name]).toEqual(value);
        });
{%- endif %}
{%- if op != "create" %}

        it('should return 404 for an id that is not a UUID', async () => {
            await expectNotFound(mockController.{{ method }}(mockInvalidGuid, valid), mockInvalidGuid);
            expect({{ mock }}).not.toHaveBeenCalled();
        });
{%- endif %}
    });
{%- endfor %}
{%- if "get_by_id" in ops %}

    describe('get', () => {
        it('should call the service with the id', async () => {
            await mockController.get(mockValidGuid);
            expect(mockGet).toHaveBeenCalledWith(mockValidGuid);
        });

        it('should return 404 for an id that is not a UUID', async () => {
            await expectNotFound(mockController.get(mockInvalidGuid), mockInvalidGuid);
            expect(mockGet).not.toHaveBeenCalled();
        });
    });
{%- endif %}
{%- if "list" in ops %}

    describe('list', () => {
        it('should default the limit when not provided', async () => {
            await mockController.list();
            expect(mockList).toHaveBeenCalledWith(100);
        });

        it('should coerce and clamp the limit query param', async () => {
            await mockController.list('5');
            expect(mockList).toHaveBeenCalledWith(5);

            await mockController.list('999999');
            expect(mockList).toHaveBeenCalledWith(1000);

            await mockController.list('abc');
            expect(mockList).toHaveBeenCalledWith(100);
        });
    });
{%- endif %}
{%- if "delete" in ops %}

    describe('delete', () => {
        it('should call the service and return the confirmation message', async () => {
            expect(await mockController.delete(mockValidGuid, 'mockUser')).toEqual({
                message: `{{ r }} with id ${mockValidGuid} was deleted successfully.`,
            });
            expect(mockDelete).toHaveBeenCalledWith(mockValidGuid, 'mockUser');
        });

        it('should return 404 for an id that is not a UUID', async () => {
            await expectNotFound(mockController.delete(mockInvalidGuid), mockInvalidGuid);
            expect(mockDelete).not.toHaveBeenCalled();
        });
    });
{%- endif %}
});
