{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set by_id = ops | select('in', ['get_by_id', 'update', 'replace', 'delete']) | list -%}
import 'reflect-metadata';
import { inject, injectable } from 'inversify';
import { {{ r }}Service, SchemaValidator } from '@services';
import {
{%- if ops | select('in', ['list', 'get_by_id', 'create', 'update', 'replace']) | list %}
    {{ r }}Response,
{%- endif %}
{%- if "create" in ops or "replace" in ops %}
    {{ r }}RequestSchema,
{%- endif %}
{%- if "update" in ops %}
    {{ r }}UpdateSchema,
{%- endif %}
{%- if by_id %}
    GuidSchema,
{%- endif %}
} from '@models';
{%- if by_id %}
import { NotFoundError } from '@errors';
{%- endif %}
{%- if "list" in ops %}
import { coerceLimit } from '@utils';
{%- endif %}

// Validates requests for /{{ resource.endpoint }}. Bodies are the parsed JSON exactly as the
// client sent it; ids come from the path only, so a body can never set one.
@injectable()
export class {{ r }}Controller {
  private _service: {{ r }}Service;
  private _validator: SchemaValidator;

  constructor(
    @inject({{ r }}Service) service: {{ r }}Service,
    @inject(SchemaValidator) validator: SchemaValidator,
  ) {
    this._service = service;
    this._validator = validator;
  }
{%- if by_id %}

  // An id that is not a UUID can never exist, so it is reported as not found.
  private assertId = (id: string): void => {
    if (!GuidSchema.safeParse(id).success) {
      throw new NotFoundError(`{{ r }} with id ${id} was not found.`);
    }
  };
{%- endif %}
{%- if "create" in ops %}

  post = async (body: unknown): Promise<{{ r }}Response> => {
    const item = this._validator.validate(body, {{ r }}RequestSchema);
    return this._service.create(item);
  };
{%- endif %}
{%- if "get_by_id" in ops %}

  get = async (id: string): Promise<{{ r }}Response> => {
    this.assertId(id);
    return this._service.get(id);
  };
{%- endif %}
{%- if "list" in ops %}

  list = async (limit?: string | number | null): Promise<{{ r }}Response[]> =>
    this._service.list(coerceLimit(limit));
{%- endif %}
{%- if "update" in ops %}

  update = async (id: string, body: unknown): Promise<{{ r }}Response> => {
    this.assertId(id);
    const item = this._validator.validate(body, {{ r }}UpdateSchema);
    return this._service.update(id, item);
  };
{%- endif %}
{%- if "replace" in ops %}

  replace = async (id: string, body: unknown): Promise<{{ r }}Response> => {
    this.assertId(id);
    const item = this._validator.validate(body, {{ r }}RequestSchema);
    return this._service.replace(id, item);
  };
{%- endif %}
{%- if "delete" in ops %}

  delete = async (id: string): Promise<{ message: string }> => {
    this.assertId(id);
    await this._service.delete(id);
    return { message: `{{ r }} with id ${id} was deleted successfully.` };
  };
{%- endif %}
}
