{%- set all_ops = ["list", "get_by_id", "create", "update", "replace", "delete"] -%}
{%- set r = resource.name -%}
{%- set c = resource.name | to_lower_camel -%}
{%- set ops = resource.operations -%}
{#- [function name, has id, controller method] -#}
{%- set probes = {
    'list': ['list' ~ r, false, 'list'],
    'get_by_id': ['getById' ~ r, true, 'get'],
    'create': ['create' ~ r, false, 'post'],
    'update': ['update' ~ r, true, 'update'],
    'replace': ['replace' ~ r, true, 'replace'],
    'delete': ['delete' ~ r, true, 'delete'],
} -%}
{%- set first = probes[ops[0]] -%}
{%- set first_call = "call('" ~ first[0] ~ "'" ~ (", mockId, mockBody" if first[1] else ", undefined, mockBody") ~ ")" -%}
import { describe, it, expect, beforeEach, beforeAll, jest } from '@jest/globals';
import { HttpRequest, HttpResponseInit, InvocationContext } from '@azure/functions';
import { NotFoundError, ValidationError } from '@errors';
import { MockFn, mockController } from '../../test/mocks';

jest.unstable_mockModule('@azure/functions', () => ({ app: { http: jest.fn<MockFn>() } }));
jest.unstable_mockModule('@config/container', () => ({ {{ c }}Controller: mockController() }));

const mockId = '91ed1c70-5412-449a-b949-80542a4eb3d5';
// Passed through a mocked controller, so its content does not matter.
const mockBody = { any: 'body' };
const mockUser = 'mockUser';

type Registration = { methods: string[]; route: string; authLevel: string; handler: (request: HttpRequest, context: InvocationContext) => Promise<HttpResponseInit> };
let registrations: Record<string, Registration>;
let controller: Record<string, jest.Mock<MockFn>>;
let context: { log: jest.Mock<MockFn>; error: jest.Mock<MockFn> };

beforeAll(async () => {
    const { app } = await import('@azure/functions');
    ({ {{ c }}Controller: controller } = (await import('@config/container')) as unknown as Record<string, Record<string, jest.Mock<MockFn>>>);
    await import('../{{ c }}');
    registrations = Object.fromEntries((app.http as jest.Mock<MockFn>).mock.calls.map(([name, options]) => [name, options]));
});

const call = async (name: string, id?: string, body?: unknown) => {
    const request = {
        url: `http://localhost/api/${name}`,
        params: id ? { id } : {},
        headers: new Headers({ 'X-User-Id': ` ${mockUser} ` }),
        query: new URLSearchParams('limit=5'),
        text: async () => (body === undefined ? '' : typeof body === 'string' ? body : JSON.stringify(body)),
    } as unknown as HttpRequest;
    const response = await registrations[name].handler(request, context as unknown as InvocationContext);
    expect(response.headers).toEqual({ 'Content-Type': 'application/json' });
    return { status: response.status, body: JSON.parse(response.body as string) as unknown };
};

describe('{{ resource.endpoint }} functions', () => {
    beforeEach(() => {
        jest.clearAllMocks();
        context = { log: jest.fn<MockFn>(), error: jest.fn<MockFn>() };
    });
{%- if "list" in ops %}

    it('should register list', async () => {
        expect(registrations['list{{ r }}']).toMatchObject({ methods: ['GET'], route: '{{ resource.endpoint }}', authLevel: 'function' });
        expect(await call('list{{ r }}')).toEqual({ status: 200, body: [] });
        expect(controller.list).toHaveBeenCalledWith('5');
    });
{%- endif %}
{%- if "get_by_id" in ops %}

    it('should register get by id', async () => {
        expect(registrations['getById{{ r }}']).toMatchObject({ methods: ['GET'], route: '{{ resource.endpoint }}/{id}', authLevel: 'function' });
        expect((await call('getById{{ r }}', mockId)).status).toEqual(200);
        expect(controller.get).toHaveBeenCalledWith(mockId);
    });
{%- endif %}
{%- if "create" in ops %}

    it('should register create with the body and user id', async () => {
        expect(registrations['create{{ r }}']).toMatchObject({ methods: ['POST'], route: '{{ resource.endpoint }}', authLevel: 'function' });
        expect((await call('create{{ r }}', undefined, mockBody)).status).toEqual(201);
        expect(controller.post).toHaveBeenCalledWith(mockBody, mockUser);
    });

    it('should answer a malformed or missing create body with a JSON 400', async () => {
        const invalid = { status: 400, body: { errorMessage: 'Request body must be valid JSON.' } };
        expect(await call('create{{ r }}', undefined, '{bad')).toEqual(invalid);
        expect(await call('create{{ r }}')).toEqual(invalid);
        expect(controller.post).not.toHaveBeenCalled();
    });
{%- endif %}
{%- if "update" in ops %}

    it('should register update with the path id, body and user id', async () => {
        expect(registrations['update{{ r }}']).toMatchObject({ methods: ['PATCH'], route: '{{ resource.endpoint }}/{id}', authLevel: 'function' });
        expect((await call('update{{ r }}', mockId, mockBody)).status).toEqual(200);
        expect(controller.update).toHaveBeenCalledWith(mockId, mockBody, mockUser);
    });

    it('should answer a malformed update body with a JSON 400', async () => {
        expect((await call('update{{ r }}', mockId, '{bad')).status).toEqual(400);
        expect(controller.update).not.toHaveBeenCalled();
    });
{%- endif %}
{%- if "replace" in ops %}

    it('should register replace with the path id, body and user id', async () => {
        expect(registrations['replace{{ r }}']).toMatchObject({ methods: ['PUT'], route: '{{ resource.endpoint }}/{id}', authLevel: 'function' });
        expect((await call('replace{{ r }}', mockId, mockBody)).status).toEqual(200);
        expect(controller.replace).toHaveBeenCalledWith(mockId, mockBody, mockUser);
    });

    it('should answer a malformed replace body with a JSON 400', async () => {
        expect((await call('replace{{ r }}', mockId, 'not json')).status).toEqual(400);
        expect(controller.replace).not.toHaveBeenCalled();
    });
{%- endif %}
{%- if "delete" in ops %}

    it('should register delete with the user id and return its message', async () => {
        expect(registrations['delete{{ r }}']).toMatchObject({ methods: ['DELETE'], route: '{{ resource.endpoint }}/{id}', authLevel: 'function' });
        expect(await call('delete{{ r }}', mockId)).toEqual({ status: 200, body: { message: 'deleted' } });
        expect(controller.delete).toHaveBeenCalledWith(mockId, mockUser);
    });
{%- endif %}

    it('should map expected errors to JSON error responses without logging them', async () => {
        controller.{{ first[2] }}.mockRejectedValueOnce(new NotFoundError('{{ r }} with id x was not found.'));
        expect(await {{ first_call }}).toEqual({ status: 404, body: { errorMessage: '{{ r }} with id x was not found.' } });
        controller.{{ first[2] }}.mockRejectedValueOnce(new ValidationError('label is required.'));
        expect(await {{ first_call }}).toEqual({ status: 400, body: { errorMessage: 'label is required.' } });
        expect(context.error).not.toHaveBeenCalled();
    });

    it('should log unexpected errors and answer with a generic 500', async () => {
        const error = new Error('secret details');
        controller.{{ first[2] }}.mockRejectedValueOnce(error);
        expect(await {{ first_call }}).toEqual({ status: 500, body: { errorMessage: 'An unexpected error occurred.' } });
        expect(context.error).toHaveBeenCalledWith(expect.any(String), error);
    });
{%- set disabled = all_ops | reject('in', ops) | list %}
{%- if disabled %}

    it('should not register disabled operations', () => {
{%- for op in disabled %}
        expect(registrations['{{ probes[op][0] }}']).toBeUndefined();
{%- endfor %}
    });
{%- endif %}
});
