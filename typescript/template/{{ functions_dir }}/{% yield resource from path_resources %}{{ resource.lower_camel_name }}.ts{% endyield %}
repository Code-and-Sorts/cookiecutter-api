{%- set r = resource.name -%}
{%- set c = resource.name | to_lower_camel -%}
{%- set ops = resource.operations -%}
{%- set has_body = ops | select('in', ['create', 'update', 'replace']) | list -%}
{%- set specs = [
    ('get_by_id', 'getById', 'GET', '/{id}', 200, 'get(request.params.id)'),
    ('list', 'list', 'GET', '', 200, "list(request.query.get('limit'))"),
    ('create', 'create', 'POST', '', 201, 'post(parseJsonBody(await request.text()))'),
    ('update', 'update', 'PATCH', '/{id}', 200, 'update(request.params.id, parseJsonBody(await request.text()))'),
    ('replace', 'replace', 'PUT', '/{id}', 200, 'replace(request.params.id, parseJsonBody(await request.text()))'),
    ('delete', 'delete', 'DELETE', '/{id}', 200, 'delete(request.params.id)'),
] -%}
import { app } from '@azure/functions';
import { {{ c }}Controller } from '@config/container';
{%- if has_body %}
import { parseJsonBody } from '@utils';
{%- endif %}
import { handle } from './response';

// Methods and paths with no registered function get the Functions host's own 404.
{%- for op, prefix, verb, suffix, status, call in specs %}
{%- if op in ops %}

app.http('{{ prefix }}{{ r }}', {
    methods: ['{{ verb }}'],
    authLevel: 'function',
    route: '{{ resource.endpoint }}{{ suffix }}',
    handler: handle({{ status }}, async (request) => {{ c }}Controller.{{ call }}),
});
{%- endif %}
{%- endfor %}
