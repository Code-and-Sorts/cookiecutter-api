{
  "compilerOptions": {
    "baseUrl": "./",
    "module": "commonjs",
    "target": "es6",
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "strict": false,
    "experimentalDecorators": true,
    "paths": {
      "@config/*": [
        "config/*"
      ],
      "@controller": [
        "controller/index"
      ],
      "@service": [
        "service/index"
      ],
      "@repository": [
        "repository/index"
      ],
      "@models": [
        "types/models/index"
      ],
      "@errors": [
        "types/errors/index"
      ],
      "@utils": [
        "utils/index"
      ]
    }
  }
}