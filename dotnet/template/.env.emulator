# Settings for the emulator in docker-compose.yml. This file is committed, so it holds only
# public emulator values; keep real credentials in untracked files such as {% if cloud_service == 'Azure Function App' %}local.settings.json or {% endif %}.env.local.
{%- if cloud_service == 'Azure Function App' %}
ConnectionStrings__CosmosDb="AccountEndpoint=http://localhost:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==;"
CosmosDbDatabaseName={{ project_endpoint }}
CosmosDbEmulator=true
{%- elif cloud_service == 'GCP Cloud Function' %}
FIRESTORE_EMULATOR_HOST=localhost:8085
GCP_PROJECT_ID=demo-{{ project_endpoint }}
{%- else %}
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=emulator
AWS_SECRET_ACCESS_KEY=emulator
{%- endif %}
