    [Fact]
    public async Task Get{{ r }}_ReturnsNotFound_WithoutLoggingAnError()
    {
        _mock{{ r }}Controller.GetAsync("not-a-uuid", Arg.Any<CancellationToken>()).Throws(new NotFoundException("{{ r }}", "not-a-uuid"));

        var result = await _functions.Get{{ r }}(Mocks.CreateHttpRequestData("GET"), "not-a-uuid", TestContext.Current.CancellationToken);

        var errorResult = Assert.IsType<HttpResponseInit>(result);
        Assert.Equal(404, errorResult.StatusCode);
        Assert.Equal("{\"errorMessage\":\"{{ r }} with id not-a-uuid was not found.\"}", JsonSerializer.Serialize(errorResult.Value));
        Assert.Empty(_logger.Entries);
    }

