    private void AssertUnexpectedError(IActionResult result)
    {
        var errorResult = Assert.IsType<HttpResponseInit>(result);
        var error = Assert.IsType<BaseError>(errorResult.Value);
        Assert.Equal(500, errorResult.StatusCode);
        Assert.Equal("An unexpected error occurred.", error.ErrorMessage);
        Assert.Contains(_logger.Entries, entry => entry.Level == LogLevel.Error && entry.Exception?.Message == "Mock exception");
    }
