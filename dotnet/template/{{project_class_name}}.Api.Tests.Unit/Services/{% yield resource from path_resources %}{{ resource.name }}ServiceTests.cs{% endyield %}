{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set lc = resource.lower_camel_name -%}
{%- set ct = "TestContext.Current.CancellationToken" -%}
namespace {{project_class_name}}.Api.Tests.Unit;
{% if "update" in ops or "replace" in ops %}
using System;
{%- endif %}
{%- if "list" in ops %}
using System.Collections.Generic;
{%- endif %}
using System.Threading;
using System.Threading.Tasks;
{%- if resource.has_dto %}
using {{project_class_name}}.Api.Dtos;
{%- endif %}
{%- if resource.has_body %}
using {{project_class_name}}.Api.Entities;
{%- endif %}
using {{project_class_name}}.Api.Interfaces;
{%- if resource.has_body %}
using {{project_class_name}}.Api.Requests;
{%- endif %}
using {{project_class_name}}.Api.Services;
{%- if resource.has_body %}
using {{project_class_name}}.Api.Utils;
{%- endif %}
using NSubstitute;
using Xunit;

public class {{ r }}ServiceTests
{
    private const string ItemId = {{ r }}Samples.ItemId;
    private readonly I{{ r }}Repository _{{ lc }}RepositoryMock;
    private readonly {{ r }}Service _{{ lc }}Service;

    public {{ r }}ServiceTests()
    {
        _{{ lc }}RepositoryMock = Substitute.For<I{{ r }}Repository>();
        _{{ lc }}Service = new {{ r }}Service(_{{ lc }}RepositoryMock);
    }
{%- if "get_by_id" in ops %}

    [Fact]
    public async Task GetAsync_ShouldReturn{{ r }}Dto()
    {
        var expectedItem = {{ r }}Samples.Dto();
        _{{ lc }}RepositoryMock.GetAsync(ItemId, Arg.Any<CancellationToken>()).Returns(expectedItem);

        var result = await _{{ lc }}Service.GetAsync(ItemId, {{ ct }});

        Assert.Equal(expectedItem, result);
    }
{%- endif %}
{%- if "list" in ops %}

    [Fact]
    public async Task GetListAsync_ShouldReturnListOf{{ r }}Dto()
    {
        var expectedItemList = new List<{{ r }}Dto> { {{ r }}Samples.Dto(), {{ r }}Samples.Dto() };
        _{{ lc }}RepositoryMock.GetListAsync(25, Arg.Any<CancellationToken>()).Returns(expectedItemList);

        var result = await _{{ lc }}Service.GetListAsync(25, {{ ct }});

        Assert.Equal(expectedItemList, result);
    }
{%- endif %}
{%- if "create" in ops %}

    [Fact]
    public async Task CreateAsync_StoresTheRequestAsAnEntity()
    {
        var request = await RequestBody.DeserializeAsync<Create{{ r }}Request>(Mocks.CreateStream({{ r }}Samples.CreateBody), {{ ct }});
        var expectedItem = {{ r }}Samples.Dto();
        {{ r }}Entity? stored = null;
        _{{ lc }}RepositoryMock.CreateAsync(Arg.Do<{{ r }}Entity>(item => stored = item), "User1", Arg.Any<CancellationToken>()).Returns(expectedItem);

        var result = await _{{ lc }}Service.CreateAsync(request, "User1", {{ ct }});

        Assert.Equal(expectedItem, result);
        Assert.NotNull(stored);
        JsonAssert.Contains(request, stored);
    }
{%- endif %}
{%- for op, Op in [("update", "Update"), ("replace", "Replace")] if op in ops %}

    [Fact]
    public async Task {{ Op }}Async_AppliesTheRequestToTheStoredEntity()
    {
        var request = await RequestBody.DeserializeAsync<{{ Op }}{{ r }}Request>(Mocks.CreateStream({{ r }}Samples.{{ Op }}Body), {{ ct }});
        request.Id = ItemId;
        var expectedItem = {{ r }}Samples.Dto();
        Action<{{ r }}Entity>? apply = null;
        _{{ lc }}RepositoryMock.{{ Op }}Async(ItemId, Arg.Do<Action<{{ r }}Entity>>(action => apply = action), "User1", Arg.Any<CancellationToken>()).Returns(expectedItem);

        var result = await _{{ lc }}Service.{{ Op }}Async(request, "User1", {{ ct }});

        Assert.Equal(expectedItem, result);
        Assert.NotNull(apply);
        var item = new {{ r }}Entity();
        apply(item);
        JsonAssert.Contains(request, item);
    }
{%- endfor %}
{%- if "delete" in ops %}

    [Fact]
    public async Task DeleteAsync_ShouldCallRepositoryDelete()
    {
        _{{ lc }}RepositoryMock.DeleteAsync(ItemId, "User1", Arg.Any<CancellationToken>()).Returns(Task.CompletedTask);

        await _{{ lc }}Service.DeleteAsync(ItemId, "User1", {{ ct }});

        await _{{ lc }}RepositoryMock.Received(1).DeleteAsync(ItemId, "User1", Arg.Any<CancellationToken>());
    }
{%- endif %}
}
