{%- from 'shared/_fields.jinja' import REQUEST_KINDS -%}
{%- from 'dotnet/_model.jinja' import json_string -%}
{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set client = resource.client_fields -%}
{%- set shown = client | rejectattr("hidden") | list -%}
{%- set bodies = REQUEST_KINDS | selectattr(0, "in", ops) | list -%}
{%- macro expect_default(f, expr) %}
{%- if f.dynamic %}
        Assert.NotNull({{ expr }});
{%- elif f.defaulted %}
        JsonAssert.Equal({{ json_string(f.default) }}, {{ expr }});
{%- else %}
        Assert.Null({{ expr }});
{%- endif %}
{%- endmacro -%}
namespace {{project_class_name}}.Api.Tests.Unit;

using {{project_class_name}}.Api.Dtos;
using {{project_class_name}}.Api.Entities;
{%- if bodies %}
using {{project_class_name}}.Api.Requests;
{%- endif %}
{%- if "update" in ops %}
using {{project_class_name}}.Api.Utils;
{%- endif %}
using Xunit;

public class {{ r }}ModelTests
{
    [Fact]
    public void Dto_HoldsTheIdFirstAndEveryShownField()
    {
        var properties = JsonAssert.Properties({{ r }}Samples.Dto());

        Assert.Equal(new[] { "id"{% for f in shown %}, "{{ f.name }}"{% endfor %} }, properties.Keys);
        Assert.Equal({{ r }}Samples.ItemId, properties["id"].GetString());
{%- for f in shown %}
        JsonAssert.Equal({{ json_string(f.sample) }}, properties["{{ f.name }}"]);
{%- endfor %}
    }

    [Fact]
    public void Dto_ReadsAMissingFieldAsItsStaticDefault()
    {
        var properties = JsonAssert.Properties(new {{ r }}Dto(new {{ r }}Entity { Id = {{ r }}Samples.ItemId }));

        Assert.Equal(new[] { "id"{% for f in shown %}, "{{ f.name }}"{% endfor %} }, properties.Keys);
{%- for f in shown %}
        JsonAssert.Equal({{ json_string(f.read_default) }}, properties["{{ f.name }}"]);
{%- endfor %}
    }
{%- if "create" in ops %}

    [Fact]
    public void CreateRequest_DefaultsFieldsTheBodyLeavesOut()
    {
        var item = new Create{{ r }}Request().ToEntity();
{%- for f in client %}
{{- expect_default(f, "item." ~ f.pascal) }}
{%- endfor %}
    }
{%- endif %}
{%- if "replace" in ops %}

    [Fact]
    public void ReplaceRequest_ResetsAcceptedFieldsAndKeepsTheRest()
    {
        var item = {{ r }}Samples.Entity();

        new Replace{{ r }}Request().ApplyTo(item);

        Assert.Equal({{ r }}Samples.StoredTimestamp, item.CreatedTimestamp);
        Assert.Equal("User2", item.CreatedBy);
{%- for f in client %}
{%- if f.in_replace %}
{{- expect_default(f, "item." ~ f.pascal) }}
{%- else %}
        JsonAssert.Equal({{ json_string(f.sample) }}, item.{{ f.pascal }});
{%- endif %}
{%- endfor %}
    }
{%- endif %}
{%- if "update" in ops %}
{%- set updated = client | selectattr("in_update") | list %}

    [Fact]
    public void UpdateRequest_ChangesOnlyTheFieldsSent()
    {
        var item = {{ r }}Samples.Entity();

        new Update{{ r }}Request().ApplyTo(item);

        Assert.Equal(Json.Serialize({{ r }}Samples.Entity()), Json.Serialize(item));
    }
{%- if updated %}

    [Theory]
{%- for f in updated %}
    [InlineData("{{ f.name }}")]
{%- endfor %}
    public void UpdateRequest_SetsASentFieldEvenToNull(string name)
    {
        var request = new Update{{ r }}Request();
        request.Sent.Add(name);
        var item = {{ r }}Samples.Entity();

        request.ApplyTo(item);

        Assert.False(JsonAssert.Properties(item).ContainsKey(name));
    }
{%- endif %}
{%- endif %}
{%- for op, Op in bodies %}
{%- set dates = client | selectattr("in_" ~ op) | selectattr("type", "equalto", "date-time") | list %}
{%- set date_lists = client | selectattr("in_" ~ op) | selectattr("item_type", "equalto", "date-time") | list %}
{%- if dates or date_lists %}

    [Fact]
    public void {{ Op }}Request_StoresDateTimesInUtc()
    {
        var request = new {{ Op }}{{ r }}Request
        {
{%- for f in dates %}
            {{ f.pascal }} = "2026-01-31T11:30:00+02:00",
{%- endfor %}
{%- for f in date_lists %}
            {{ f.pascal }} = ["2026-01-31T11:30:00+02:00"],
{%- endfor %}
        };
{%- if op == "update" %}
        request.Sent.UnionWith([{% for f in dates + date_lists %}"{{ f.name }}"{{ ", " if not loop.last }}{% endfor %}]);
{%- endif %}
{%- if op != "create" %}
        var item = new {{ r }}Entity();
{%- endif %}

{% if op == "create" %}        var item = request.ToEntity();{% else %}        request.ApplyTo(item);{% endif %}
{% for f in dates %}
        Assert.Equal("2026-01-31T09:30:00.000Z", item.{{ f.pascal }});
{%- endfor %}
{%- for f in date_lists %}
        Assert.Equal(new[] { "2026-01-31T09:30:00.000Z" }, item.{{ f.pascal }});
{%- endfor %}
    }
{%- endif %}
{%- endfor %}
}
