{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set writes_back = ops | select('in', ['update', 'replace', 'delete']) | list -%}
namespace {{project_class_name}}.Api.Tests.Unit;
{% if writes_back %}
using System;
{%- endif %}
{%- if "list" in ops %}
using System.Collections.Generic;
using System.Linq;
{%- endif %}
using System.Threading;
using System.Threading.Tasks;
using {{project_class_name}}.Api.Entities;
using {{project_class_name}}.Api.Interfaces;
using {{project_class_name}}.Api.Repositories;
using NSubstitute;
using Xunit;

public class {{ r }}RepositoryTests
{
    private const string ItemId = "0f3a7ff7-a601-4d23-b33c-7f8f18b57a4c";
    private const string StoredTimestamp = "2026-01-01T00:00:00.000Z";
    private readonly IDocumentStore<{{ r }}Entity> _mockStore = Substitute.For<IDocumentStore<{{ r }}Entity>>();
    private readonly {{ r }}Repository _repository;

    public {{ r }}RepositoryTests()
    {
        _repository = new {{ r }}Repository(_mockStore);
    }

    private static {{ r }}Entity StoredItem(string name = "mock{{ r }}") => new()
    {
        Id = ItemId,
        Name = name,
        CreatedTimestamp = StoredTimestamp,
        UpdatedTimestamp = StoredTimestamp,
        CreatedBy = "User2",
    };
{%- if writes_back %}

    private {{ r }}Entity StoreHolds({{ r }}Entity stored)
    {
        _mockStore.UpdateAsync(ItemId, Arg.Any<Action<{{ r }}Entity>>(), Arg.Any<CancellationToken>()).Returns(call =>
        {
            call.Arg<Action<{{ r }}Entity>>()(stored);
            return stored;
        });
        return stored;
    }
{%- endif %}
{%- if "get_by_id" in ops %}

    [Fact]
    public async Task GetAsync_ShouldReturn{{ r }}Dto()
    {
        _mockStore.GetAsync(ItemId, Arg.Any<CancellationToken>()).Returns(StoredItem());

        var result = await _repository.GetAsync(ItemId, TestContext.Current.CancellationToken);

        Assert.Equal((ItemId, "mock{{ r }}", StoredTimestamp, "User2", StoredTimestamp, null),
            (result.Id, result.Name, result.CreatedTimestamp, result.CreatedBy, result.UpdatedTimestamp, result.UpdatedBy));
    }
{%- endif %}
{%- if "list" in ops %}

    [Fact]
    public async Task GetListAsync_ShouldReturn{{ r }}Dtos()
    {
        _mockStore.GetLiveListAsync(2, Arg.Any<CancellationToken>()).Returns(new List<{{ r }}Entity> { StoredItem("mock{{ r }}1"), StoredItem("mock{{ r }}2") });

        var result = await _repository.GetListAsync(2, TestContext.Current.CancellationToken);

        Assert.Equal(new[] { "mock{{ r }}1", "mock{{ r }}2" }, result.Select(dto => dto.Name).ToArray());
    }
{%- endif %}
{%- if "create" in ops %}

    [Fact]
    public async Task CreateAsync_ShouldStoreItemAndReturn{{ r }}Dto()
    {
        var result = await _repository.CreateAsync(new {{ r }}Entity { Name = "mock{{ r }}" }, "User1", TestContext.Current.CancellationToken);

        Assert.True(result.Name == "mock{{ r }}" && result.CreatedBy == "User1" && result.UpdatedBy == "User1");
        Assert.Equal(result.CreatedTimestamp, result.UpdatedTimestamp);
        await _mockStore.Received(1).CreateAsync(Arg.Is<{{ r }}Entity>(k => k.Id == result.Id && k.Name == "mock{{ r }}"), Arg.Any<CancellationToken>());
    }
{%- endif %}
{%- if "update" in ops %}

    [Fact]
    public async Task UpdateAsync_ShouldChangeNameAndKeepCreatedFields()
    {
        var stored = StoreHolds(StoredItem("mock{{ r }}Old"));

        var result = await _repository.UpdateAsync(new {{ r }}Entity { Id = ItemId, Name = "mock{{ r }}New" }, "User1", TestContext.Current.CancellationToken);

        Assert.Equal((ItemId, "mock{{ r }}New", StoredTimestamp, "User2", stored.UpdatedTimestamp, "User1"),
            (result.Id, result.Name, result.CreatedTimestamp, result.CreatedBy, result.UpdatedTimestamp, result.UpdatedBy));
        Assert.NotEqual(StoredTimestamp, result.UpdatedTimestamp);
        Assert.True(stored.Name == "mock{{ r }}New" && stored.CreatedBy == "User2" && stored.CreatedTimestamp == StoredTimestamp);
    }

    [Fact]
    public async Task UpdateAsync_ShouldKeepStoredName_WhenNameIsNotGiven()
    {
        StoreHolds(StoredItem("mock{{ r }}Old"));

        var result = await _repository.UpdateAsync(new {{ r }}Entity { Id = ItemId, Name = null! }, null, TestContext.Current.CancellationToken);

        Assert.Equal("mock{{ r }}Old", result.Name);
    }
{%- endif %}
{%- if "replace" in ops %}

    [Fact]
    public async Task ReplaceAsync_ShouldChangeNameAndKeepCreatedFields()
    {
        var stored = StoreHolds(StoredItem("mock{{ r }}Old"));

        var result = await _repository.ReplaceAsync(new {{ r }}Entity { Id = ItemId, Name = "mock{{ r }}New" }, "User1", TestContext.Current.CancellationToken);

        Assert.Equal((ItemId, "mock{{ r }}New", StoredTimestamp, "User2", stored.UpdatedTimestamp, "User1"),
            (result.Id, result.Name, result.CreatedTimestamp, result.CreatedBy, result.UpdatedTimestamp, result.UpdatedBy));
        Assert.NotEqual(StoredTimestamp, result.UpdatedTimestamp);
        Assert.True(stored.Name == "mock{{ r }}New" && stored.CreatedBy == "User2" && stored.CreatedTimestamp == StoredTimestamp);
    }
{%- endif %}
{%- if "delete" in ops %}

    [Fact]
    public async Task DeleteAsync_ShouldSoftDelete{{ r }}()
    {
        var stored = StoreHolds(StoredItem());

        await _repository.DeleteAsync(ItemId, null, TestContext.Current.CancellationToken);

        Assert.True(stored.IsDeleted && stored.CreatedTimestamp == StoredTimestamp);
    }
{%- endif %}
}
