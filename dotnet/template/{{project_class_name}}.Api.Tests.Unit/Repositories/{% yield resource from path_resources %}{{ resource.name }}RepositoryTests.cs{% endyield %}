{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set ct = "TestContext.Current.CancellationToken" -%}
namespace {{project_class_name}}.Api.Tests.Unit;
{% if "list" in ops %}
using System.Collections.Generic;
using System.Linq;
{%- endif %}
using System.Threading;
using System.Threading.Tasks;
{%- if "create" in ops %}
using {{project_class_name}}.Api.Dtos;
{%- endif %}
using {{project_class_name}}.Api.Entities;
using {{project_class_name}}.Api.Interfaces;
using {{project_class_name}}.Api.Repositories;
{%- if ops | select("in", ["get_by_id", "list", "create"]) | list %}
using {{project_class_name}}.Api.Utils;
{%- endif %}
using NSubstitute;
using Xunit;

public class {{ r }}RepositoryTests
{
    private const string ItemId = {{ r }}Samples.ItemId;
    private readonly IDocumentStore<{{ r }}Entity> _mockStore = Substitute.For<IDocumentStore<{{ r }}Entity>>();
    private readonly {{ r }}Repository _repository;

    public {{ r }}RepositoryTests()
    {
        _repository = new {{ r }}Repository(_mockStore);
    }
{%- if "get_by_id" in ops %}

    [Fact]
    public async Task GetAsync_ReturnsTheStoredItemAsADto()
    {
        _mockStore.GetAsync(ItemId, Arg.Any<CancellationToken>()).Returns({{ r }}Samples.Entity());

        var result = await _repository.GetAsync(ItemId, {{ ct }});

        Assert.Equal(Json.Serialize({{ r }}Samples.Dto()), Json.Serialize(result));
    }
{%- endif %}
{%- if "list" in ops %}

    [Fact]
    public async Task GetListAsync_ReturnsTheStoredItemsAsDtos()
    {
        var second = {{ r }}Samples.Entity();
        second.Id = "5615ff05-3032-4459-88ad-b6a4c3e51ca0";
        _mockStore.GetLiveListAsync(2, Arg.Any<CancellationToken>()).Returns(new List<{{ r }}Entity> { {{ r }}Samples.Entity(), second });

        var result = await _repository.GetListAsync(2, {{ ct }});

        Assert.Equal(new[] { ItemId, second.Id }, result.Select(dto => dto.Id).ToArray());
        Assert.Equal(Json.Serialize({{ r }}Samples.Dto()), Json.Serialize(result.First()));
    }
{%- endif %}
{%- if "create" in ops %}

    [Fact]
    public async Task CreateAsync_StoresTheItemWithANewIdAndReturnsItsDto()
    {
        var item = {{ r }}Samples.Entity();

        var result = await _repository.CreateAsync(item, null, {{ ct }});

        Assert.NotEqual(ItemId, result.Id);
        await _mockStore.Received(1).CreateAsync(Arg.Is<{{ r }}Entity>(stored => stored.Id == result.Id && !stored.IsDeleted), Arg.Any<CancellationToken>());
        Assert.Equal(Json.Serialize(new {{ r }}Dto(item)), Json.Serialize(result));
    }
{%- endif %}
{%- for op, Op in [("update", "Update"), ("replace", "Replace")] if op in ops %}

    [Fact]
    public async Task {{ Op }}Async_AppliesTheChangesAndKeepsCreatedFields()
    {
        _mockStore.GetAsync(ItemId, Arg.Any<CancellationToken>()).Returns({{ r }}Samples.Entity());
        {{ r }}Entity? applied = null;

        var result = await _repository.{{ Op }}Async(ItemId, item => applied = item, "User1", {{ ct }});

        Assert.NotNull(applied);
        Assert.Equal(ItemId, result.Id);
        await _mockStore.Received(1).SaveAsync(
            Arg.Is<{{ r }}Entity>(stored => stored == applied && stored.CreatedBy == "User2" && stored.UpdatedBy == "User1"
                && stored.CreatedTimestamp == {{ r }}Samples.StoredTimestamp && stored.UpdatedTimestamp != {{ r }}Samples.StoredTimestamp),
            Arg.Any<CancellationToken>());
    }
{%- endfor %}
{%- if "delete" in ops %}

    [Fact]
    public async Task DeleteAsync_SoftDeletesTheItem()
    {
        _mockStore.GetAsync(ItemId, Arg.Any<CancellationToken>()).Returns({{ r }}Samples.Entity());

        await _repository.DeleteAsync(ItemId, null, {{ ct }});

        await _mockStore.Received(1).SaveAsync(
            Arg.Is<{{ r }}Entity>(stored => stored.IsDeleted && stored.CreatedTimestamp == {{ r }}Samples.StoredTimestamp), Arg.Any<CancellationToken>());
    }
{%- endif %}
}
