{%- from 'shared/_fields.jinja' import REQUEST_KINDS -%}
{%- from 'dotnet/_model.jinja' import json_string, sample_body -%}
{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set lc = resource.lower_camel_name -%}
{%- set client = resource.client_fields -%}
{%- set ct = "TestContext.Current.CancellationToken" -%}
{%- macro call(op, body, user="null") -%}
_{{ lc }}Controller.{{ op | capitalize }}Async({% if op != "create" %}ItemId, {% endif %}Mocks.CreateStream({{ body }}), {{ user }}, {{ ct }})
{%- endmacro -%}
{%- macro receive(Op, user="null") %}
        {{ Op }}{{ r }}Request? received = null;
        _mock{{ r }}Service.{{ Op }}Async(Arg.Do<{{ Op }}{{ r }}Request>(request => received = request), {{ user }}, Arg.Any<CancellationToken>()).Returns({{ r }}Samples.Dto());
{%- endmacro -%}
namespace {{project_class_name}}.Api.Tests.Unit;

{% if "update" in ops -%}
using System;
{% endif -%}
{% if "list" in ops -%}
using System.Collections.Generic;
{% endif -%}
{% if "update" in ops -%}
using System.Linq;
{% endif -%}
using System.Threading;
using System.Threading.Tasks;
using {{project_class_name}}.Api.Controllers;
{% if resource.has_dto -%}
using {{project_class_name}}.Api.Dtos;
{% endif -%}
using {{project_class_name}}.Api.Interfaces;
{% if resource.has_body -%}
using {{project_class_name}}.Api.Requests;
{% endif -%}
using {{project_class_name}}.Api.Utils;
using NSubstitute;
using Xunit;

public class {{ r }}ControllerTests
{
    private const string ItemId = {{ r }}Samples.ItemId;
{%- if resource.has_body %}
{%- set body_fields = [] %}
{%- for f in client %}{% for op, Op in REQUEST_KINDS if op in ops and f["in_" ~ op] and f not in body_fields %}{% set _ = body_fields.append(f) %}{% endfor %}{% endfor %}

    // Per field a body accepts: a wrongly typed value, null unless nullable, and values just outside each rule.
    private static readonly (string Name, string Value)[] Rejected =
    [
{%- for f in body_fields %}
{%- for value in f.rejected %}
        ("{{ f.name }}", {{ json_string(value) }}),
{%- endfor %}
{%- endfor %}
    ];
{%- if body_fields | selectattr("boundaries") | list %}

    private static readonly (string Name, string Value)[] Boundaries =
    [
{%- for f in body_fields %}
{%- for value in f.boundaries %}
        ("{{ f.name }}", {{ json_string(value) }}),
{%- endfor %}
{%- endfor %}
    ];
{%- endif %}
{%- endif %}

    private readonly I{{ r }}Service _mock{{ r }}Service;
    private readonly {{ r }}Controller _{{ lc }}Controller;

    public {{ r }}ControllerTests()
    {
        _mock{{ r }}Service = Substitute.For<I{{ r }}Service>();
        _{{ lc }}Controller = new {{ r }}Controller(_mock{{ r }}Service);
    }
{%- if "get_by_id" in ops %}

    [Fact]
    public async Task GetAsync_Returns{{ r }}Dto()
    {
        var expectedItem = {{ r }}Samples.Dto();
        _mock{{ r }}Service.GetAsync(ItemId, Arg.Any<CancellationToken>()).Returns(expectedItem);

        var result = await _{{ lc }}Controller.GetAsync(ItemId, {{ ct }});

        Assert.Equal(expectedItem, result);
    }

    [Fact]
    public async Task GetAsync_ThrowsNotFound_WhenIdIsNotAUuid()
    {
        var exception = await Assert.ThrowsAsync<NotFoundException>(() => _{{ lc }}Controller.GetAsync("not-a-uuid", {{ ct }}));

        Assert.Equal("{{ r }} with id not-a-uuid was not found.", exception.Message);
        await _mock{{ r }}Service.DidNotReceiveWithAnyArgs().GetAsync(default!, {{ ct }});
    }
{%- endif %}
{%- if "list" in ops %}

    [Theory]
    [InlineData(null, 100)]
    [InlineData("5", 5)]
    [InlineData("invalid", 100)]
    [InlineData("5000", 1000)]
    public async Task GetListAsync_PassesParsedLimitToService(string? limit, int expectedLimit)
    {
        var expectedItemList = new List<{{ r }}Dto> { {{ r }}Samples.Dto() };
        _mock{{ r }}Service.GetListAsync(expectedLimit, Arg.Any<CancellationToken>()).Returns(expectedItemList);

        var result = await _{{ lc }}Controller.GetListAsync(limit, {{ ct }});

        Assert.Equal(expectedItemList, result);
        await _mock{{ r }}Service.Received(1).GetListAsync(expectedLimit, Arg.Any<CancellationToken>());
    }
{%- endif %}
{%- for op, Op in REQUEST_KINDS if op in ops %}
{%- set accepted = client | selectattr("in_" ~ op) | list %}
{%- set refused = client | rejectattr("in_" ~ op) | list %}
{%- set required = (accepted | selectattr("needs_value") | list) if op != "update" else [] %}

    [Fact]
    public async Task {{ Op }}Async_PassesTheValidatedRequest()
    {
{{- receive(Op, '"User1"') }}

        var result = await {{ call(op, r ~ "Samples." ~ Op ~ "Body", '"User1"') }};

        Assert.Equal(ItemId, result.Id);
        Assert.NotNull(received);
{%- if op != "create" %}
        Assert.Equal(ItemId, received.Id);
{%- endif %}
{%- if op == "update" %}
        Assert.Equal(new string[] { {%- for name in accepted | map(attribute="name") | sort(case_sensitive=true) %} "{{ name }}"{{ "," if not loop.last }}{% endfor %} }, received.Sent.Order(StringComparer.Ordinal));
{%- endif %}
        JsonAssert.Equal({{ r }}Samples.{{ Op }}Body, received);
    }
{%- if op == "update" %}

    [Fact]
    public async Task UpdateAsync_LeavesFieldsTheBodyOmits()
    {
{{- receive(Op) }}

        await {{ call(op, '"{}"') }};

        Assert.NotNull(received);
        Assert.Empty(received.Sent);
    }
{%- set nullable = accepted | selectattr("nullable") | list %}
{%- if nullable %}

    [Theory]
{%- for f in nullable %}
    [InlineData("{{ f.name }}")]
{%- endfor %}
    public async Task UpdateAsync_AcceptsNullForANullableField(string name)
    {
{{- receive(Op) }}

        await {{ call(op, '"{\\"" + name + "\\":null}"') }};

        Assert.NotNull(received);
        Assert.Equal(new[] { name }, received.Sent);
    }
{%- endif %}
{%- else %}
{%- set left_out = accepted | rejectattr("name", "in", required | map(attribute="name") | list) | list %}
{%- if left_out %}

    [Fact]
    public async Task {{ Op }}Async_GivesFieldsLeftOutTheirDefaults()
    {
{{- receive(Op) }}

        await {{ call(op, sample_body(required)) }};

        Assert.NotNull(received);
{%- for f in left_out %}
{%- if f.dynamic %}
        Assert.NotNull(received.{{ f.pascal }});
{%- else %}
        JsonAssert.Equal({{ json_string(f.default) }}, received.{{ f.pascal }});
{%- endif %}
{%- endfor %}
    }
{%- endif %}
{%- if required %}

    [Fact]
    public async Task {{ Op }}Async_ThrowsBadRequest_WhenARequiredFieldIsMissing()
    {
        var exception = await Assert.ThrowsAsync<BadRequestException>(() => {{ call(op, '"{}"') }});

        Assert.Equal("{% for f in required %}{{ f.name }} is required.{{ " " if not loop.last }}{% endfor %}", exception.Message);
    }
{%- endif %}
{%- endif %}

    public static TheoryData<string> Invalid{{ Op }}Bodies =>
        RequestBodies.Invalid({{ r }}Samples.{{ Op }}Body, [{{ required | map(attribute="name") | map("tojson") | join(", ") }}], [{{ refused | map(attribute="name") | map("tojson") | join(", ") }}], Rejected);

    [Theory]
    [MemberData(nameof(Invalid{{ Op }}Bodies))]
    public async Task {{ Op }}Async_ThrowsBadRequest_WhenBodyIsInvalid(string body)
    {
        await Assert.ThrowsAsync<BadRequestException>(() => {{ call(op, "body") }});

        await _mock{{ r }}Service.DidNotReceiveWithAnyArgs().{{ Op }}Async(default!, default, {{ ct }});
    }
{%- if accepted | selectattr("boundaries") | list %}

    public static TheoryData<string> {{ Op }}BodiesOnBounds => RequestBodies.OnBounds({{ r }}Samples.{{ Op }}Body, Boundaries);

    [Theory]
    [MemberData(nameof({{ Op }}BodiesOnBounds))]
    public async Task {{ Op }}Async_AcceptsValuesOnARuleBound(string body)
    {
{{- receive(Op) }}

        await {{ call(op, "body") }};

        JsonAssert.Equal(body, received);
    }
{%- endif %}
{%- if op != "create" %}

    [Fact]
    public async Task {{ Op }}Async_ThrowsNotFound_WhenIdIsNotAUuid()
    {
        await Assert.ThrowsAsync<NotFoundException>(() => _{{ lc }}Controller.{{ Op }}Async("not-a-uuid", Mocks.CreateStream({{ r }}Samples.{{ Op }}Body), null, {{ ct }}));

        await _mock{{ r }}Service.DidNotReceiveWithAnyArgs().{{ Op }}Async(default!, default, {{ ct }});
    }
{%- endif %}
{%- endfor %}
{%- if "delete" in ops %}

    [Fact]
    public async Task DeleteAsync_CallsDeleteOnServiceAndReturnsMessage()
    {
        _mock{{ r }}Service.DeleteAsync(ItemId, "User1", Arg.Any<CancellationToken>()).Returns(Task.CompletedTask);

        var result = await _{{ lc }}Controller.DeleteAsync(ItemId, "User1", {{ ct }});

        Assert.Equal($"{{ r }} with id {ItemId} was deleted successfully.", result.Message);
        await _mock{{ r }}Service.Received(1).DeleteAsync(ItemId, "User1", Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task DeleteAsync_ThrowsNotFound_WhenIdIsNotAUuid()
    {
        await Assert.ThrowsAsync<NotFoundException>(() => _{{ lc }}Controller.DeleteAsync("not-a-uuid", null, {{ ct }}));

        await _mock{{ r }}Service.DidNotReceiveWithAnyArgs().DeleteAsync(default!, default, {{ ct }});
    }
{%- endif %}
}
