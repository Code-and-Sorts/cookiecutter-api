{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set has_collection = resource.has_collection -%}
{%- set has_item = resource.has_item -%}
{%- set op_requests = [
    ('list', 'GET', False),
    ('get_by_id', 'GET', True),
    ('create', 'POST', False),
    ('update', 'PATCH', True),
    ('replace', 'PUT', True),
    ('delete', 'DELETE', True),
] -%}
{%- set first_op = (op_requests | selectattr(0, 'in', ops) | first) -%}
namespace {{project_class_name}}.Api.Tests.Unit;

using System;
{% if "list" in ops -%}
using System.Collections.Generic;
{% endif -%}
{% if resource.has_body -%}
using System.IO;
{% endif -%}
using System.Threading;
using System.Threading.Tasks;
using NSubstitute;
using NSubstitute.ExceptionExtensions;
using Xunit;
{% if resource.has_dto -%}
using {{project_class_name}}.Api.Dtos;
{% endif -%}
using {{project_class_name}}.Api.Handlers;
using {{project_class_name}}.Api.Interfaces;
{% if resource.has_body -%}
using {{project_class_name}}.Api.Requests;
{% endif -%}
{% if "delete" in ops -%}
using {{project_class_name}}.Api.Utils;
{% endif %}
public class {{ r }}HandlerTests
{
    private const string ItemId = "0f3a7ff7-a601-4d23-b33c-7f8f18b57a4c";
    private readonly I{{ r }}Controller _mock{{ r }}Controller;
    private readonly {{ r }}Handler _handler;

    public {{ r }}HandlerTests()
    {
        _mock{{ r }}Controller = Substitute.For<I{{ r }}Controller>();
        _handler = new {{ r }}Handler(_mock{{ r }}Controller);
    }

    [Fact]
    public void Endpoint_Is{{ r }}Endpoint()
    {
        Assert.Equal("{{ resource.endpoint }}", _handler.Endpoint);
    }
{%- if "get_by_id" in ops %}

    [Fact]
    public async Task HandleAsync_Get{{ r }}_ReturnsCamelCaseItem()
    {
        var httpContext = Mocks.CreateHttpContext("GET", "/{{ resource.endpoint }}/" + ItemId);
        _mock{{ r }}Controller.GetAsync(ItemId, Arg.Any<CancellationToken>())
            .Returns(Mocks.WithAuditFields(new {{ r }}Dto { Id = ItemId, Name = "mock{{ r }}" }));

        await _handler.HandleAsync(httpContext, ItemId);

        Assert.Equal(200, httpContext.Response.StatusCode);
        Assert.Equal("application/json", httpContext.Response.ContentType);
        Assert.Equal($"{{ '{{' }}\"id\":\"{ItemId}\",\"name\":\"mock{{ r }}\",{Mocks.AuditJson()}{{ '}}' }}", Mocks.ReadResponseBody(httpContext));
    }
{%- endif %}
{%- if "list" in ops %}

    [Fact]
    public async Task HandleAsync_Get{{ r }}List_ReturnsItemsAndPassesLimit()
    {
        var httpContext = Mocks.CreateHttpContext("GET", "/{{ resource.endpoint }}", query: "?limit=2");
        _mock{{ r }}Controller.GetListAsync("2", Arg.Any<CancellationToken>())
            .Returns(new List<{{ r }}Dto>
            {
                Mocks.WithAuditFields(new {{ r }}Dto { Id = ItemId, Name = "mock{{ r }}1" }),
                Mocks.WithAuditFields(new {{ r }}Dto { Id = "5615ff05-3032-4459-88ad-b6a4c3e51ca0", Name = "mock{{ r }}2" }, userId: null),
            });

        await _handler.HandleAsync(httpContext, null);

        Assert.Equal(200, httpContext.Response.StatusCode);
        Assert.Equal($"[{{ '{{' }}\"id\":\"{ItemId}\",\"name\":\"mock{{ r }}1\",{Mocks.AuditJson()}{{ '}}' }},"
            + $"{{ '{{' }}\"id\":\"5615ff05-3032-4459-88ad-b6a4c3e51ca0\",\"name\":\"mock{{ r }}2\",{Mocks.AuditJson(userId: null)}{{ '}}' }}]", Mocks.ReadResponseBody(httpContext));
    }

    [Fact]
    public async Task HandleAsync_Get{{ r }}List_ReturnsEmptyArray()
    {
        var httpContext = Mocks.CreateHttpContext("GET", "/{{ resource.endpoint }}");
        _mock{{ r }}Controller.GetListAsync(Arg.Any<string?>(), Arg.Any<CancellationToken>()).Returns(new List<{{ r }}Dto>());

        await _handler.HandleAsync(httpContext, null);

        Assert.Equal(200, httpContext.Response.StatusCode);
        Assert.Equal("[]", Mocks.ReadResponseBody(httpContext));
    }
{%- endif %}
{%- if "create" in ops %}

    [Fact]
    public async Task HandleAsync_Create{{ r }}_ReturnsCreated()
    {
        var httpContext = Mocks.CreateHttpContext(new Create{{ r }}Request { Name = "mock{{ r }}" }, "POST", "/{{ resource.endpoint }}");
        _mock{{ r }}Controller.CreateAsync(Arg.Any<Stream>(), Arg.Any<string?>(), Arg.Any<CancellationToken>())
            .Returns(Mocks.WithAuditFields(new {{ r }}Dto { Id = ItemId, Name = "mock{{ r }}" }));

        await _handler.HandleAsync(httpContext, null);

        Assert.Equal(201, httpContext.Response.StatusCode);
        Assert.Equal($"{{ '{{' }}\"id\":\"{ItemId}\",\"name\":\"mock{{ r }}\",{Mocks.AuditJson()}{{ '}}' }}", Mocks.ReadResponseBody(httpContext));
    }
{%- if has_item %}

    [Fact]
    public async Task HandleAsync_PostWithId_ReturnsMethodNotAllowed()
    {
        var httpContext = Mocks.CreateHttpContext(new Create{{ r }}Request { Name = "mock{{ r }}" }, "POST", "/{{ resource.endpoint }}/" + ItemId);

        await _handler.HandleAsync(httpContext, ItemId);

        Assert.Equal(405, httpContext.Response.StatusCode);
        Assert.Equal("{\"errorMessage\":\"Method not allowed.\"}", Mocks.ReadResponseBody(httpContext));
        await _mock{{ r }}Controller.DidNotReceiveWithAnyArgs().CreateAsync(default!, default, default);
    }
{%- endif %}
{%- endif %}
{%- if "update" in ops %}

    [Fact]
    public async Task HandleAsync_Update{{ r }}_ReturnsOk()
    {
        var httpContext = Mocks.CreateHttpContext(new Update{{ r }}Request { Name = "mockUpdated{{ r }}" }, "PATCH", "/{{ resource.endpoint }}/" + ItemId);
        _mock{{ r }}Controller.UpdateAsync(ItemId, Arg.Any<Stream>(), Arg.Any<string?>(), Arg.Any<CancellationToken>())
            .Returns(Mocks.WithAuditFields(new {{ r }}Dto { Id = ItemId, Name = "mockUpdated{{ r }}" }));

        await _handler.HandleAsync(httpContext, ItemId);

        Assert.Equal(200, httpContext.Response.StatusCode);
        Assert.Equal($"{{ '{{' }}\"id\":\"{ItemId}\",\"name\":\"mockUpdated{{ r }}\",{Mocks.AuditJson()}{{ '}}' }}", Mocks.ReadResponseBody(httpContext));
        await _mock{{ r }}Controller.Received(1).UpdateAsync(ItemId, Arg.Any<Stream>(), Arg.Any<string?>(), Arg.Any<CancellationToken>());
    }
{%- endif %}
{%- if "replace" in ops %}

    [Fact]
    public async Task HandleAsync_Replace{{ r }}_ReturnsOk()
    {
        var httpContext = Mocks.CreateHttpContext(new Replace{{ r }}Request { Name = "mockReplaced{{ r }}" }, "PUT", "/{{ resource.endpoint }}/" + ItemId);
        _mock{{ r }}Controller.ReplaceAsync(ItemId, Arg.Any<Stream>(), Arg.Any<string?>(), Arg.Any<CancellationToken>())
            .Returns(Mocks.WithAuditFields(new {{ r }}Dto { Id = ItemId, Name = "mockReplaced{{ r }}" }));

        await _handler.HandleAsync(httpContext, ItemId);

        Assert.Equal(200, httpContext.Response.StatusCode);
        Assert.Equal($"{{ '{{' }}\"id\":\"{ItemId}\",\"name\":\"mockReplaced{{ r }}\",{Mocks.AuditJson()}{{ '}}' }}", Mocks.ReadResponseBody(httpContext));
        await _mock{{ r }}Controller.Received(1).ReplaceAsync(ItemId, Arg.Any<Stream>(), Arg.Any<string?>(), Arg.Any<CancellationToken>());
    }
{%- endif %}
{%- if "delete" in ops %}

    [Fact]
    public async Task HandleAsync_Delete{{ r }}_ReturnsDeleteMessage()
    {
        var httpContext = Mocks.CreateHttpContext("DELETE", "/{{ resource.endpoint }}/" + ItemId);
        _mock{{ r }}Controller.DeleteAsync(ItemId, Arg.Any<string?>(), Arg.Any<CancellationToken>()).Returns(DeleteOkObjectResult.For("{{ r }}", ItemId));

        await _handler.HandleAsync(httpContext, ItemId);

        Assert.Equal(200, httpContext.Response.StatusCode);
        Assert.Equal($"{{ '{{' }}\"message\":\"{{ r }} with id {ItemId} was deleted successfully.\"{{ '}}' }}", Mocks.ReadResponseBody(httpContext));
    }
{%- endif %}
{%- for op, method, with_id in op_requests if op not in ops %}

    [Fact]
    public async Task HandleAsync_{{ method | capitalize }}{{ "ById" if with_id else "" }}_Returns{{ "MethodNotAllowed" if (has_item if with_id else has_collection) else "NotFound" }}_WhenDisabled()
    {
        var httpContext = Mocks.CreateHttpContext("{{ method }}", "/{{ resource.endpoint }}{{ '/" + ItemId' if with_id else '"' }});

        await _handler.HandleAsync(httpContext, {{ "ItemId" if with_id else "null" }});
{% if (has_item if with_id else has_collection) %}
        Assert.Equal(405, httpContext.Response.StatusCode);
        Assert.Equal("{\"errorMessage\":\"Method not allowed.\"}", Mocks.ReadResponseBody(httpContext));
{%- else %}
        Assert.Equal(404, httpContext.Response.StatusCode);
        Assert.Equal("{\"errorMessage\":\"Not found.\"}", Mocks.ReadResponseBody(httpContext));
{%- endif %}
    }
{%- endfor %}

    [Fact]
    public async Task HandleAsync_PropagatesException_WhenControllerThrows()
    {
{%- if first_op[0] == 'list' %}
        var httpContext = Mocks.CreateHttpContext("GET", "/{{ resource.endpoint }}");
        _mock{{ r }}Controller.GetListAsync(Arg.Any<string?>(), Arg.Any<CancellationToken>()).Throws(new Exception("Mock exception"));
{%- elif first_op[0] == 'get_by_id' %}
        var httpContext = Mocks.CreateHttpContext("GET", "/{{ resource.endpoint }}/" + ItemId);
        _mock{{ r }}Controller.GetAsync(ItemId, Arg.Any<CancellationToken>()).Throws(new Exception("Mock exception"));
{%- elif first_op[0] == 'create' %}
        var httpContext = Mocks.CreateHttpContext(new Create{{ r }}Request { Name = "mock{{ r }}" }, "POST", "/{{ resource.endpoint }}");
        _mock{{ r }}Controller.CreateAsync(Arg.Any<Stream>(), Arg.Any<string?>(), Arg.Any<CancellationToken>()).Throws(new Exception("Mock exception"));
{%- elif first_op[0] == 'update' %}
        var httpContext = Mocks.CreateHttpContext(new Update{{ r }}Request { Name = "mock{{ r }}" }, "PATCH", "/{{ resource.endpoint }}/" + ItemId);
        _mock{{ r }}Controller.UpdateAsync(ItemId, Arg.Any<Stream>(), Arg.Any<string?>(), Arg.Any<CancellationToken>()).Throws(new Exception("Mock exception"));
{%- elif first_op[0] == 'replace' %}
        var httpContext = Mocks.CreateHttpContext(new Replace{{ r }}Request { Name = "mock{{ r }}" }, "PUT", "/{{ resource.endpoint }}/" + ItemId);
        _mock{{ r }}Controller.ReplaceAsync(ItemId, Arg.Any<Stream>(), Arg.Any<string?>(), Arg.Any<CancellationToken>()).Throws(new Exception("Mock exception"));
{%- else %}
        var httpContext = Mocks.CreateHttpContext("DELETE", "/{{ resource.endpoint }}/" + ItemId);
        _mock{{ r }}Controller.DeleteAsync(ItemId, Arg.Any<string?>(), Arg.Any<CancellationToken>()).Throws(new Exception("Mock exception"));
{%- endif %}

        var exception = await Assert.ThrowsAsync<Exception>(() => _handler.HandleAsync(httpContext, {{ "ItemId" if first_op[2] else "null" }}));

        Assert.Equal("Mock exception", exception.Message);
    }
}
