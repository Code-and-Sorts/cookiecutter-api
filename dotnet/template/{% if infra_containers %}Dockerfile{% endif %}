FROM mcr.microsoft.com/dotnet/sdk:{{ runtime.dotnet }}.0 AS build
WORKDIR /src
COPY {{project_class_name}}.Api/{{project_class_name}}.Api.csproj {{project_class_name}}.Api/
RUN dotnet restore {{project_class_name}}.Api/{{project_class_name}}.Api.csproj
COPY {{project_class_name}}.Api/ {{project_class_name}}.Api/
RUN dotnet publish {{project_class_name}}.Api/{{project_class_name}}.Api.csproj --configuration Release --no-restore --output /app/publish
{%- if cloud_service == 'Azure Function App' %}

FROM mcr.microsoft.com/azure-functions/dotnet-isolated:4-dotnet-isolated{{ runtime.dotnet }}.0
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true
COPY --from=build /app/publish /home/site/wwwroot
{%- endif %}
