FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY {{project_class_name}}.Api/{{project_class_name}}.Api.csproj {{project_class_name}}.Api/
RUN dotnet restore {{project_class_name}}.Api/{{project_class_name}}.Api.csproj
COPY {{project_class_name}}.Api/ {{project_class_name}}.Api/
RUN dotnet publish {{project_class_name}}.Api/{{project_class_name}}.Api.csproj --configuration Release --no-restore --output /home/site/wwwroot

FROM mcr.microsoft.com/azure-functions/dotnet-isolated:4-dotnet-isolated10.0
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true
COPY --from=build /home/site/wwwroot /home/site/wwwroot
