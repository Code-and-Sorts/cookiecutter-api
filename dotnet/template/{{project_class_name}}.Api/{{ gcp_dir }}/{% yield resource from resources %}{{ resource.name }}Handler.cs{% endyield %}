{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set has_collection = "list" in ops or "create" in ops -%}
{%- set has_item = "get_by_id" in ops or "update" in ops or "replace" in ops or "delete" in ops -%}
namespace {{project_class_name}}.Api.Handlers;

using System.Threading.Tasks;
using Microsoft.AspNetCore.Http;
using {{project_class_name}}.Api.Interfaces;
using {{project_class_name}}.Api.Utils;

public class {{ r }}Handler(I{{ r }}Controller controller) : IResourceHandler
{
    private readonly I{{ r }}Controller _controller = controller;

    public string Endpoint => "{{ resource.endpoint }}";

    public async Task HandleAsync(HttpContext context, string? id)
    {
        var request = context.Request;
        var response = context.Response;
        var ct = context.RequestAborted;

        switch (request.Method, id)
        {
{%- if "get_by_id" in ops %}
            case ("GET", string itemId):
                await response.WriteJsonAsync(StatusCodes.Status200OK, await _controller.GetAsync(itemId, ct), ct);
                return;
{%- endif %}
{%- if "list" in ops %}
            case ("GET", null):
                await response.WriteJsonAsync(StatusCodes.Status200OK, await _controller.GetListAsync(request.Query["limit"].ToString(), ct), ct);
                return;
{%- endif %}
{%- if "create" in ops %}
            case ("POST", null):
                await response.WriteJsonAsync(StatusCodes.Status201Created, await _controller.CreateAsync(request.Body, ct), ct);
                return;
{%- endif %}
{%- if "update" in ops %}
            case ("PATCH", string itemId):
                await response.WriteJsonAsync(StatusCodes.Status200OK, await _controller.UpdateAsync(itemId, request.Body, ct), ct);
                return;
{%- endif %}
{%- if "replace" in ops %}
            case ("PUT", string itemId):
                await response.WriteJsonAsync(StatusCodes.Status200OK, await _controller.ReplaceAsync(itemId, request.Body, ct), ct);
                return;
{%- endif %}
{%- if "delete" in ops %}
            case ("DELETE", string itemId):
                await _controller.DeleteAsync(itemId, ct);
                await response.WriteJsonAsync(StatusCodes.Status200OK, new DeleteOkObjectResult { Message = $"{{ r }} with id {itemId} was deleted successfully." }, ct);
                return;
{%- endif %}
{%- if not has_collection %}
            case (_, null):
{%- endif %}
{%- if not has_item %}
            case (_, not null):
{%- endif %}
{%- if not (has_collection and has_item) %}
                // No operation of this resource uses this path.
                await response.WriteErrorAsync(StatusCodes.Status404NotFound, "Not found.", ct);
                return;
{%- endif %}
            default:
                // A path this resource serves, with a method it does not enable.
                await response.WriteErrorAsync(StatusCodes.Status405MethodNotAllowed, "Method not allowed.", ct);
                return;
        }
    }
}
