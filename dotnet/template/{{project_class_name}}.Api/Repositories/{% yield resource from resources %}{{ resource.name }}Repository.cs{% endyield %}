namespace {{project_class_name}}.Api.Repositories;

using System.Collections.Generic;
{%- if has_list %}
using System.Linq;
{%- endif %}
using System.Threading;
using System.Threading.Tasks;
{%- if returns_dto %}
using {{project_class_name}}.Api.Dtos;
{%- endif %}
using {{project_class_name}}.Api.Entities;
using {{project_class_name}}.Api.Interfaces;
{%- if reads_item %}
using {{project_class_name}}.Api.Utils;
{%- endif %}
using Amazon.DynamoDBv2;
using Amazon.DynamoDBv2.Model;

public class {{ r }}Repository : I{{ r }}Repository
{
{%- if reads_item %}
    private const string ResourceName = "{{ r }}";
{%- endif %}
    private readonly IAmazonDynamoDB _dynamoClient;
    private readonly string _tableName;

    public {{ r }}Repository(IAmazonDynamoDB dynamoClient, string tableName)
    {
        _dynamoClient = dynamoClient;
        _tableName = tableName;
    }
{%- if returns_dto %}

    private static {{ r }}Dto ToDto({{ r }}Entity item) => new() { Id = item.Id, Name = item.Name };
{%- endif %}
{%- if writes_item %}

    private static Dictionary<string, AttributeValue> ToAttributeMap({{ r }}Entity entity)
    {
        var item = new Dictionary<string, AttributeValue>
        {
            { "id", new AttributeValue { S = entity.Id } },
            { "name", new AttributeValue { S = entity.Name } },
            { "isDeleted", new AttributeValue { BOOL = entity.IsDeleted } },
            { "createdTimestamp", new AttributeValue { S = entity.CreatedTimestamp } },
            { "updatedTimestamp", new AttributeValue { S = entity.UpdatedTimestamp } },
        };
        // createdBy and updatedBy are only stored when set.
        if (entity.CreatedBy != null)
        {
            item["createdBy"] = new AttributeValue { S = entity.CreatedBy };
        }
        if (entity.UpdatedBy != null)
        {
            item["updatedBy"] = new AttributeValue { S = entity.UpdatedBy };
        }
        return item;
    }
{%- endif %}
{%- if reads_item or has_list %}

    private static {{ r }}Entity FromAttributeMap(Dictionary<string, AttributeValue> item)
    {
        return new {{ r }}Entity
        {
            Id = item.TryGetValue("id", out var id) ? id.S : string.Empty,
            Name = item.TryGetValue("name", out var name) ? name.S : string.Empty,
            IsDeleted = item.TryGetValue("isDeleted", out var isDeleted) && isDeleted.BOOL == true,
            CreatedTimestamp = item.TryGetValue("createdTimestamp", out var createdTimestamp) ? createdTimestamp.S : string.Empty,
            UpdatedTimestamp = item.TryGetValue("updatedTimestamp", out var updatedTimestamp) ? updatedTimestamp.S : string.Empty,
            CreatedBy = item.TryGetValue("createdBy", out var createdBy) ? createdBy.S : null,
            UpdatedBy = item.TryGetValue("updatedBy", out var updatedBy) ? updatedBy.S : null,
        };
    }
{%- endif %}
{%- if reads_item %}

    private async Task<{{ r }}Entity> GetItemAsync(string id, CancellationToken ct)
    {
        var response = await _dynamoClient.GetItemAsync(new GetItemRequest
        {
            TableName = _tableName,
            Key = new Dictionary<string, AttributeValue>
            {
                { "id", new AttributeValue { S = id } }
            }
        }, ct);

        if (response.Item == null || response.Item.Count == 0)
        {
            throw new NotFoundException(ResourceName, id);
        }

        var entity = FromAttributeMap(response.Item);

        if (entity.IsDeleted)
        {
            throw new NotFoundException(ResourceName, id);
        }

        return entity;
    }
{%- endif %}
{%- if writes_item %}

    private async Task PutAsync({{ r }}Entity entity, CancellationToken ct)
    {
        await _dynamoClient.PutItemAsync(new PutItemRequest
        {
            TableName = _tableName,
            Item = ToAttributeMap(entity)
        }, ct);
    }
{%- endif %}
{%- if "get_by_id" in ops %}

    public async Task<{{ r }}Dto> GetAsync(string id, CancellationToken ct = default) => ToDto(await GetItemAsync(id, ct));
{%- endif %}
{%- if has_list %}

    public async Task<IEnumerable<{{ r }}Dto>> GetListAsync(int limit, CancellationToken ct = default)
    {
        var results = new List<{{ r }}Entity>();
        Dictionary<string, AttributeValue>? lastEvaluatedKey = null;

        // A scan's Limit counts the items read before the isDeleted filter, so keep
        // reading pages until `limit` live items are found or the table is exhausted.
        do
        {
            var request = new ScanRequest
            {
                TableName = _tableName,
                FilterExpression = "isDeleted = :isDeleted",
                ExpressionAttributeValues = new Dictionary<string, AttributeValue>
                {
                    { ":isDeleted", new AttributeValue { BOOL = false } }
                },
                ExclusiveStartKey = lastEvaluatedKey,
                Limit = limit
            };

            var response = await _dynamoClient.ScanAsync(request, ct);
            results.AddRange((response.Items ?? []).Select(FromAttributeMap));
            lastEvaluatedKey = response.LastEvaluatedKey is { Count: > 0 } ? response.LastEvaluatedKey : null;
        } while (lastEvaluatedKey != null && results.Count < limit);

        return results.Take(limit).Select(ToDto).ToList();
    }
{%- endif %}
{%- if "create" in ops %}

    public async Task<{{ r }}Dto> CreateAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        await PutAsync(item, ct);

        return ToDto(item);
    }
{%- endif %}
{%- if "update" in ops %}

    public async Task<{{ r }}Dto> UpdateAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        // Keep id, createdTimestamp and createdBy from the stored record.
        var currentItem = await GetItemAsync(item.Id, ct);
        currentItem.Name = item.Name ?? currentItem.Name;
        currentItem.UpdatedBy = item.UpdatedBy ?? currentItem.UpdatedBy;
        currentItem.UpdatedTimestamp = Timestamps.Now();

        await PutAsync(currentItem, ct);

        return ToDto(currentItem);
    }
{%- endif %}
{%- if "replace" in ops %}

    public async Task<{{ r }}Dto> ReplaceAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        // Keep id, createdTimestamp and createdBy from the stored record.
        var currentItem = await GetItemAsync(item.Id, ct);
        currentItem.Name = item.Name;
        currentItem.UpdatedBy = item.UpdatedBy ?? currentItem.UpdatedBy;
        currentItem.UpdatedTimestamp = Timestamps.Now();

        await PutAsync(currentItem, ct);

        return ToDto(currentItem);
    }
{%- endif %}
{%- if "delete" in ops %}

    public async Task DeleteAsync(string id, CancellationToken ct = default)
    {
        var item = await GetItemAsync(id, ct);
        item.IsDeleted = true;
        item.UpdatedTimestamp = Timestamps.Now();

        await PutAsync(item, ct);
    }
{%- endif %}
}
{%- endif %}
