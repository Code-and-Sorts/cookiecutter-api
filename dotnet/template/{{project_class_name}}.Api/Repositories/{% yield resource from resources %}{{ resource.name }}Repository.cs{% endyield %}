{%- set r = resource.name %}
{%- set ops = resource.operations %}
{%- set has_list = "list" in ops %}
{%- set writes_body = "update" in ops or "replace" in ops %}
{%- set reads_item = "get_by_id" in ops or writes_body or "delete" in ops %}
{%- set returns_dto = ops | reject("equalto", "delete") | list | length > 0 %}
{%- if cloud_service in ['Azure Function App', 'GCP Cloud Function'] %}
namespace {{project_class_name}}.Api.Repositories;
{% if writes_body %}
using System;
{%- endif %}
{%- if has_list or (cloud_service == 'GCP Cloud Function' and reads_item) %}
using System.Collections.Generic;
{%- endif %}
{%- if has_list %}
using System.Linq;
{%- endif %}
using System.Threading;
using System.Threading.Tasks;
{%- if returns_dto %}
using {{project_class_name}}.Api.Dtos;
{%- endif %}
using {{project_class_name}}.Api.Entities;
using {{project_class_name}}.Api.Interfaces;
{%- if cloud_service == 'Azure Function App' %}
using Microsoft.Azure.Cosmos;
{%- endif %}

public class {{ r }}Repository : I{{ r }}Repository
{
{%- if cloud_service == 'Azure Function App' %}
{%- if has_list %}
    // Default cap on list reads to avoid unbounded queries.
    private const int DefaultListLimit = 100;
{%- endif %}
    private readonly Container _container;

    public {{ r }}Repository(CosmosClient cosmosClient, string databaseName, string containerName)
    {
        _container = cosmosClient.GetContainer(databaseName, containerName);
    }
{%- if reads_item %}

    private async Task<{{ r }}Entity> GetItemAsync(string id, CancellationToken ct)
    {
        var response = await _container.ReadItemAsync<{{ r }}Entity>(id, new PartitionKey(id), null, ct);
        var item = response.Resource;

        if (item.IsDeleted)
        {
            throw new CosmosException("Item not found", System.Net.HttpStatusCode.NotFound, 0, string.Empty, 0);
        }
        return item;
    }
{%- endif %}
{%- if "get_by_id" in ops %}

    public async Task<{{ r }}Dto> GetAsync(string id, CancellationToken ct = default)
    {
        var item = await GetItemAsync(id, ct);

        return new {{ r }}Dto
        {
            Id = item.Id,
            Name = item.Name,
        };
    }
{%- endif %}
{%- if has_list %}

    public async Task<IEnumerable<{{ r }}Dto>> GetListAsync(CancellationToken ct = default)
    {
        var query = _container.GetItemQueryIterator<{{ r }}Entity>($"SELECT * FROM c WHERE c.isDeleted = false OFFSET 0 LIMIT {DefaultListLimit}");
        var results = new List<{{ r }}Entity>();

        while (query.HasMoreResults && results.Count < DefaultListLimit)
        {
            var response = await query.ReadNextAsync(ct);
            results.AddRange(response.Resource);
        }

        return results.Take(DefaultListLimit).Select(item => new {{ r }}Dto
        {
            Id = item.Id,
            Name = item.Name,
        });
    }
{%- endif %}
{%- if "create" in ops %}

    public async Task<{{ r }}Dto> CreateAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        var response = await _container.CreateItemAsync(item, new PartitionKey(item.Id), null, ct);
        var created = response.Resource;
        return new {{ r }}Dto
        {
            Id = created.Id,
            Name = created.Name,
        };
    }
{%- endif %}
{%- if "update" in ops %}

    public async Task<{{ r }}Dto> UpdateAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        var currentItem = await GetItemAsync(item.Id, ct);
        var updateItem = new {{ r }}Entity
        {
            Id = currentItem.Id,
            Name = item.Name ?? currentItem.Name,
            CreatedBy = currentItem.CreatedBy,
            CreatedTimestamp = currentItem.CreatedTimestamp,
            UpdatedBy = item.UpdatedBy ?? currentItem.UpdatedBy,
            UpdatedTimestamp = DateTime.UtcNow,
        };
        var response = await _container.ReplaceItemAsync<{{ r }}Entity>(updateItem, updateItem.Id, new PartitionKey(updateItem.Id), null, ct);
        var updated = response.Resource;
        return new {{ r }}Dto
        {
            Id = updated.Id,
            Name = updated.Name,
        };
    }
{%- endif %}
{%- if "replace" in ops %}

    public async Task<{{ r }}Dto> ReplaceAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        var currentItem = await GetItemAsync(item.Id, ct);
        var replaceItem = new {{ r }}Entity
        {
            Id = currentItem.Id,
            Name = item.Name,
            CreatedBy = currentItem.CreatedBy,
            CreatedTimestamp = currentItem.CreatedTimestamp,
            UpdatedBy = item.UpdatedBy,
            UpdatedTimestamp = DateTime.UtcNow,
        };
        var response = await _container.ReplaceItemAsync<{{ r }}Entity>(replaceItem, replaceItem.Id, new PartitionKey(replaceItem.Id), null, ct);
        var replaced = response.Resource;
        return new {{ r }}Dto
        {
            Id = replaced.Id,
            Name = replaced.Name,
        };
    }
{%- endif %}
{%- if "delete" in ops %}

    public async Task DeleteAsync(string id, CancellationToken ct = default)
    {
        var item = await GetItemAsync(id, ct);
        item.IsDeleted = true;
        await _container.ReplaceItemAsync<{{ r }}Entity>(item, item.Id, new PartitionKey(item.Id), null, ct);
    }
{%- endif %}
{%- endif %}
{%- if cloud_service == 'GCP Cloud Function' %}
{%- if has_list %}
    // Default cap on list reads to avoid unbounded queries.
    private const int DefaultListLimit = 100;
{%- endif %}
    private readonly IFirestoreContext<{{ r }}Entity> _context;

    public {{ r }}Repository(IFirestoreContext<{{ r }}Entity> context)
    {
        _context = context;
    }
{%- if reads_item %}

    private async Task<{{ r }}Entity> GetItemAsync(string id, CancellationToken ct)
    {
        var item = await _context.GetAsync(id, ct);

        if (item == null || item.IsDeleted)
        {
            throw new KeyNotFoundException($"Item with id {id} not found.");
        }

        return item;
    }
{%- endif %}
{%- if "get_by_id" in ops %}

    public async Task<{{ r }}Dto> GetAsync(string id, CancellationToken ct = default)
    {
        var item = await GetItemAsync(id, ct);

        return new {{ r }}Dto
        {
            Id = item.Id,
            Name = item.Name,
        };
    }
{%- endif %}
{%- if has_list %}

    public async Task<IEnumerable<{{ r }}Dto>> GetListAsync(CancellationToken ct = default)
    {
        var results = await _context.GetListAsync("isDeleted", false, ct);

        return results.Take(DefaultListLimit).Select(item => new {{ r }}Dto
        {
            Id = item.Id,
            Name = item.Name,
        });
    }
{%- endif %}
{%- if "create" in ops %}

    public async Task<{{ r }}Dto> CreateAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        await _context.SetAsync(item.Id, item, ct);

        return new {{ r }}Dto
        {
            Id = item.Id,
            Name = item.Name,
        };
    }
{%- endif %}
{%- if "update" in ops %}

    public async Task<{{ r }}Dto> UpdateAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        var currentItem = await GetItemAsync(item.Id, ct);
        var updateItem = new {{ r }}Entity
        {
            Id = currentItem.Id,
            Name = item.Name ?? currentItem.Name,
            CreatedBy = currentItem.CreatedBy,
            CreatedTimestamp = currentItem.CreatedTimestamp,
            UpdatedBy = item.UpdatedBy ?? currentItem.UpdatedBy,
            UpdatedTimestamp = DateTime.UtcNow,
        };

        await _context.SetAsync(updateItem.Id, updateItem, ct);

        return new {{ r }}Dto
        {
            Id = updateItem.Id,
            Name = updateItem.Name,
        };
    }
{%- endif %}
{%- if "replace" in ops %}

    public async Task<{{ r }}Dto> ReplaceAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        var currentItem = await GetItemAsync(item.Id, ct);
        var replaceItem = new {{ r }}Entity
        {
            Id = currentItem.Id,
            Name = item.Name,
            CreatedBy = currentItem.CreatedBy,
            CreatedTimestamp = currentItem.CreatedTimestamp,
            UpdatedBy = item.UpdatedBy,
            UpdatedTimestamp = DateTime.UtcNow,
        };

        await _context.SetAsync(replaceItem.Id, replaceItem, ct);

        return new {{ r }}Dto
        {
            Id = replaceItem.Id,
            Name = replaceItem.Name,
        };
    }
{%- endif %}
{%- if "delete" in ops %}

    public async Task DeleteAsync(string id, CancellationToken ct = default)
    {
        var item = await GetItemAsync(id, ct);
        item.IsDeleted = true;

        await _context.SetAsync(item.Id, item, ct);
    }
{%- endif %}
{%- endif %}
}
{%- endif %}
