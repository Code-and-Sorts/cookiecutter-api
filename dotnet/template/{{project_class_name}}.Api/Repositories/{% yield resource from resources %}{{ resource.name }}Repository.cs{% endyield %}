using Microsoft.Azure.Cosmos;

public class {{ r }}Repository : I{{ r }}Repository
{
{%- if reads_item %}
    private const string ResourceName = "{{ r }}";
{%- endif %}
    private readonly Container _container;

    public {{ r }}Repository(CosmosClient cosmosClient, string databaseName, string containerName)
    {
        _container = cosmosClient.GetContainer(databaseName, containerName);
    }
{%- if returns_dto %}

    private static {{ r }}Dto ToDto({{ r }}Entity item) => new() { Id = item.Id, Name = item.Name };
{%- endif %}
{%- if reads_item %}

    private async Task<{{ r }}Entity> GetItemAsync(string id, CancellationToken ct)
    {
        {{ r }}Entity? item;
        try
        {
            var response = await _container.ReadItemAsync<{{ r }}Entity>(id, new PartitionKey(id), null, ct);
            item = response.Resource;
        }
        // Substatus 0 is a missing item; any other 404 (for example 1003, the container or
        // database does not exist) is a configuration error and stays an unexpected 500.
        catch (CosmosException ex) when (ex.StatusCode == HttpStatusCode.NotFound && ex.SubStatusCode == 0)
        {
            throw new NotFoundException(ResourceName, id);
        }

        if (item == null || item.IsDeleted)
        {
            throw new NotFoundException(ResourceName, id);
        }
        return item;
    }
{%- endif %}
{%- if "get_by_id" in ops %}

    public async Task<{{ r }}Dto> GetAsync(string id, CancellationToken ct = default) => ToDto(await GetItemAsync(id, ct));
{%- endif %}
{%- if has_list %}

    public async Task<IEnumerable<{{ r }}Dto>> GetListAsync(int limit, CancellationToken ct = default)
    {
        // limit is an int parsed and clamped by the controller, so it is safe to inline.
        using var query = _container.GetItemQueryIterator<{{ r }}Entity>($"SELECT * FROM c WHERE c.isDeleted = false OFFSET 0 LIMIT {limit}");
        var results = new List<{{ r }}Entity>();

        while (query.HasMoreResults && results.Count < limit)
        {
            var response = await query.ReadNextAsync(ct);
            results.AddRange(response.Resource);
        }

        return results.Take(limit).Select(ToDto).ToList();
    }
{%- endif %}
{%- if "create" in ops %}

    public async Task<{{ r }}Dto> CreateAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        await _container.CreateItemAsync(item, new PartitionKey(item.Id), null, ct);
        return ToDto(item);
    }
{%- endif %}
{%- if "update" in ops %}

    public async Task<{{ r }}Dto> UpdateAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        // Keep id, createdTimestamp and createdBy from the stored record.
        var currentItem = await GetItemAsync(item.Id, ct);
        currentItem.Name = item.Name ?? currentItem.Name;
        currentItem.UpdatedBy = item.UpdatedBy ?? currentItem.UpdatedBy;
        currentItem.UpdatedTimestamp = Timestamps.Now();
        await _container.ReplaceItemAsync(currentItem, currentItem.Id, new PartitionKey(currentItem.Id), null, ct);
        return ToDto(currentItem);
    }
{%- endif %}
{%- if "replace" in ops %}

    public async Task<{{ r }}Dto> ReplaceAsync({{ r }}Entity item, CancellationToken ct = default)
    {
        // Keep id, createdTimestamp and createdBy from the stored record.
        var currentItem = await GetItemAsync(item.Id, ct);
        currentItem.Name = item.Name;
        currentItem.UpdatedBy = item.UpdatedBy ?? currentItem.UpdatedBy;
        currentItem.UpdatedTimestamp = Timestamps.Now();
        await _container.ReplaceItemAsync(currentItem, currentItem.Id, new PartitionKey(currentItem.Id), null, ct);
        return ToDto(currentItem);
    }
{%- endif %}
{%- if "delete" in ops %}

    public async Task DeleteAsync(string id, CancellationToken ct = default)
    {
        var item = await GetItemAsync(id, ct);
        item.IsDeleted = true;
        item.UpdatedTimestamp = Timestamps.Now();
        await _container.ReplaceItemAsync(item, item.Id, new PartitionKey(item.Id), null, ct);
    }
{%- endif %}
}
{%- endif %}
