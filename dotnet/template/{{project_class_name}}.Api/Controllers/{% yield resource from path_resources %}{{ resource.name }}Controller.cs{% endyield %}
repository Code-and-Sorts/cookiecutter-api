{%- set r = resource.name -%}
namespace {{project_class_name}}.Api.Controllers;

{% if "list" in resource.operations -%}
using System.Collections.Generic;
{% endif -%}
{% if resource.has_body -%}
using System.IO;
{% endif -%}
using System.Threading;
using System.Threading.Tasks;
{% if resource.has_dto -%}
using {{project_class_name}}.Api.Dtos;
{% endif -%}
using {{project_class_name}}.Api.Interfaces;
{% if resource.has_body -%}
using {{project_class_name}}.Api.Requests;
{% endif -%}
using {{project_class_name}}.Api.Utils;
{% if resource.has_body -%}
using {{project_class_name}}.Api.Validation;
{% endif %}
public class {{ r }}Controller : I{{ r }}Controller
{
    private const string ResourceName = "{{ r }}";
    private readonly I{{ r }}Service _service;

    public {{ r }}Controller(I{{ r }}Service service)
    {
        _service = service;
    }
{%- if "get_by_id" in resource.operations %}

    public async Task<{{ r }}Dto> GetAsync(string id, CancellationToken ct = default)
    {
        ItemIds.EnsureValid(ResourceName, id);
        return await _service.GetAsync(id, ct);
    }
{%- endif %}
{%- if "list" in resource.operations %}

    public async Task<IEnumerable<{{ r }}Dto>> GetListAsync(string? limit = null, CancellationToken ct = default) =>
        await _service.GetListAsync(Pagination.ParseLimit(limit), ct);
{%- endif %}
{%- if "create" in resource.operations %}

    public async Task<{{ r }}Dto> CreateAsync(Stream item, CancellationToken ct = default)
    {
        var request = await RequestBody.ReadValidAsync<Create{{ r }}Request, Create{{ r }}RequestValidator>(item, ct);
        return await _service.CreateAsync(request, ct);
    }
{%- endif %}
{%- if "update" in resource.operations %}

    public async Task<{{ r }}Dto> UpdateAsync(string id, Stream item, CancellationToken ct = default)
    {
        ItemIds.EnsureValid(ResourceName, id);
        var request = await RequestBody.ReadValidAsync<Update{{ r }}Request, Update{{ r }}RequestValidator>(item, ct);
        request.Id = id;
        return await _service.UpdateAsync(request, ct);
    }
{%- endif %}
{%- if "replace" in resource.operations %}

    public async Task<{{ r }}Dto> ReplaceAsync(string id, Stream item, CancellationToken ct = default)
    {
        ItemIds.EnsureValid(ResourceName, id);
        var request = await RequestBody.ReadValidAsync<Replace{{ r }}Request, Replace{{ r }}RequestValidator>(item, ct);
        request.Id = id;
        return await _service.ReplaceAsync(request, ct);
    }
{%- endif %}
{%- if "delete" in resource.operations %}

    public async Task<DeleteOkObjectResult> DeleteAsync(string id, CancellationToken ct = default)
    {
        ItemIds.EnsureValid(ResourceName, id);
        await _service.DeleteAsync(id, ct);
        return DeleteOkObjectResult.For(ResourceName, id);
    }
{%- endif %}
}
