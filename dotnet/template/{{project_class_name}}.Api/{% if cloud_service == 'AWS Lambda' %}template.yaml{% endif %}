AWSTemplateFormatVersion: '2010-09-09'
Transform: AWS::Serverless-2016-10-31
Description: {{project_description}}

Globals:
  Function:
    Timeout: 30
    Runtime: dotnet8
    MemorySize: 256

Resources:
{%- for resource in resources %}
{%- set cn = resource.name %}
{%- set tableRef = resource.container | to_camel %}
{%- set tableEnv = 'DYNAMODB_TABLE_NAME_' ~ (resource.container | upper | replace('-', '_')) %}
{%- if "get_by_id" in resource.operations %}
  Get{{ cn }}Function:
    Type: AWS::Serverless::Function
    Properties:
      Handler: {{project_class_name}}.Api::{{project_class_name}}.Api.Functions.ItemFunctions::Get{{ cn }}
      CodeUri: ./
      Environment:
        Variables:
          {{ tableEnv }}: !Ref {{ tableRef }}Table
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref {{ tableRef }}Table
      Events:
        GetById:
          Type: Api
          Properties:
            Path: /api/{{ resource.endpoint }}/{id}
            Method: GET
{%- endif %}
{%- if "list" in resource.operations %}
  Get{{ cn }}ListFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: {{project_class_name}}.Api::{{project_class_name}}.Api.Functions.ItemFunctions::Get{{ cn }}List
      CodeUri: ./
      Environment:
        Variables:
          {{ tableEnv }}: !Ref {{ tableRef }}Table
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref {{ tableRef }}Table
      Events:
        GetList:
          Type: Api
          Properties:
            Path: /api/{{ resource.endpoint }}
            Method: GET
{%- endif %}
{%- if "create" in resource.operations %}
  Create{{ cn }}Function:
    Type: AWS::Serverless::Function
    Properties:
      Handler: {{project_class_name}}.Api::{{project_class_name}}.Api.Functions.ItemFunctions::Create{{ cn }}
      CodeUri: ./
      Environment:
        Variables:
          {{ tableEnv }}: !Ref {{ tableRef }}Table
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref {{ tableRef }}Table
      Events:
        Create:
          Type: Api
          Properties:
            Path: /api/{{ resource.endpoint }}
            Method: POST
{%- endif %}
{%- if "update" in resource.operations %}
  Update{{ cn }}Function:
    Type: AWS::Serverless::Function
    Properties:
      Handler: {{project_class_name}}.Api::{{project_class_name}}.Api.Functions.ItemFunctions::Update{{ cn }}
      CodeUri: ./
      Environment:
        Variables:
          {{ tableEnv }}: !Ref {{ tableRef }}Table
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref {{ tableRef }}Table
      Events:
        Update:
          Type: Api
          Properties:
            Path: /api/{{ resource.endpoint }}/{id}
            Method: PATCH
{%- endif %}
{%- if "replace" in resource.operations %}
  Replace{{ cn }}Function:
    Type: AWS::Serverless::Function
    Properties:
      Handler: {{project_class_name}}.Api::{{project_class_name}}.Api.Functions.ItemFunctions::Replace{{ cn }}
      CodeUri: ./
      Environment:
        Variables:
          {{ tableEnv }}: !Ref {{ tableRef }}Table
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref {{ tableRef }}Table
      Events:
        Replace:
          Type: Api
          Properties:
            Path: /api/{{ resource.endpoint }}/{id}
            Method: PUT
{%- endif %}
{%- if "delete" in resource.operations %}
  Delete{{ cn }}Function:
    Type: AWS::Serverless::Function
    Properties:
      Handler: {{project_class_name}}.Api::{{project_class_name}}.Api.Functions.ItemFunctions::Delete{{ cn }}
      CodeUri: ./
      Environment:
        Variables:
          {{ tableEnv }}: !Ref {{ tableRef }}Table
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref {{ tableRef }}Table
      Events:
        Delete:
          Type: Api
          Properties:
            Path: /api/{{ resource.endpoint }}/{id}
            Method: DELETE
{%- endif %}
{%- endfor %}

  HealthFunction:
    Type: AWS::Serverless::Function
    Properties:
      Handler: {{project_class_name}}.Api::{{project_class_name}}.Api.Functions.ItemFunctions::Health
      CodeUri: ./
      Events:
        Health:
          Type: Api
          Properties:
            Path: /api/health
            Method: GET
{% for container in resources | map(attribute='container') | unique %}
  {{ container | to_camel }}Table:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: {{ container }}
      AttributeDefinitions:
        - AttributeName: id
          AttributeType: S
      KeySchema:
        - AttributeName: id
          KeyType: HASH
      BillingMode: PAY_PER_REQUEST
{% endfor %}
Outputs:
  ApiEndpoint:
    Description: API Gateway endpoint URL
    Value: !Sub "https://${ServerlessRestApi}.execute-api.${AWS::Region}.amazonaws.com/Prod/api/"
{%- for container in resources | map(attribute='container') | unique %}
  {{ container | to_camel }}TableName:
    Description: DynamoDB table name for the {{ container }} container
    Value: !Ref {{ container | to_camel }}Table
{%- endfor %}
