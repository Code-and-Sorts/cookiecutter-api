namespace {{project_class_name}}.Api;

using System;
using System.Collections.Generic;
using System.Threading;
using System.Threading.Tasks;
using Google.Cloud.Functions.Framework;
using Microsoft.AspNetCore.Http;
using Microsoft.Extensions.Logging;
using {{project_class_name}}.Api.Interfaces;
using {{project_class_name}}.Api.Utils;
using Newtonsoft.Json;

public class Function : IHttpFunction
{
    private sealed record ResourceRoute(string Container, HashSet<string> Operations);

    // Endpoint -> its storage container and enabled operations.
    private static readonly Dictionary<string, ResourceRoute> Resources = new()
    {
{%- for resource in resources %}
        ["{{ resource.endpoint }}"] = new ResourceRoute("{{ resource.container }}", new HashSet<string> { {% for op in resource.operations %}"{{ op }}"{% if not loop.last %}, {% endif %}{% endfor %} }),
{%- endfor %}
    };

    private readonly IReadOnlyDictionary<string, IItemController> _controllers;
    private readonly ILogger<Function> _logger;

    public Function(IReadOnlyDictionary<string, IItemController> controllers, ILogger<Function> logger)
    {
        _controllers = controllers;
        _logger = logger;
    }

    private static async Task WriteJsonResponse(HttpResponse response, int statusCode, object body, CancellationToken ct = default)
    {
        response.StatusCode = statusCode;
        response.ContentType = "application/json";
        var json = JsonConvert.SerializeObject(body);
        await response.WriteAsync(json, ct);
    }

    public async Task HandleAsync(HttpContext context)
    {
        var request = context.Request;
        var response = context.Response;
        var ct = context.RequestAborted;

        try
        {
            var path = request.Path.Value ?? string.Empty;
            var trimmedPath = path.TrimEnd('/');
            if (request.Method == "GET" && (trimmedPath == "/health" || trimmedPath.EndsWith("/health")))
            {
                await WriteJsonResponse(response, 200, new { status = "ok" }, ct);
                return;
            }

            var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
            var endpoint = segments.Length >= 1 ? segments[0] : string.Empty;
            var id = segments.Length >= 2 ? segments[1] : null;

            if (!Resources.TryGetValue(endpoint, out var route))
            {
                await WriteJsonResponse(response, 404, new { error = "Not found." }, ct);
                return;
            }

            var controller = _controllers[route.Container];

            switch (request.Method)
            {
                case "GET":
                {
                    if (id != null)
                    {
                        if (!route.Operations.Contains("get_by_id"))
                        {
                            await WriteJsonResponse(response, 405, new { error = "Method not allowed." }, ct);
                            return;
                        }
                        var result = await controller.GetAsync(id, ct);
                        await WriteJsonResponse(response, 200, result, ct);
                        return;
                    }
                    if (!route.Operations.Contains("list"))
                    {
                        await WriteJsonResponse(response, 405, new { error = "Method not allowed." }, ct);
                        return;
                    }
                    var results = await controller.GetListAsync(ct);
                    await WriteJsonResponse(response, 200, results, ct);
                    return;
                }

                case "POST":
                {
                    if (!route.Operations.Contains("create"))
                    {
                        await WriteJsonResponse(response, 405, new { error = "Method not allowed." }, ct);
                        return;
                    }
                    if (id != null)
                    {
                        await WriteJsonResponse(response, 400, new { error = "POST does not accept an item ID." }, ct);
                        return;
                    }
                    var created = await controller.CreateAsync(request.Body, ct);
                    await WriteJsonResponse(response, 201, created, ct);
                    return;
                }

                case "PATCH":
                {
                    if (!route.Operations.Contains("update"))
                    {
                        await WriteJsonResponse(response, 405, new { error = "Method not allowed." }, ct);
                        return;
                    }
                    if (id == null)
                    {
                        await WriteJsonResponse(response, 400, new { error = "Missing item ID." }, ct);
                        return;
                    }
                    var updated = await controller.UpdateAsync(id, request.Body, ct);
                    await WriteJsonResponse(response, 200, updated, ct);
                    return;
                }

                case "PUT":
                {
                    if (!route.Operations.Contains("replace"))
                    {
                        await WriteJsonResponse(response, 405, new { error = "Method not allowed." }, ct);
                        return;
                    }
                    if (id == null)
                    {
                        await WriteJsonResponse(response, 400, new { error = "Missing item ID." }, ct);
                        return;
                    }
                    var replaced = await controller.ReplaceAsync(id, request.Body, ct);
                    await WriteJsonResponse(response, 200, replaced, ct);
                    return;
                }

                case "DELETE":
                {
                    if (!route.Operations.Contains("delete"))
                    {
                        await WriteJsonResponse(response, 405, new { error = "Method not allowed." }, ct);
                        return;
                    }
                    if (id == null)
                    {
                        await WriteJsonResponse(response, 400, new { error = "Missing item ID." }, ct);
                        return;
                    }
                    await controller.DeleteAsync(id, ct);
                    await WriteJsonResponse(response, 200, new { message = $"{endpoint} with id {id} was deleted successfully." }, ct);
                    return;
                }

                default:
                    await WriteJsonResponse(response, 405, new { error = "Method not allowed." }, ct);
                    return;
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Exception in Function -> HandleAsync method.");
            var errorResult = ErrorDetector.DetectError(ex);
            await WriteJsonResponse(response, errorResult.StatusCode ?? 500, errorResult.Value!, ct);
        }
    }
}
