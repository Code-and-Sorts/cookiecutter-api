{%- set r = resource.name -%}
{%- set request_ops = [('create', 'Create'), ('update', 'Update'), ('replace', 'Replace')] | selectattr(0, 'in', resource.operations) | list -%}
namespace {{project_class_name}}.Api.Validation;

using FluentValidation;
using {{project_class_name}}.Api.Requests;
{%- for op, prefix in request_ops %}

public class {{ prefix }}{{ r }}RequestValidator : AbstractValidator<{{ prefix }}{{ r }}Request>
{
    public {{ prefix }}{{ r }}RequestValidator()
    {
{%- if op == 'update' %}
        // PATCH: name is optional, but must not be empty when present.
        RuleFor(x => x.Name).NotEmpty().When(x => x.Name != null).WithMessage("name must be a non-empty string.");
{%- else %}
        RuleFor(x => x.Name).NotEmpty().WithMessage("name is required and must be a non-empty string.");
{%- endif %}
    }
}
{%- endfor %}
