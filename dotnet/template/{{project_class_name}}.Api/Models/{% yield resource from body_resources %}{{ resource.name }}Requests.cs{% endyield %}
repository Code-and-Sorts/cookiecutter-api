{%- from 'dotnet/_model.jinja' import assignments, csharp_file, default_value, properties with context -%}
{%- set r = resource.name -%}
{%- set fields = resource.fields -%}
{%- set body %}
{%- for op, Op in [("create", "Create"), ("update", "Update"), ("replace", "Replace")] if op in resource.operations %}
{%- set op_fields = fields | selectattr("in_" ~ op) | list %}

public class {{ Op }}{{ r }}Request : Base{{ Op }}Request
{
{{- properties(op_fields, op) }}
{%- if op_fields %}
{% endif %}
{%- if op == "create" %}
    public {{ r }}Entity ToEntity()
    {
        var item = new {{ r }}Entity();
        ApplyTo(item);
{{- assignments(op_fields, op, "item") }}
{%- for f in fields if not f.in_create and (f.dynamic or f.default is not none) %}
        item.{{ f.pascal }} = {{ default_value(f) }};
{%- endfor %}
        return item;
    }
{%- else %}
    public void ApplyTo({{ r }}Entity item)
    {
        base.ApplyTo(item);
{{- assignments(op_fields, op, "item") }}
    }
{%- endif %}
}
{%- endfor %}
{%- endset -%}
{{ csharp_file("Requests", body, ["Entities"]) }}
