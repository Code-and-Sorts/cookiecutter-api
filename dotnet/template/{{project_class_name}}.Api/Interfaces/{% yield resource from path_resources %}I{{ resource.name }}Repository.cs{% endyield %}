{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set uses_entity = resource.has_body -%}
{%- set uses_dto = resource.has_dto -%}
namespace {{project_class_name}}.Api.Interfaces;
{% if "list" in ops %}
using System.Collections.Generic;
{%- endif %}
using System.Threading;
using System.Threading.Tasks;
{%- if uses_dto %}
using {{project_class_name}}.Api.Dtos;
{%- endif %}
{%- if uses_entity %}
using {{project_class_name}}.Api.Entities;
{%- endif %}

public interface I{{ r }}Repository
{
{%- set ns = namespace(first=true) %}
{%- if "get_by_id" in ops %}
{%- if not ns.first %}
{% endif %}{% set ns.first = false %}
    Task<{{ r }}Dto> GetAsync(string id, CancellationToken ct = default);
{%- endif %}
{%- if "list" in ops %}
{%- if not ns.first %}
{% endif %}{% set ns.first = false %}
    Task<IEnumerable<{{ r }}Dto>> GetListAsync(int limit, CancellationToken ct = default);
{%- endif %}
{%- if "create" in ops %}
{%- if not ns.first %}
{% endif %}{% set ns.first = false %}
    Task<{{ r }}Dto> CreateAsync({{ r }}Entity item, CancellationToken ct = default);
{%- endif %}
{%- if "update" in ops %}
{%- if not ns.first %}
{% endif %}{% set ns.first = false %}
    Task<{{ r }}Dto> UpdateAsync({{ r }}Entity item, CancellationToken ct = default);
{%- endif %}
{%- if "replace" in ops %}
{%- if not ns.first %}
{% endif %}{% set ns.first = false %}
    Task<{{ r }}Dto> ReplaceAsync({{ r }}Entity item, CancellationToken ct = default);
{%- endif %}
{%- if "delete" in ops %}
{%- if not ns.first %}
{% endif %}{% set ns.first = false %}
    Task DeleteAsync(string id, CancellationToken ct = default);
{%- endif %}
}
