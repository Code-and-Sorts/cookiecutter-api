{%- set r = resource.name -%}
{%- set uses_body = "create" in resource.operations or "update" in resource.operations or "replace" in resource.operations -%}
namespace {{project_class_name}}.Api.Functions;

using System;
{% if uses_body -%}
using System.IO;
using System.Text;
{% endif -%}
using System.Threading.Tasks;
using Amazon.Lambda.Annotations;
using Amazon.Lambda.APIGatewayEvents;
using Microsoft.Extensions.Logging;
using {{project_class_name}}.Api.Interfaces;
using {{project_class_name}}.Api.Utils;

public class {{ r }}Functions(I{{ r }}Controller controller, ILogger<{{ r }}Functions> logger)
{
    private readonly I{{ r }}Controller _controller = controller;
    private readonly ILogger<{{ r }}Functions> _logger = logger;
{%- if uses_body %}

    private static Stream BodyStream(APIGatewayProxyRequest request) => new MemoryStream(Encoding.UTF8.GetBytes(request.Body ?? string.Empty));
{%- endif %}
{%- if "get_by_id" in resource.operations %}

    [LambdaFunction(ResourceName = "Get{{ r }}Function")]
    public async Task<APIGatewayProxyResponse> Get{{ r }}(APIGatewayProxyRequest request)
    {
        try
        {
            var id = request.PathParameters["id"];
            return ResponseHelper.Ok(await _controller.GetAsync(id));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Exception in {ClassName} -> {MethodName}.", nameof({{ r }}Functions), nameof(Get{{ r }}));
            return ErrorDetector.DetectError(ex);
        }
    }
{%- endif %}
{%- if "list" in resource.operations %}

    [LambdaFunction(ResourceName = "Get{{ r }}ListFunction")]
    public async Task<APIGatewayProxyResponse> Get{{ r }}List(APIGatewayProxyRequest request)
    {
        try
        {
            return ResponseHelper.Ok(await _controller.GetListAsync());
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Exception in {ClassName} -> {MethodName}.", nameof({{ r }}Functions), nameof(Get{{ r }}List));
            return ErrorDetector.DetectError(ex);
        }
    }
{%- endif %}
{%- if "create" in resource.operations %}

    [LambdaFunction(ResourceName = "Create{{ r }}Function")]
    public async Task<APIGatewayProxyResponse> Create{{ r }}(APIGatewayProxyRequest request)
    {
        try
        {
            return ResponseHelper.Created(await _controller.CreateAsync(BodyStream(request)));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Exception in {ClassName} -> {MethodName}.", nameof({{ r }}Functions), nameof(Create{{ r }}));
            return ErrorDetector.DetectError(ex);
        }
    }
{%- endif %}
{%- if "update" in resource.operations %}

    [LambdaFunction(ResourceName = "Update{{ r }}Function")]
    public async Task<APIGatewayProxyResponse> Update{{ r }}(APIGatewayProxyRequest request)
    {
        try
        {
            var id = request.PathParameters["id"];
            return ResponseHelper.Ok(await _controller.UpdateAsync(id, BodyStream(request)));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Exception in {ClassName} -> {MethodName}.", nameof({{ r }}Functions), nameof(Update{{ r }}));
            return ErrorDetector.DetectError(ex);
        }
    }
{%- endif %}
{%- if "replace" in resource.operations %}

    [LambdaFunction(ResourceName = "Replace{{ r }}Function")]
    public async Task<APIGatewayProxyResponse> Replace{{ r }}(APIGatewayProxyRequest request)
    {
        try
        {
            var id = request.PathParameters["id"];
            return ResponseHelper.Ok(await _controller.ReplaceAsync(id, BodyStream(request)));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Exception in {ClassName} -> {MethodName}.", nameof({{ r }}Functions), nameof(Replace{{ r }}));
            return ErrorDetector.DetectError(ex);
        }
    }
{%- endif %}
{%- if "delete" in resource.operations %}

    [LambdaFunction(ResourceName = "Delete{{ r }}Function")]
    public async Task<APIGatewayProxyResponse> Delete{{ r }}(APIGatewayProxyRequest request)
    {
        try
        {
            var id = request.PathParameters["id"];
            await _controller.DeleteAsync(id);
            return ResponseHelper.Ok(new DeleteOkObjectResult { Message = $"{{ r }} with id {id} was deleted successfully." });
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Exception in {ClassName} -> {MethodName}.", nameof({{ r }}Functions), nameof(Delete{{ r }}));
            return ErrorDetector.DetectError(ex);
        }
    }
{%- endif %}
}
