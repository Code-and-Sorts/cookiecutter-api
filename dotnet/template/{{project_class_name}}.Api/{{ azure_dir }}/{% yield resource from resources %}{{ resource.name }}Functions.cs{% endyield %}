{%- set r = resource.name -%}
namespace {{project_class_name}}.Api.Functions;

using System;
using System.Threading;
using System.Threading.Tasks;
{%- if "list" in resource.operations %}
using System.Web;
{%- endif %}
using Microsoft.AspNetCore.Mvc;
using Microsoft.Azure.Functions.Worker;
using Microsoft.Azure.Functions.Worker.Http;
using Microsoft.Extensions.Logging;
using {{project_class_name}}.Api.Interfaces;
using {{project_class_name}}.Api.Utils;

public class {{ r }}Functions(I{{ r }}Controller controller, ILogger<{{ r }}Functions> logger)
{
    private readonly I{{ r }}Controller _controller = controller;
    private readonly ILogger<{{ r }}Functions> _logger = logger;
{%- if "get_by_id" in resource.operations %}

    [Function("Get{{ r }}")]
    public async Task<IActionResult> Get{{ r }}(
        [HttpTrigger(AuthorizationLevel.Function, "get", Route = "{{ resource.endpoint }}/{id}")] HttpRequestData req, string id, CancellationToken ct = default)
    {
        try
        {
            return new OkObjectResult(await _controller.GetAsync(id, ct));
        }
        catch (Exception ex)
        {
            return ErrorDetector.DetectError(ex, _logger);
        }
    }
{%- endif %}
{%- if "list" in resource.operations %}

    [Function("Get{{ r }}List")]
    public async Task<IActionResult> Get{{ r }}List(
        [HttpTrigger(AuthorizationLevel.Function, "get", Route = "{{ resource.endpoint }}")] HttpRequestData req, CancellationToken ct = default)
    {
        try
        {
            var limit = HttpUtility.ParseQueryString(req.Url.Query)["limit"];
            return new OkObjectResult(await _controller.GetListAsync(limit, ct));
        }
        catch (Exception ex)
        {
            return ErrorDetector.DetectError(ex, _logger);
        }
    }
{%- endif %}
{%- if "create" in resource.operations %}

    [Function("Create{{ r }}")]
    public async Task<IActionResult> Create{{ r }}(
        [HttpTrigger(AuthorizationLevel.Function, "post", Route = "{{ resource.endpoint }}")] HttpRequestData req, CancellationToken ct = default)
    {
        try
        {
            var created = await _controller.CreateAsync(req.Body, ct);
            return new CreatedResult($"/api/{{ resource.endpoint }}", created);
        }
        catch (Exception ex)
        {
            return ErrorDetector.DetectError(ex, _logger);
        }
    }
{%- endif %}
{%- if "update" in resource.operations %}

    [Function("Update{{ r }}")]
    public async Task<IActionResult> Update{{ r }}(
        [HttpTrigger(AuthorizationLevel.Function, "patch", Route = "{{ resource.endpoint }}/{id}")] HttpRequestData req, string id, CancellationToken ct = default)
    {
        try
        {
            return new OkObjectResult(await _controller.UpdateAsync(id, req.Body, ct));
        }
        catch (Exception ex)
        {
            return ErrorDetector.DetectError(ex, _logger);
        }
    }
{%- endif %}
{%- if "replace" in resource.operations %}

    [Function("Replace{{ r }}")]
    public async Task<IActionResult> Replace{{ r }}(
        [HttpTrigger(AuthorizationLevel.Function, "put", Route = "{{ resource.endpoint }}/{id}")] HttpRequestData req, string id, CancellationToken ct = default)
    {
        try
        {
            return new OkObjectResult(await _controller.ReplaceAsync(id, req.Body, ct));
        }
        catch (Exception ex)
        {
            return ErrorDetector.DetectError(ex, _logger);
        }
    }
{%- endif %}
{%- if "delete" in resource.operations %}

    [Function("Delete{{ r }}")]
    public async Task<IActionResult> Delete{{ r }}(
        [HttpTrigger(AuthorizationLevel.Function, "delete", Route = "{{ resource.endpoint }}/{id}")] HttpRequestData req, string id, CancellationToken ct = default)
    {
        try
        {
            await _controller.DeleteAsync(id, ct);
            return new OkObjectResult(new DeleteOkObjectResult { Message = $"{{ r }} with id {id} was deleted successfully." });
        }
        catch (Exception ex)
        {
            return ErrorDetector.DetectError(ex, _logger);
        }
    }
{%- endif %}
}
