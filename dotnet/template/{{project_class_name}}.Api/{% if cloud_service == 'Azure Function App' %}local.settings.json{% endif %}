{
    "IsEncrypted": false,
    "Values": {
        "AzureWebJobsStorage": "UseDevelopmentStorage=true",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "CosmosDbDatabaseName": "{{ '{{CosmosDbDatabaseName}}' }}"{% for container in resources | map(attribute='container') | unique %},
        "CosmosDbContainerName_{{ container | to_camel }}": "{{ container }}"{% endfor %}
    },
    "ConnectionStrings": {
        "CosmosDb": "{{ '{{CosmosDbConnectionString}}' }}"
    }
}
