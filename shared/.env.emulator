# Committed, so it holds only public emulator values.
{%- if cloud_service == 'Azure Function App' %}
{%- set cosmos_key = 'C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==' %}
{%- set cosmos_endpoint = 'http://' ~ (cosmos_host | default('localhost')) ~ ':8081/' %}
{%- if language == 'python' %}
Cosmos_Db_Uri={{ cosmos_endpoint }}
Cosmos_Db_Key={{ cosmos_key }}
Cosmos_Db_Database_Name={{ project_endpoint }}
Cosmos_Db_Emulator=true
{%- elif language == 'typescript' %}
COSMOS_DB_URL={{ cosmos_endpoint }}
COSMOS_DB_KEY={{ cosmos_key }}
COSMOS_DB_EMULATOR=true
{%- elif language == 'go' %}
CosmosDbEndpoint={{ cosmos_endpoint }}
CosmosDbKey={{ cosmos_key }}
CosmosDbDatabaseName={{ project_endpoint }}
CosmosDbEmulator=true
{%- else %}
ConnectionStrings__CosmosDb="AccountEndpoint={{ cosmos_endpoint }};AccountKey={{ cosmos_key }};"
CosmosDbDatabaseName={{ project_endpoint }}
CosmosDbEmulator=true
{%- endif %}
{%- elif cloud_service == 'GCP Cloud Function' %}
FIRESTORE_EMULATOR_HOST=localhost:8085
GCP_PROJECT_ID=demo-{{ project_endpoint }}
{%- else %}
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=emulator
AWS_SECRET_ACCESS_KEY=emulator
{%- endif %}
