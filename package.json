    "@types/node": "^24.13.6",
    "@types/aws-lambda": "^8.10.163",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.13",
    "tsc-alias": "^1.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
