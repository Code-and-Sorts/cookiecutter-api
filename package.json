{
  "name": "kitties",
  "version": "1.0.0",
  "description": "Kitties got claws...beware",
  "packageManager": "yarn@4.18.1",
  "main": "dist/lambda.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
