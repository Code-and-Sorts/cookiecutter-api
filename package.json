{
  "name": "kitties",
  "version": "1.0.0",
  "description": "Kitties got claws...beware",
  "packageManager": "yarn@4.18.1",
  "main": "dist/functions/*.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && tsc-alias",
    "start": "func start --typescript",
    "test:unit": "yarn jest --verbose --coverage",
    "lint": "eslint .",
    "format": "eslint --fix . && prettier --write .",
    "audit": "yarn npm audit --severity moderate"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.16.5",
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "azure-functions-core-tools": "^4.15.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.13",
    "tsc-alias": "^1.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "author": "Sir Meowsalots",
  "license": "ISC"
}
