{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
        "labels": {
            "default": [],
            "items": {
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        },
        "name": {
            "minLength": 1,
            "type": "string"
        },
        "priority": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": [
                "integer",
                "null"
            ]
        },
        "rank": {
            "type": "number"
        },
        "tenantId": {
            "default": "public",
            "description": "Owning tenant",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
        }
    },
    "required": [
        "rank",
        "name"
    ],
    "type": "object"
}
