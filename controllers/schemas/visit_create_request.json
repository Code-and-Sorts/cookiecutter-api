{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
        "cost": {
            "minimum": 0,
            "type": "number"
        },
        "labels": {
            "default": [],
            "items": {
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        },
        "priority": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": [
                "integer",
                "null"
            ]
        },
        "rank": {
            "type": "number"
        },
        "reason": {
            "type": "string"
        },
        "region": {
            "default": "eu",
            "enum": [
                "eu",
                "us"
            ],
            "type": "string"
        },
        "tenantId": {
            "default": "public",
            "description": "Owning tenant",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
        },
        "visitedOn": {
            "format": "date",
            "pattern": "^(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
            "type": "string"
        }
    },
    "required": [
        "rank",
        "reason",
        "visitedOn"
    ],
    "type": "object"
}
