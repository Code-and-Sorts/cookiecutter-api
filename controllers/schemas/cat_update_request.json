{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
        "adoptedAt": {
            "format": "date-time",
            "pattern": "^(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
            "type": [
                "string",
                "null"
            ]
        },
        "ageYears": {
            "default": 0,
            "maximum": 40,
            "minimum": 0,
            "type": "integer"
        },
        "indoor": {
            "default": true,
            "type": "boolean"
        },
        "labels": {
            "default": [],
            "items": {
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        },
        "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
        },
        "notes": {
            "default": "$none",
            "type": "string"
        },
        "ownerEmail": {
            "allOf": [
                {
                    "pattern": "^[^@ \\t\\n]+@[^@ \\t\\n]+\\.[^@ \\t\\n]+$"
                }
            ],
            "default": "unknown@example.com",
            "type": "string"
        },
        "priority": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": [
                "integer",
                "null"
            ]
        },
        "rank": {
            "type": "number"
        },
        "tags": {
            "default": [],
            "items": {
                "type": "string"
            },
            "maxItems": 3,
            "type": "array",
            "uniqueItems": true
        },
        "tenantId": {
            "default": "public",
            "description": "Owning tenant",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
        },
        "website": {
            "allOf": [
                {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^ \\t\\n]+$"
                }
            ],
            "type": [
                "string",
                "null"
            ]
        },
        "weightKg": {
            "exclusiveMaximum": 100,
            "exclusiveMinimum": 0,
            "type": [
                "number",
                "null"
            ]
        }
    },
    "type": "object"
}
