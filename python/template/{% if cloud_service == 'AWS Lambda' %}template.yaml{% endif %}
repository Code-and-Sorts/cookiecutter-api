{%- set containers = path_resources | unique(attribute='container') | list -%}
AWSTemplateFormatVersion: '2010-09-09'
Transform: AWS::Serverless-2016-10-31
Description: {{ project_description }}
Metadata:
  cfn-lint:
    config:
      # SAM's generated usage plan resources carry a redundant DependsOn.
      ignore_checks:
        - W3005

Parameters:
  DynamoDbEndpoint:
    Type: String
    Default: ""
    Description: DynamoDB endpoint override for a local emulator; leave empty to use DynamoDB.

Conditions:
  HasDynamoDbEndpoint: !Not [!Equals [!Ref DynamoDbEndpoint, ""]]

Globals:
  Function:
    Timeout: 30
    Runtime: python3.14
    Environment:
      Variables:
        # sam local only sets variables the template declares; deployed stacks omit it.
        AWS_ENDPOINT_URL_DYNAMODB: !If [HasDynamoDbEndpoint, !Ref DynamoDbEndpoint, !Ref AWS::NoValue]
  Api:
    Auth:
      ApiKeyRequired: true
      UsagePlan:
        CreateUsagePlan: PER_API

Resources:
  {{ project_class_name }}Function:
    Type: AWS::Serverless::Function
    # SAM can't build from uv; the Makefile's build target packages uv.lock.
    Metadata:
      BuildMethod: makefile
    Properties:
      Handler: lambda_app.lambda_handler
      CodeUri: .
      Description: {{ project_description }}
      Architectures:
        - x86_64
      Environment:
        Variables:
{%- for c in containers %}
          DYNAMODB_TABLE_NAME_{{ c.env_key }}: !Ref {{ c.container_class }}Table
{%- endfor %}
      Policies:
{%- for c in containers %}
        - DynamoDBCrudPolicy:
            TableName: !Ref {{ c.container_class }}Table
{%- endfor %}
      Events:
{%- if health_endpoint %}
        Health:
          Type: Api
          Properties:
            Path: /{{ health_endpoint }}
            Method: get
            Auth:
              ApiKeyRequired: false
{%- endif %}
{%- for resource in resources %}
{%- set cn = resource.name | to_camel %}
{%- if "list" in resource.operations %}
        List{{ cn }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}
            Method: get
{%- endif %}
{%- if "get_by_id" in resource.operations %}
        Get{{ cn }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{id}
            Method: get
{%- endif %}
{%- if "create" in resource.operations %}
        Create{{ cn }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}
            Method: post
{%- endif %}
{%- if "update" in resource.operations %}
        Update{{ cn }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{id}
            Method: patch
{%- endif %}
{%- if "replace" in resource.operations %}
        Replace{{ cn }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{id}
            Method: put
{%- endif %}
{%- if "delete" in resource.operations %}
        Delete{{ cn }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{id}
            Method: delete
{%- endif %}
{%- endfor %}

{% for c in containers %}
  {{ c.container_class }}Table:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: {{ c.container }}
      AttributeDefinitions:
        - AttributeName: id
          AttributeType: S
      KeySchema:
        - AttributeName: id
          KeyType: HASH
      BillingMode: PAY_PER_REQUEST
{% endfor %}
Outputs:
  {{ project_class_name }}Api:
    Description: API Gateway endpoint base URL
    Value: !Sub "https://${ServerlessRestApi}.execute-api.${AWS::Region}.amazonaws.com/Prod/"
  {{ project_class_name }}ApiKeyId:
    Description: "API key id; read its value with: aws apigateway get-api-key --api-key <id> --include-value --query value --output text"
    Value: !Ref ServerlessRestApiApiKey
  {{ project_class_name }}Function:
    Description: Lambda Function ARN
    Value: !GetAtt {{ project_class_name }}Function.Arn
