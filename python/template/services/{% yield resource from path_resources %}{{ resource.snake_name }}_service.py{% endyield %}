{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- from '_macros.jinja' import model_names -%}
{%- set models = model_names(resource) -%}
{% if 'list' in ops -%}
from typing import List
{% endif -%}
from repositories import {{ r }}Repository
{%- if models %}
from models import {{ models }}
{%- endif %}


class {{ r }}Service:
    def __init__(self, repository: {{ r }}Repository):
        self.repository = repository
{%- if "get_by_id" in ops %}

    async def get_by_id(self, item_id: str) -> {{ r }}Response:
        return await self.repository.get_by_id(item_id)
{%- endif %}
{%- if "list" in ops %}

    async def get_list(self, limit: int) -> List[{{ r }}Response]:
        return await self.repository.get_list(limit)
{%- endif %}
{%- if "create" in ops %}

    async def create(self, item: Base{{ r }}, user_id: str | None = None) -> {{ r }}Response:
        return await self.repository.create(item, user_id)
{%- endif %}
{%- if "update" in ops %}

    async def update(self, item_id: str, changes: {{ r }}Update, user_id: str | None = None) -> {{ r }}Response:
        return await self.repository.update(item_id, changes, user_id)
{%- endif %}
{%- if "replace" in ops %}

    async def replace(self, item_id: str, item: Base{{ r }}, user_id: str | None = None) -> {{ r }}Response:
        return await self.repository.replace(item_id, item, user_id)
{%- endif %}
{%- if "delete" in ops %}

    async def soft_delete(self, item_id: str, user_id: str | None = None) -> None:
        await self.repository.delete(item_id, user_id)
{%- endif %}
