{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set models = [] -%}
{%- if ('create' in ops) or ('replace' in ops) %}{% set _ = models.append('Base' ~ r) %}{% endif -%}
{%- if 'update' in ops %}{% set _ = models.append(r ~ 'Update') %}{% endif -%}
{%- if ops | reject('equalto', 'delete') | list %}{% set _ = models.append(r ~ 'Response') %}{% endif -%}
{% if 'list' in ops -%}
from typing import List
{% endif -%}
from repositories import {% if 'list' in ops %}DEFAULT_LIST_LIMIT, {% endif %}{{ r }}Repository
{%- if models %}
from models import {{ models | join(', ') }}
{%- endif %}


class {{ r }}Service:
    def __init__(self, repository: {{ r }}Repository):
        self.repository = repository
{%- if "get_by_id" in ops %}

    async def get_by_id(self, item_id: str) -> {{ r }}Response:
        return await self.repository.get_by_id(item_id)
{%- endif %}
{%- if "list" in ops %}

    async def get_list(self, limit: int = DEFAULT_LIST_LIMIT) -> List[{{ r }}Response]:
        return await self.repository.get_list(limit)
{%- endif %}
{%- if "create" in ops %}

    async def create(self, item: Base{{ r }}) -> {{ r }}Response:
        return await self.repository.create(item)
{%- endif %}
{%- if "update" in ops %}

    async def update(self, item_id: str, changes: {{ r }}Update) -> {{ r }}Response:
        return await self.repository.update(item_id, changes)
{%- endif %}
{%- if "replace" in ops %}

    async def replace(self, item_id: str, item: Base{{ r }}) -> {{ r }}Response:
        return await self.repository.replace(item_id, item)
{%- endif %}
{%- if "delete" in ops %}

    async def soft_delete(self, item_id: str) -> None:
        await self.repository.delete(item_id)
{%- endif %}
