{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set returns_item = ('get_by_id' in ops) or ('list' in ops) or ('create' in ops) or ('update' in ops) or ('replace' in ops) -%}
{%- set uses_body = ('create' in ops) or ('update' in ops) or ('replace' in ops) -%}
{% if 'list' in ops -%}
from typing import List
{% endif -%}
from repositories import {% if 'list' in ops %}DEFAULT_LIST_LIMIT, {% endif %}{{ r }}Repository
{%- if returns_item %}
from models import {% if uses_body %}{{ r }}, {% endif %}{{ r }}Response
{%- endif %}


class {{ r }}Service:
    def __init__(self, repository: {{ r }}Repository):
        self.repository = repository
{%- if "get_by_id" in ops %}

    async def get_by_id(self, item_id: str) -> {{ r }}Response:
        return await self.repository.get_by_id(item_id)
{%- endif %}
{%- if "list" in ops %}

    async def get_list(self, limit: int = DEFAULT_LIST_LIMIT) -> List[{{ r }}Response]:
        return await self.repository.get_list(limit)
{%- endif %}
{%- if "create" in ops %}

    async def create(self, item: {{ r }}) -> {{ r }}Response:
        return await self.repository.create(item)
{%- endif %}
{%- if "update" in ops %}

    async def update(self, item: {{ r }}) -> {{ r }}Response:
        return await self.repository.update(item)
{%- endif %}
{%- if "replace" in ops %}

    async def replace(self, item: {{ r }}) -> {{ r }}Response:
        return await self.repository.replace(item)
{%- endif %}
{%- if "delete" in ops %}

    async def soft_delete(self, item_id: str):
        await self.repository.delete(item_id)
{%- endif %}
