{%- set r = resource.name -%}
{%- set slug = r | to_snake -%}
{%- set ops = resource.operations -%}
{%- set models = [] -%}
{%- if ('create' in ops) or ('replace' in ops) %}{% set _ = models.append('Base' ~ r) %}{% endif -%}
{%- if 'update' in ops %}{% set _ = models.append(r ~ 'Update') %}{% endif -%}
{%- if ops | reject('equalto', 'delete') | list %}{% set _ = models.append(r ~ 'Response') %}{% endif -%}
import asyncio
import pytest
from unittest.mock import AsyncMock
{%- if models %}
from models import {{ models | join(', ') }}
{%- endif %}
from services import {{ r }}Service
from repositories import {{ r }}Repository

_ID = "ac1df01c-7ece-4a20-ab60-179829dad8f5"
{%- if models %}
_responses = [
    {{ r }}Response(id=_ID, name="mockName1"),
    {{ r }}Response(id="de6cbc87-5969-458c-8444-3512a82250bc", name="mockName2"),
]
{%- endif %}


def describe_{{ slug }}_service():
    @pytest.fixture
    def mock_repository():
        mock = AsyncMock({{ r }}Repository)
{%- for op in ["get_by_id", "create", "update", "replace"] if op in ops %}
        mock.{{ op }}.return_value = _responses[0]
{%- endfor %}
{%- if "list" in ops %}
        mock.get_list.return_value = _responses
{%- endif %}
        return mock

    @pytest.fixture
    def service(mock_repository):
        return {{ r }}Service(repository=mock_repository)
{%- if "get_by_id" in ops %}

    def describe_get_by_id():
        def test_calls_repository(service, mock_repository):
            assert asyncio.run(service.get_by_id(_ID)) == _responses[0]
            mock_repository.get_by_id.assert_awaited_once_with(_ID)
{%- endif %}
{%- if "list" in ops %}

    def describe_get_list():
        def test_calls_repository(service, mock_repository):
            assert asyncio.run(service.get_list()) == _responses
            mock_repository.get_list.assert_awaited_once()

        def test_passes_limit_through(service, mock_repository):
            asyncio.run(service.get_list(limit=25))
            mock_repository.get_list.assert_awaited_once_with(25)
{%- endif %}
{%- if "create" in ops %}

    def describe_create():
        def test_calls_repository(service, mock_repository):
            item = Base{{ r }}(name="mockName1")
            assert asyncio.run(service.create(item)) == _responses[0]
            mock_repository.create.assert_awaited_once_with(item)
{%- endif %}
{%- if "update" in ops %}

    def describe_update():
        def test_calls_repository(service, mock_repository):
            changes = {{ r }}Update(name="mockName1")
            assert asyncio.run(service.update(_ID, changes)) == _responses[0]
            mock_repository.update.assert_awaited_once_with(_ID, changes)
{%- endif %}
{%- if "replace" in ops %}

    def describe_replace():
        def test_calls_repository(service, mock_repository):
            item = Base{{ r }}(name="mockName1")
            assert asyncio.run(service.replace(_ID, item)) == _responses[0]
            mock_repository.replace.assert_awaited_once_with(_ID, item)
{%- endif %}
{%- if "delete" in ops %}

    def describe_soft_delete():
        def test_calls_repository(service, mock_repository):
            asyncio.run(service.soft_delete(_ID))
            mock_repository.delete.assert_awaited_once_with(_ID)
{%- endif %}
