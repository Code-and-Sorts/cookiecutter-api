{%- set r = resource.name -%}
{%- set slug = r | to_snake -%}
{%- set ops = resource.operations -%}
{%- set labels = {'list': 'List', 'get_by_id': 'Get', 'create': 'Create', 'update': 'Update', 'replace': 'Replace', 'delete': 'Delete'} -%}
{%- if cloud_service == 'Azure Function App' -%}
"""{{ r }} functions: /api/{{ resource.endpoint }} (function_app.py registers ``bp``)."""
import logging
import azure.functions as func
from controllers import {{ r }}Controller
from services import {{ r }}Service
from repositories import {{ r }}Repository
from .database import handle

CONTAINER = "{{ resource.container }}"

bp = func.Blueprint()


def _build_controller(container_client) -> {{ r }}Controller:
    return {{ r }}Controller({{ r }}Service({{ r }}Repository(container_client)))
{%- if "list" in ops %}


@bp.route(route="{{ resource.endpoint }}", methods=[func.HttpMethod.GET])
async def get_list_{{ slug }}(req: func.HttpRequest) -> func.HttpResponse:
    logging.info("List {{ resource.endpoint }} processed a request.")
    return await handle(CONTAINER, _build_controller, lambda c: c.get_list(req.params.get("limit")))
{%- endif %}
{%- if "get_by_id" in ops %}


@bp.route(route="{{ resource.endpoint }}/{id}", methods=[func.HttpMethod.GET])
async def get_by_id_{{ slug }}(req: func.HttpRequest) -> func.HttpResponse:
    logging.info("Get {{ resource.endpoint }} by ID processed a request.")
    return await handle(CONTAINER, _build_controller, lambda c: c.get_by_id(req.route_params.get("id")))
{%- endif %}
{%- if "create" in ops %}


@bp.route(route="{{ resource.endpoint }}", methods=[func.HttpMethod.POST])
async def create_{{ slug }}(req: func.HttpRequest) -> func.HttpResponse:
    logging.info("Create {{ resource.endpoint }} processed a request.")
    return await handle(CONTAINER, _build_controller, lambda c: c.create(req.get_body()), 201)
{%- endif %}
{%- if "update" in ops %}


@bp.route(route="{{ resource.endpoint }}/{id}", methods=[func.HttpMethod.PATCH])
async def update_{{ slug }}(req: func.HttpRequest) -> func.HttpResponse:
    logging.info("Patch {{ resource.endpoint }} processed a request.")
    return await handle(CONTAINER, _build_controller, lambda c: c.update(req.route_params.get("id"), req.get_body()))
{%- endif %}
{%- if "replace" in ops %}


@bp.route(route="{{ resource.endpoint }}/{id}", methods=[func.HttpMethod.PUT])
async def replace_{{ slug }}(req: func.HttpRequest) -> func.HttpResponse:
    logging.info("Replace {{ resource.endpoint }} processed a request.")
    return await handle(CONTAINER, _build_controller, lambda c: c.replace(req.route_params.get("id"), req.get_body()))
{%- endif %}
{%- if "delete" in ops %}


@bp.route(route="{{ resource.endpoint }}/{id}", methods=[func.HttpMethod.DELETE])
async def delete_{{ slug }}(req: func.HttpRequest) -> func.HttpResponse:
    logging.info("Delete {{ resource.endpoint }} processed a request.")
    return await handle(CONTAINER, _build_controller, lambda c: c.delete(req.route_params.get("id")))
{%- endif %}
{%- endif %}
