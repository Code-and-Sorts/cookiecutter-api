{%- from '_macros.jinja' import routes -%}
{%- set r = resource.name -%}
{%- set slug = r | to_snake -%}
{%- set ops = resource.operations -%}
{%- set labels = {'list': 'List', 'get_by_id': 'Get', 'create': 'Create', 'update': 'Patch', 'replace': 'Replace', 'delete': 'Delete'} -%}
{%- set request = {
    'Azure Function App': {'id': 'req.route_params.get("id")', 'limit': 'req.params.get("limit")', 'body': 'req.get_body()'},
    'GCP Cloud Function': {'id': 'item_id', 'limit': 'request.args.get("limit")', 'body': 'request.get_data()'},
    'AWS Lambda': {'id': 'item_id', 'limit': '(event.get("queryStringParameters") or {}).get("limit")', 'body': 'event_body(event)'},
}[cloud_service] -%}
{%- macro call(op, fn, with_id) -%}
{%- set args = ([request.id] if with_id else []) + ([request.limit] if op == 'list' else []) + ([request.body] if op in ['create', 'update', 'replace'] else []) -%}
{{ fn }}({{ args | join(', ') }})
{%- endmacro -%}
{%- if cloud_service == 'Azure Function App' -%}
import logging
import azure.functions as func
from controllers import {{ r }}Controller
from services import {{ r }}Service
from repositories import {{ r }}Repository
from .database import handle

CONTAINER = "{{ resource.container }}"

bp = func.Blueprint()


def _build_controller(container_client) -> {{ r }}Controller:
    return {{ r }}Controller({{ r }}Service({{ r }}Repository(container_client)))
{%- for op, fn, method, with_id, status in routes if op in ops %}


@bp.route(route="{{ resource.endpoint }}{% if with_id %}/{id}{% endif %}", methods=[func.HttpMethod.{{ method }}])
async def {{ fn }}_{{ slug }}(req: func.HttpRequest) -> func.HttpResponse:
    logging.info("{{ labels[op] }} {{ resource.endpoint }}{% if op == 'get_by_id' %} by ID{% endif %} processed a request.")
    return await handle(CONTAINER, _build_controller, lambda c: c.{{ call(op, fn, with_id) }}{% if status != 200 %}, {{ status }}{% endif %})
{%- endfor %}
{%- endif %}
{%- if cloud_service == 'GCP Cloud Function' -%}
from flask import Request
from controllers import {{ r }}Controller
from services import {{ r }}Service
from repositories import {{ r }}Repository
from .database import run

ENDPOINT = "{{ resource.endpoint }}"
CONTAINER = "{{ resource.container }}"


def _build_controller(collection) -> {{ r }}Controller:
    return {{ r }}Controller({{ r }}Service({{ r }}Repository(collection)))
{%- endif %}
{%- if cloud_service == 'AWS Lambda' -%}
from functools import cache
from config import get_settings
from controllers import {{ r }}Controller
from services import {{ r }}Service
from repositories import {{ r }}Repository
{%- if ('create' in ops) or ('update' in ops) or ('replace' in ops) %}
from utils.routing import event_body
{%- endif %}
from .database import run, session

ENDPOINT = "{{ resource.endpoint }}"
CONTAINER = "{{ resource.container }}"


@cache
def _controller() -> {{ r }}Controller:
    settings = get_settings()
    repository = {{ r }}Repository(session, settings.tables[CONTAINER], settings.aws_region)
    return {{ r }}Controller({{ r }}Service(repository))
{%- endif %}
{%- if cloud_service != 'Azure Function App' %}
{%- for op, fn, method, with_id, status in routes if op in ops %}


def {{ fn }}({% if cloud_service == 'GCP Cloud Function' %}request: Request{% else %}event: dict{% endif %}, item_id: str | None) -> tuple[int, object]:
    return {{ status }}, {% if cloud_service == 'GCP Cloud Function' %}run(CONTAINER, _build_controller, lambda c: c.{{ call(op, fn, with_id) }}){% else %}run(_controller().{{ call(op, fn, with_id) }}){% endif %}
{%- endfor %}


# (HTTP method, path has an item id) -> handler
ROUTES = {
{%- for op, fn, method, with_id, status in routes if op in ops %}
    ("{{ method }}", {{ with_id }}): {{ fn }},
{%- endfor %}
}
{%- endif %}
