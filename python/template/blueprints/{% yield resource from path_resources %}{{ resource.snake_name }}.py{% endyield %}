"""{{ r }} routes: main.py's ``api`` function sends /{{ resource.endpoint }} requests here.

Each handler takes the Flask request and the path's item id, and returns the
status code and payload; main.py turns them into a JSON response.
"""
from flask import Request
from controllers import {{ r }}Controller
from services import {{ r }}Service
from repositories import {{ r }}Repository
from .database import run

ENDPOINT = "{{ resource.endpoint }}"
CONTAINER = "{{ resource.container }}"


def _build_controller(collection) -> {{ r }}Controller:
    return {{ r }}Controller({{ r }}Service({{ r }}Repository(collection)))
{%- endif %}
{%- if cloud_service == 'AWS Lambda' -%}
"""{{ r }} routes: lambda_app.py sends /{{ resource.endpoint }} events here.

Each handler takes the API Gateway event and the path's item id, and returns
the status code and payload; lambda_app.py turns them into a JSON response.
"""
import asyncio
from functools import cache
from config import get_settings
from controllers import {{ r }}Controller
from services import {{ r }}Service
from repositories import {{ r }}Repository
{%- if ('create' in ops) or ('update' in ops) or ('replace' in ops) %}
from utils.routing import event_body
{%- endif %}
from .database import session

ENDPOINT = "{{ resource.endpoint }}"
CONTAINER = "{{ resource.container }}"


@cache
def _controller() -> {{ r }}Controller:
    settings = get_settings()
    repository = {{ r }}Repository(session, settings.tables[CONTAINER], settings.aws_region)
    return {{ r }}Controller({{ r }}Service(repository))
{%- endif %}
{%- if cloud_service != 'Azure Function App' %}
{%- set req = 'request: Request' if cloud_service == 'GCP Cloud Function' else 'event: dict' %}
{%- if cloud_service == 'GCP Cloud Function' %}
{%- set call = {
    'list': 'run(CONTAINER, _build_controller, lambda c: c.get_list(request.args.get("limit")))',
    'get_by_id': 'run(CONTAINER, _build_controller, lambda c: c.get_by_id(item_id))',
    'create': 'run(CONTAINER, _build_controller, lambda c: c.create(request.get_data()))',
    'update': 'run(CONTAINER, _build_controller, lambda c: c.update(item_id, request.get_data()))',
    'replace': 'run(CONTAINER, _build_controller, lambda c: c.replace(item_id, request.get_data()))',
    'delete': 'run(CONTAINER, _build_controller, lambda c: c.delete(item_id))',
} %}
{%- else %}
{%- set call = {
    'list': 'asyncio.run(_controller().get_list((event.get("queryStringParameters") or {}).get("limit")))',
    'get_by_id': 'asyncio.run(_controller().get_by_id(item_id))',
    'create': 'asyncio.run(_controller().create(event_body(event)))',
    'update': 'asyncio.run(_controller().update(item_id, event_body(event)))',
    'replace': 'asyncio.run(_controller().replace(item_id, event_body(event)))',
    'delete': 'asyncio.run(_controller().delete(item_id))',
} %}
{%- endif %}
{%- set routes = [('list', 'get_list', 'GET', False, 200), ('get_by_id', 'get_by_id', 'GET', True, 200), ('create', 'create', 'POST', False, 201), ('update', 'update', 'PATCH', True, 200), ('replace', 'replace', 'PUT', True, 200), ('delete', 'delete', 'DELETE', True, 200)] %}
{%- for op, fn, method, with_id, status in routes if op in ops %}


def {{ fn }}({{ req }}, item_id: str | None) -> tuple[int, object]:
    """{{ method }} /{{ resource.endpoint }}{% if with_id %}/{id}{% endif %}"""
    return {{ status }}, {{ call[op] }}
{%- endfor %}


# (HTTP method, path has an item id) -> handler
ROUTES = {
{%- for op, fn, method, with_id, status in routes if op in ops %}
    ("{{ method }}", {{ with_id }}): {{ fn }},
{%- endfor %}
}
{%- endif %}
