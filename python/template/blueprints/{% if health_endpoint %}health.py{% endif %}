"""Liveness probe served at the ``{{ health_endpoint }}`` URL segment."""
{%- if cloud_service == 'Azure Function App' %}
import azure.functions as func
{%- endif %}
{%- if cloud_service == 'GCP Cloud Function' %}
from flask import Request
{%- endif %}

# URL segment the health check is served at (the health_endpoint answer).
ENDPOINT = "{{ health_endpoint }}"
BODY = '{"status": "ok"}'
{%- if cloud_service == 'Azure Function App' %}

bp = func.Blueprint()


@bp.route(route=ENDPOINT, methods=[func.HttpMethod.GET])
async def health(req: func.HttpRequest) -> func.HttpResponse:
    """HTTP Function App liveness probe."""
    return func.HttpResponse(
        body=BODY,
        status_code=200,
        mimetype="application/json"
    )
{%- endif %}
{%- if cloud_service == 'GCP Cloud Function' %}


def health(request: Request):
    """HTTP Cloud Function liveness probe. Deploy it as a function named
    ENDPOINT so it is served at /{{ health_endpoint }}."""
    return (BODY, 200, {'Content-Type': 'application/json'})
{%- endif %}
{%- if cloud_service == 'AWS Lambda' %}


def health(event):
    """Lambda handler liveness probe."""
    return {
        "statusCode": 200,
        "headers": {"Content-Type": "application/json"},
        "body": BODY
    }
{%- endif %}
