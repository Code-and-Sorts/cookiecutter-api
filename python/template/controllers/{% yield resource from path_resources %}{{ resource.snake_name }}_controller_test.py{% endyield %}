{%- set r = resource.name -%}
{%- set slug = r | to_snake -%}
{%- set ops = resource.operations -%}
{%- from 'python/_macros.jinja' import model_names -%}
{%- from 'python/_model.jinja' import expect, literal, sample_dict -%}
{%- set models = model_names(resource) -%}
{%- set client = resource.client_fields -%}
{%- set body_ops = ops | select("in", ["create", "update", "replace"]) | list -%}
import asyncio
import pytest
from unittest.mock import AsyncMock
from errors import NotFoundError{% if body_ops %}, ValidationError{% endif %}
{%- if models %}
from models import {{ models }}
{%- endif %}
from controllers import {{ r }}Controller
from services import {{ r }}Service
{%- if 'list' in ops %}
from controllers.pagination import DEFAULT_LIST_LIMIT
{%- endif %}
from conftest import ITEM_ID{% if body_ops %}, encode, invalid_bodies{% endif %}
{%- if models %}

_response = {{ r }}Response(id=ITEM_ID, **{{ sample_dict(client | rejectattr("hidden")) }})
{%- endif %}
{%- if body_ops %}
# Per accepted field: a wrongly typed value, null unless nullable, and values just outside each rule.
_REJECTED = {
{%- for f in client %}
    "{{ f.name }}": {{ literal(f.rejected) }},
{%- endfor %}
}
_BOUNDARY_VALUES = [
{%- for f in client %}
{%- for v in f.boundaries %}
    ("{{ f.name }}", {{ literal(v) }}),
{%- endfor %}
{%- endfor %}
]
{%- endif %}
{%- for op in body_ops %}
{%- set accepted = client | selectattr("in_" ~ op) | list %}
{%- set refused = client | rejectattr("in_" ~ op) | list %}

_{{ op | upper }}_BODY = {{ sample_dict(accepted) }}
_{{ op | upper }}_INVALID = invalid_bodies(
    _{{ op | upper }}_BODY,
    {{ (accepted | selectattr("needs_value") | map(attribute="name") | list if op != "update" else []) | tojson }},
    {{ sample_dict(refused) }},
    _REJECTED,
)
_{{ op | upper }}_BOUNDARIES = [(name, value) for name, value in _BOUNDARY_VALUES if name in _{{ op | upper }}_BODY]
{%- endfor %}


def describe_{{ slug }}_controller():
    @pytest.fixture
    def mock_service():
        return AsyncMock({{ r }}Service)

    @pytest.fixture
    def controller(mock_service):
        return {{ r }}Controller(service=mock_service)
{%- if "get_by_id" in ops %}

    def describe_get_by_id():
        def test_returns_item(controller, mock_service):
            mock_service.get_by_id.return_value = _response

            assert asyncio.run(controller.get_by_id(ITEM_ID)) == _response
            mock_service.get_by_id.assert_awaited_once_with(ITEM_ID)

        def test_non_uuid_id_is_not_found(controller, mock_service):
            with pytest.raises(NotFoundError) as error:
                asyncio.run(controller.get_by_id("not-a-uuid"))

            assert str(error.value) == "{{ r }} with id not-a-uuid was not found."
            mock_service.get_by_id.assert_not_called()
{%- endif %}
{%- if "list" in ops %}

    def describe_get_list():
        def test_default_limit(controller, mock_service):
            mock_service.get_list.return_value = []

            assert asyncio.run(controller.get_list(None)) == []
            mock_service.get_list.assert_awaited_once_with(DEFAULT_LIST_LIMIT)

        def test_honours_limit_query_param(controller, mock_service):
            mock_service.get_list.return_value = [_response]

            assert asyncio.run(controller.get_list("5")) == [_response]
            mock_service.get_list.assert_awaited_once_with(5)

        def test_invalid_limit_falls_back_to_default(controller, mock_service):
            mock_service.get_list.return_value = []

            asyncio.run(controller.get_list("abc"))
            mock_service.get_list.assert_awaited_once_with(DEFAULT_LIST_LIMIT)
{%- endif %}
{%- for op in body_ops %}
{%- set accepted = client | selectattr("in_" ~ op) | list %}
{%- set kind = {"create": "Create", "replace": "Replace", "update": "Update"}[op] %}
{%- set call = "controller.create(" if op == "create" else "controller." ~ op ~ "(ITEM_ID, " %}
{%- set BODY = "_" ~ (op | upper) ~ "_BODY" %}

    def describe_{{ op }}():
        def test_passes_validated_body(controller, mock_service):
            mock_service.{{ op }}.return_value = _response

            assert asyncio.run({{ call }}encode({{ BODY }}), "user-1")) == _response
            sent = mock_service.{{ op }}.call_args.args[-2]
            assert isinstance(sent, {{ r }}{{ kind }}Request)
            assert sent.model_dump(exclude_unset=True) == {{ BODY }}
            assert mock_service.{{ op }}.call_args.args[-1] == "user-1"
{%- if op == "update" %}

        def test_empty_object_changes_nothing(controller, mock_service):
            mock_service.update.return_value = _response

            asyncio.run(controller.update(ITEM_ID, b'{}'))
            assert mock_service.update.call_args.args[1].model_dump(exclude_unset=True) == {}
{%- for f in accepted if f.nullable %}

        def test_null_clears_{{ f.name | to_snake }}(controller, mock_service):
            mock_service.update.return_value = _response

            asyncio.run(controller.update(ITEM_ID, b'{"{{ f.name }}": null}'))
            assert mock_service.update.call_args.args[1].model_dump(exclude_unset=True) == {"{{ f.name }}": None}
{%- endfor %}
{%- else %}
{%- set left_out = accepted | rejectattr("needs_value") | list %}
{%- if left_out %}

        def test_fields_left_out_get_their_defaults(controller, mock_service):
            mock_service.{{ op }}.return_value = _response
            minimal = {{ sample_dict(accepted | selectattr("needs_value")) }}

            asyncio.run({{ call }}encode(minimal)))
            sent = mock_service.{{ op }}.call_args.args[-2].model_dump()
{%- for f in left_out %}
{%- if f.dynamic %}
            assert sent["{{ f.name }}"] is not None
{%- else %}
            assert {{ expect('sent["' ~ f.name ~ '"]', f.default) }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endif %}

        @pytest.mark.parametrize("body", _{{ op | upper }}_INVALID)
        def test_invalid_body_is_rejected(controller, mock_service, body):
            with pytest.raises(ValidationError):
                asyncio.run({{ call }}body))
            mock_service.{{ op }}.assert_not_called()
{%- if accepted | selectattr("boundaries") | list %}

        @pytest.mark.parametrize("name, value", _{{ op | upper }}_BOUNDARIES)
        def test_values_on_a_rule_bound_are_accepted(controller, mock_service, name, value):
            mock_service.{{ op }}.return_value = _response

            asyncio.run({{ call }}encode({**{{ BODY }}, name: value})))
            assert getattr(mock_service.{{ op }}.call_args.args[-2], name) == value
{%- endif %}
{%- if op != "create" %}

        def test_non_uuid_id_is_not_found(controller, mock_service):
            with pytest.raises(NotFoundError):
                asyncio.run(controller.{{ op }}("not-a-uuid", encode({{ BODY }})))
            mock_service.{{ op }}.assert_not_called()
{%- endif %}
{%- endfor %}
{%- if "delete" in ops %}

    def describe_delete():
        def test_returns_confirmation_message(controller, mock_service):
            result = asyncio.run(controller.delete(ITEM_ID, "user-1"))

            assert result == {"message": f"{{ r }} with id {ITEM_ID} was deleted successfully."}
            mock_service.soft_delete.assert_awaited_once_with(ITEM_ID, "user-1")

        def test_non_uuid_id_is_not_found(controller, mock_service):
            with pytest.raises(NotFoundError):
                asyncio.run(controller.delete("not-a-uuid"))
            mock_service.soft_delete.assert_not_called()
{%- endif %}
