{% if cloud_service == 'Azure Function App' -%}
{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsFeatureFlags": "EnableWorkerIndexing",
    "AzureWebJobsStorage": "",
    "Cosmos_Db_Uri": "{{ '{{Cosmos_Db_Uri}}' }}",
    "Cosmos_Db_Key": "{{ '{{Cosmos_Db_Key}}' }}",
    "Cosmos_Db_Database_Name": "{{ '{{Cosmos_Db_Database_Name}}' }}"{% for c in path_resources | unique(attribute='container') %},
    "Container_Name_{{ c.container_key }}": "{{ c.container }}"{% endfor %}
  }
}
{%- endif %}
