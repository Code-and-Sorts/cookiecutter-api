{% if cloud_service == 'Azure Function App' -%}
{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsFeatureFlags": "EnableWorkerIndexing",
    "AzureWebJobsStorage": "",
    "Cosmos_Db_Uri": "{{ '{{Cosmos_Db_Uri}}' }}",
    "Cosmos_Db_Key": "{{ '{{Cosmos_Db_Key}}' }}",
    "Cosmos_Db_Database_Name": "{{ '{{Cosmos_Db_Database_Name}}' }}"{% for container in resources | map(attribute='container') | unique %},
    "Container_Name_{{ container | replace('-', '_') }}": "{{ container }}"{% endfor %}
  }
}
{%- endif %}
