"""Unit tests for blueprints/health.py.

The module is loaded straight from its file so the test does not import the
blueprints package, whose resource modules need database settings.
"""
import importlib.util
import json
from pathlib import Path
{%- if cloud_service == 'Azure Function App' %}
import asyncio

import azure.functions as func
{%- endif %}

_spec = importlib.util.spec_from_file_location(
    "health", Path(__file__).parent / "blueprints" / "health.py"
)
health = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(health)


def describe_health():
    def test_endpoint_is_configured_segment():
        assert health.ENDPOINT == "{{ health_endpoint }}"
{%- if cloud_service == 'Azure Function App' %}

    def test_route_uses_endpoint():
        functions = health.bp._function_builders
        assert len(functions) == 1
        fn = functions[0]._function
        trigger = fn.get_trigger()
        assert trigger.route == "{{ health_endpoint }}"
        assert [str(m) for m in trigger.methods] == ["GET"]

    def test_returns_ok():
        fn = health.bp._function_builders[0]._function.get_user_function()
        req = func.HttpRequest(method="GET", url="/api/{{ health_endpoint }}", body=b"")
        response = asyncio.run(fn(req))
        assert response.status_code == 200
        assert response.mimetype == "application/json"
        assert json.loads(response.get_body()) == {"status": "ok"}
{%- endif %}
{%- if cloud_service == 'GCP Cloud Function' %}

    def test_returns_ok():
        body, status, headers = health.health(None)
        assert status == 200
        assert headers == {"Content-Type": "application/json"}
        assert json.loads(body) == {"status": "ok"}
{%- endif %}
{%- if cloud_service == 'AWS Lambda' %}

    def test_returns_ok():
        response = health.health({"httpMethod": "GET", "resource": "/{{ health_endpoint }}"})
        assert response["statusCode"] == 200
        assert response["headers"] == {"Content-Type": "application/json"}
        assert json.loads(response["body"]) == {"status": "ok"}
{%- endif %}
