"""Unit tests for the ``api`` function in main.py: routing, status codes and
JSON responses. The database is replaced by mock controllers."""
import asyncio
import json
import logging
from unittest.mock import AsyncMock, MagicMock, patch
import flask
import pytest
import main
import blueprints
from blueprints import database
from controllers import ({% for resource in resources %}{{ resource.name }}Controller{% if not loop.last %}, {% endif %}{% endfor %})

_ID = "ac1df01c-7ece-4a20-ab60-179829dad8f5"
_BODY = b'{"name": "mockName"}'
_ITEM = {"id": _ID, "name": "mockName"}
_app = flask.Flask(__name__)


def _call(method, path, data=None):
    with _app.test_request_context(path, method=method, data=data):
        body, status, headers = main.api(flask.request)
    return status, headers["Content-Type"], json.loads(body)


def _run_with(controller):
    """Stand-in for database.run that runs the operation against ``controller``."""
    return lambda container_id, build_controller, operation: asyncio.run(operation(controller))


def _run_offline(container_id, build_controller, operation):
    """Stand-in for database.run that uses the real controller over a mock collection."""
    return asyncio.run(operation(build_controller(MagicMock())))


# (module, HTTP method, path, request body, controller method, expected args, status)
