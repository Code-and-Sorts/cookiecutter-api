FROM python:{{ runtime.python }}-slim AS requirements
COPY --from=ghcr.io/astral-sh/uv:{{ runtime.uv }} /uv /bin/uv
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN uv export --locked --no-dev --format requirements-txt --output-file requirements.txt
{%- if cloud_service == 'Azure Function App' %}

FROM mcr.microsoft.com/azure-functions/python:4-python{{ runtime.python }}
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true
COPY --from=requirements /src/requirements.txt /requirements.txt
RUN pip install --no-cache-dir --requirement /requirements.txt && rm /requirements.txt
COPY . /home/site/wwwroot
{%- endif %}
