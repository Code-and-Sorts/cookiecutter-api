{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- from '_macros.jinja' import model_names -%}
{% if 'list' in ops -%}
from typing import List
{% endif -%}
from models import {{ model_names(resource, always_response=true) }}
from .base_repository import BaseRepository


class {{ r }}Repository(BaseRepository[{{ r }}Response]):
    resource_name = "{{ r }}"
    response_model = {{ r }}Response
{%- if "get_by_id" in ops %}

    async def get_by_id(self, item_id: str) -> {{ r }}Response:
        return await self._get_by_id(item_id)
{%- endif %}
{%- if "list" in ops %}

    async def get_list(self, limit: int) -> List[{{ r }}Response]:
        return await self._get_list(limit)
{%- endif %}
{%- if "create" in ops %}

    async def create(self, item: Base{{ r }}, user_id: str | None = None) -> {{ r }}Response:
        return await self._create(item.model_dump(), user_id)
{%- endif %}
{%- if "update" in ops %}

    async def update(self, item_id: str, changes: {{ r }}Update, user_id: str | None = None) -> {{ r }}Response:
        return await self._update(item_id, changes.model_dump(exclude_unset=True), user_id)
{%- endif %}
{%- if "replace" in ops %}

    async def replace(self, item_id: str, item: Base{{ r }}, user_id: str | None = None) -> {{ r }}Response:
        return await self._replace(item_id, item.model_dump(), user_id)
{%- endif %}
{%- if "delete" in ops %}

    async def delete(self, item_id: str, user_id: str | None = None) -> None:
        await self._delete(item_id, user_id)
{%- endif %}
