{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set models = [] -%}
{%- if ('create' in ops) or ('replace' in ops) %}{% set _ = models.append('Base' ~ r) %}{% endif -%}
{%- if 'update' in ops %}{% set _ = models.append(r ~ 'Update') %}{% endif -%}
{%- set _ = models.append(r ~ 'Response') -%}
{% if 'list' in ops -%}
from typing import List
{% endif -%}
from models import {{ models | join(', ') }}
from .base_repository import {% if 'list' in ops %}DEFAULT_LIST_LIMIT, {% endif %}BaseRepository


class {{ r }}Repository(BaseRepository[{{ r }}Response]):
    """Exposes only the operations the {{ r }} resource supports."""

    resource_name = "{{ r }}"
    response_model = {{ r }}Response
{%- if "get_by_id" in ops %}

    async def get_by_id(self, item_id: str) -> {{ r }}Response:
        return await self._get_by_id(item_id)
{%- endif %}
{%- if "list" in ops %}

    async def get_list(self, limit: int = DEFAULT_LIST_LIMIT) -> List[{{ r }}Response]:
        return await self._get_list(limit)
{%- endif %}
{%- if "create" in ops %}

    async def create(self, item: Base{{ r }}) -> {{ r }}Response:
        return await self._create(item.model_dump())
{%- endif %}
{%- if "update" in ops %}

    async def update(self, item_id: str, changes: {{ r }}Update) -> {{ r }}Response:
        return await self._update(item_id, changes.model_dump(exclude_unset=True))
{%- endif %}
{%- if "replace" in ops %}

    async def replace(self, item_id: str, item: Base{{ r }}) -> {{ r }}Response:
        return await self._replace(item_id, item.model_dump())
{%- endif %}
{%- if "delete" in ops %}

    async def delete(self, item_id: str) -> None:
        await self._delete(item_id)
{%- endif %}
