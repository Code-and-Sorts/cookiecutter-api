import asyncio
from unittest.mock import AsyncMock, MagicMock
from models import {{ model_names(resource, entity=true, always_response=true) }}
from repositories import BaseRepository, {{ r }}Repository
from conftest import ITEM_ID

_sample = {{ sample_dict(client) }}
_response = {{ r }}Response(id=ITEM_ID, **{{ sample_dict(shown) }})


def _repository() -> {{ r }}Repository:
{%- if cloud_service == 'AWS Lambda' %}
    return {{ r }}Repository(MagicMock(), "{{ resource.container }}", "us-east-1")
{%- else %}
    return {{ r }}Repository(MagicMock())
{%- endif %}


def describe_{{ r | to_snake }}_repository():
    def test_extends_base_repository_with_{{ r | to_snake }}_models():
        assert issubclass({{ r }}Repository, BaseRepository)
        assert {{ r }}Repository.entity_model is {{ r }}Entity
        assert {{ r }}Repository.response_model is {{ r }}Response
        assert {{ r }}Repository.resource_name == "{{ r }}"

    def test_entity_lists_every_client_field():
        assert {{ r }}Entity.client_fields() == {{ client | map(attribute="name") | list | tojson }}
{%- if hidden %}

    def test_exposes_only_{{ r | to_snake }}_operations():
        for method in {{ hidden }}:
            assert not hasattr({{ r }}Repository, method)
{%- endif %}
{%- if "get_by_id" in ops %}

    def test_get_by_id_returns_{{ r | to_snake }}_response():
        repository = _repository()
        repository._get_stored = AsyncMock(return_value={"id": ITEM_ID, **_sample, "isDeleted": False})

        result = asyncio.run(repository.get_by_id(ITEM_ID))

        assert isinstance(result, {{ r }}Response)
        assert result == _response
{%- if resource.fields | rejectattr("hidden") | list %}

    def test_a_record_without_a_field_reads_its_static_default():
        repository = _repository()
        repository._get_stored = AsyncMock(return_value={"id": ITEM_ID, "isDeleted": False})

        result = asyncio.run(repository.get_by_id(ITEM_ID)).model_dump()

        assert result == {
            "id": ITEM_ID,
{%- for f in shown %}
            "{{ f.name }}": {{ literal(f.read_default) }},
{%- endfor %}
        }
{%- endif %}
{%- endif %}
{%- if "list" in ops %}

    def test_get_list_delegates_to_base():
        repository = _repository()
        repository._get_list = AsyncMock(return_value=[_response])

        assert asyncio.run(repository.get_list(25)) == [_response]
        repository._get_list.assert_awaited_once_with(25)
{%- endif %}
{%- if "create" in ops %}

    def test_create_stores_client_fields():
        repository = _repository()
        repository._write = AsyncMock()

        result = asyncio.run(repository.create({{ r }}CreateRequest(**{{ sample_dict(create_fields) }}), "user-1"))

        record = repository._write.call_args.args[0]
        assert record["createdBy"] == "user-1"
{%- for f in create_fields %}
        assert {{ expect('record["' ~ f.name ~ '"]', f.sample) }}
{%- endfor %}
{%- for f in client | rejectattr("in_create") | selectattr("defaulted") | rejectattr("dynamic") %}
        assert {{ expect('record["' ~ f.name ~ '"]', f.default) }}
{%- endfor %}
        assert result.id == record["id"]
{%- endif %}
{%- if "update" in ops %}

    def test_update_passes_only_the_fields_sent():
        repository = _repository()
        repository._update = AsyncMock(return_value=_response)

        assert asyncio.run(repository.update(ITEM_ID, {{ r }}UpdateRequest())) == _response
        repository._update.assert_awaited_once_with(ITEM_ID, {}, None)
{%- if update_fields %}

        asyncio.run(repository.update(ITEM_ID, {{ r }}UpdateRequest(**{{ sample_dict(update_fields) }}), "user-1"))
        repository._update.assert_awaited_with(ITEM_ID, {{ sample_dict(update_fields) }}, "user-1")
{%- endif %}
{%- endif %}
{%- if "replace" in ops %}

    def test_replace_passes_every_accepted_field():
        repository = _repository()
        repository._update = AsyncMock(return_value=_response)

        item = {{ r }}ReplaceRequest(**{{ sample_dict(replace_fields) }})
        assert asyncio.run(repository.replace(ITEM_ID, item, "user-1")) == _response
        repository._update.assert_awaited_once_with(ITEM_ID, {{ sample_dict(replace_fields) }}, "user-1")
{%- endif %}
{%- if "delete" in ops %}

    def test_delete_delegates_to_base():
        repository = _repository()
        repository._delete = AsyncMock()

        asyncio.run(repository.delete(ITEM_ID, "user-1"))
        repository._delete.assert_awaited_once_with(ITEM_ID, "user-1")
{%- endif %}
