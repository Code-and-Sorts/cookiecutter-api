{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- from '_macros.jinja' import model_names, routes -%}
{%- set hidden = [] -%}
{%- for route in routes if route[0] not in ops -%}{% set _ = hidden.append(route[1]) %}{%- endfor -%}
import asyncio
from unittest.mock import AsyncMock, MagicMock
from models import {{ model_names(resource, always_response=true) }}
from repositories import BaseRepository, {{ r }}Repository
from conftest import ITEM_ID

_response = {{ r }}Response(id=ITEM_ID, name="mockName1")


def _repository() -> {{ r }}Repository:
{%- if cloud_service == 'AWS Lambda' %}
    return {{ r }}Repository(MagicMock(), "{{ resource.container }}", "us-east-1")
{%- else %}
    return {{ r }}Repository(MagicMock())
{%- endif %}


def describe_{{ r | to_snake }}_repository():
    def test_extends_base_repository_with_{{ r | to_snake }}_models():
        assert issubclass({{ r }}Repository, BaseRepository)
        assert {{ r }}Repository.response_model is {{ r }}Response
        assert {{ r }}Repository.resource_name == "{{ r }}"
{%- if hidden %}

    def test_exposes_only_{{ r | to_snake }}_operations():
        for method in {{ hidden }}:
            assert not hasattr({{ r }}Repository, method)
{%- endif %}
{%- if "get_by_id" in ops %}

    def test_get_by_id_returns_{{ r | to_snake }}_response():
        repository = _repository()
        repository._get_stored = AsyncMock(return_value={"id": ITEM_ID, "name": "mockName1", "isDeleted": False})

        result = asyncio.run(repository.get_by_id(ITEM_ID))

        assert isinstance(result, {{ r }}Response)
        assert result == _response
{%- endif %}
{%- if "list" in ops %}

    def test_get_list_delegates_to_base():
        repository = _repository()
        repository._get_list = AsyncMock(return_value=[_response])

        assert asyncio.run(repository.get_list(25)) == [_response]
        repository._get_list.assert_awaited_once_with(25)
{%- endif %}
{%- if "create" in ops %}

    def test_create_stores_client_fields():
        repository = _repository()
        repository._write = AsyncMock()

        result = asyncio.run(repository.create(Base{{ r }}(name="mockName1"), "user-1"))

        record = repository._write.call_args.args[0]
        assert (record["name"], record["createdBy"]) == ("mockName1", "user-1")
        assert result == {{ r }}Response(id=record["id"], name="mockName1")
{%- endif %}
{%- if "update" in ops %}

    def test_update_passes_only_the_fields_sent():
        repository = _repository()
        repository._update = AsyncMock(return_value=_response)

        assert asyncio.run(repository.update(ITEM_ID, {{ r }}Update())) == _response
        repository._update.assert_awaited_once_with(ITEM_ID, {}, None)

        asyncio.run(repository.update(ITEM_ID, {{ r }}Update(name="mockName1"), "user-1"))
        repository._update.assert_awaited_with(ITEM_ID, {"name": "mockName1"}, "user-1")
{%- endif %}
{%- if "replace" in ops %}

    def test_replace_passes_all_client_fields():
        repository = _repository()
        repository._replace = AsyncMock(return_value=_response)

        assert asyncio.run(repository.replace(ITEM_ID, Base{{ r }}(name="mockName1"), "user-1")) == _response
        repository._replace.assert_awaited_once_with(ITEM_ID, {"name": "mockName1"}, "user-1")
{%- endif %}
{%- if "delete" in ops %}

    def test_delete_delegates_to_base():
        repository = _repository()
        repository._delete = AsyncMock()

        asyncio.run(repository.delete(ITEM_ID, "user-1"))
        repository._delete.assert_awaited_once_with(ITEM_ID, "user-1")
{%- endif %}
