def describe_trace_context():
    @pytest.mark.parametrize("name", ["traceparent", "Traceparent", "TRACEPARENT"])
    def test_traceparent_header_becomes_the_current_span(name):
        with telemetry.trace_context({name: TRACEPARENT}):
            span_context = trace.get_current_span().get_span_context()

        assert (format(span_context.trace_id, "032x"), format(span_context.span_id, "016x")) == (TRACE_ID, SPAN_ID)
        assert not trace.get_current_span().get_span_context().is_valid

    def test_missing_headers_leave_no_span():
        with telemetry.trace_context(None):
            assert not trace.get_current_span().get_span_context().is_valid


def describe_unexpected_error_record():
    def test_carries_the_exception_and_the_trace(exported, remote_span):
        try:
            raise RuntimeError("secret detail")
        except RuntimeError as error:
            detect_error(error)

        (record,) = [log.log_record for log in exported.get_finished_logs()]
        assert record.severity_text == "ERROR"
        assert record.attributes["exception.type"] == "RuntimeError"
        assert record.attributes["exception.message"] == "secret detail"
        assert "Traceback" in record.attributes["exception.stacktrace"]
        assert (format(record.trace_id, "032x"), format(record.span_id, "016x")) == (TRACE_ID, SPAN_ID)
