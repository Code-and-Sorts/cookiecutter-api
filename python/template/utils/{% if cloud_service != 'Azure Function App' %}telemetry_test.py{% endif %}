def _clean_env(monkeypatch):
    for name in ("OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT", "OTEL_SERVICE_NAME", "OTEL_RESOURCE_ATTRIBUTES"):
        monkeypatch.delenv(name, raising=False)


def describe_log_exporters():
    @pytest.mark.parametrize("environ, kinds", [
        ({}, []),
        ({"OTEL_EXPORTER_OTLP_ENDPOINT": ""}, []),
        (OTLP, [OTLPLogExporter]),
        ({"OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "http://localhost:4318/v1/logs"}, [OTLPLogExporter]),
    ])
    def test_exporters_follow_the_environment(environ, kinds):
        assert [type(exporter) for exporter in telemetry.log_exporters(environ)] == kinds


def describe_build_logger_provider():
    def test_platform_console_is_kept_when_nothing_exports():
        assert telemetry.build_logger_provider({}, has_console=True) is None

    def test_exporters_are_used_alongside_the_platform_console():
        provider = telemetry.build_logger_provider(OTLP, has_console=True)

        assert isinstance(provider, LoggerProvider)
        provider.shutdown()

    def test_console_gets_one_json_line_per_record(capsys, monkeypatch, remote_span):
        _clean_env(monkeypatch)
        provider = telemetry.build_logger_provider({}, has_console=False)
        logger = logging.getLogger("telemetry-test")
        handler = LoggingHandler(logger_provider=provider)
        logger.addHandler(handler)
        try:
            logger.error("failed")
        finally:
            logger.removeHandler(handler)

        (line,) = capsys.readouterr().out.splitlines()
        record = json.loads(line)
        assert record["body"] == "failed"
        assert record["severity_text"] == "ERROR"
        assert record["trace_id"] == f"0x{TRACE_ID}"
        assert record["span_id"] == f"0x{SPAN_ID}"
        assert record["resource"]["attributes"] | telemetry.RESOURCE == record["resource"]["attributes"]

    def test_environment_overrides_the_resource(monkeypatch):
        _clean_env(monkeypatch)
        monkeypatch.setenv("OTEL_SERVICE_NAME", "renamed")
        monkeypatch.setenv("OTEL_RESOURCE_ATTRIBUTES", "deployment.environment.name=dev")

        attributes = telemetry.build_logger_provider({}, has_console=False).resource.attributes

        assert attributes["service.name"] == "renamed"
        assert attributes["deployment.environment.name"] == "dev"
        assert attributes["cloud.provider"] == telemetry.RESOURCE["cloud.provider"]


