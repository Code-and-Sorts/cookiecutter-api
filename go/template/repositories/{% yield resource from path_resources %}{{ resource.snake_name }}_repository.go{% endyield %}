type {{ r }}Repository interface {
{%- if 'get_by_id' in ops %}
	Get(ctx context.Context, id string) (*models.{{ r }}Dto, error)
{%- endif %}
{%- if 'list' in ops %}
	GetList(ctx context.Context, limit int) ([]models.{{ r }}Dto, error)
{%- endif %}
{%- if 'create' in ops %}
	Create(ctx context.Context, item models.{{ r }}) (*models.{{ r }}Dto, error)
{%- endif %}
{%- if 'update' in ops %}
	Update(ctx context.Context, item models.{{ r }}) (*models.{{ r }}Dto, error)
{%- endif %}
{%- if 'replace' in ops %}
	Replace(ctx context.Context, item models.{{ r }}) (*models.{{ r }}Dto, error)
{%- endif %}
{%- if 'delete' in ops %}
	Delete(ctx context.Context, id string) error
{%- endif %}
}
{%- if cloud_service == 'Azure Function App' %}

type {{ lc }}Repository struct {
	container *azcosmos.ContainerClient
}

func New{{ r }}Repository(container *azcosmos.ContainerClient) {{ r }}Repository {
	return &{{ lc }}Repository{container: container}
}
{%- if needs_get_item %}

// getItem reads a record that exists and is not soft-deleted.
func (repo *{{ lc }}Repository) getItem(ctx context.Context, id string) (*models.{{ r }}, error) {
	resp, err := repo.container.ReadItem(ctx, azcosmos.NewPartitionKeyString(id), id, nil)
	if err != nil {
		if IsItemNotFound(err) {
			return nil, models.NewNotFoundError("{{ r }}", id)
		}
		return nil, err
	}

	var item models.{{ r }}
	if err := json.Unmarshal(resp.Value, &item); err != nil {
		return nil, err
	}

	if item.IsDeleted {
		return nil, models.NewNotFoundError("{{ r }}", id)
	}

	return &item, nil
}
{%- endif %}
{%- if 'create' in ops or 'update' in ops or 'replace' in ops or 'delete' in ops %}

// write stores item. Writes don't request the item back from Cosmos DB (the
// SDK returns no body unless EnableContentResponseOnWrite is set), so callers
// build their response from the item they wrote.
func (repo *{{ lc }}Repository) write(ctx context.Context, item models.{{ r }}, create bool) error {
	data, err := json.Marshal(item)
	if err != nil {
		return err
	}

	pk := azcosmos.NewPartitionKeyString(item.Id)
	if create {
		_, err = repo.container.CreateItem(ctx, pk, data, nil)
	} else {
		_, err = repo.container.ReplaceItem(ctx, pk, item.Id, data, nil)
	}
	return err
}
{%- endif %}
{%- elif cloud_service == 'GCP Cloud Function' %}

type {{ lc }}Repository struct {
	collection *firestore.CollectionRef
}

func New{{ r }}Repository(collection *firestore.CollectionRef) {{ r }}Repository {
	return &{{ lc }}Repository{collection: collection}
}
{%- if needs_get_item %}

// getItem reads a record that exists and is not soft-deleted.
func (repo *{{ lc }}Repository) getItem(ctx context.Context, id string) (*models.{{ r }}, error) {
	doc, err := repo.collection.Doc(id).Get(ctx)
	if err != nil {
		if status.Code(err) == codes.NotFound {
			return nil, models.NewNotFoundError("{{ r }}", id)
		}
		return nil, err
	}

	var item models.{{ r }}
	if err := doc.DataTo(&item); err != nil {
		return nil, err
	}

	if item.IsDeleted {
		return nil, models.NewNotFoundError("{{ r }}", id)
	}

	return &item, nil
}
{%- endif %}
{%- if 'create' in ops or 'update' in ops or 'replace' in ops or 'delete' in ops %}

// write stores item as the whole document.
func (repo *{{ lc }}Repository) write(ctx context.Context, item models.{{ r }}, create bool) error {
	doc := repo.collection.Doc(item.Id)
	var err error
	if create {
		_, err = doc.Create(ctx, item)
	} else {
		_, err = doc.Set(ctx, item)
	}
	return err
}
{%- endif %}
{%- elif cloud_service == 'AWS Lambda' %}

type {{ lc }}Repository struct {
	client    *dynamodb.Client
	tableName string
}

func New{{ r }}Repository(client *dynamodb.Client, tableName string) {{ r }}Repository {
	return &{{ lc }}Repository{client: client, tableName: tableName}
}
{%- if needs_get_item %}

// getItem reads a record that exists and is not soft-deleted.
func (repo *{{ lc }}Repository) getItem(ctx context.Context, id string) (*models.{{ r }}, error) {
	key, err := attributevalue.MarshalMap(map[string]string{"id": id})
	if err != nil {
		return nil, err
	}

	resp, err := repo.client.GetItem(ctx, &dynamodb.GetItemInput{
		TableName: aws.String(repo.tableName),
		Key:       key,
	})
	if err != nil {
		return nil, err
	}

	if resp.Item == nil {
		return nil, models.NewNotFoundError("{{ r }}", id)
	}

	var item models.{{ r }}
	if err := attributevalue.UnmarshalMap(resp.Item, &item); err != nil {
		return nil, err
	}

	if item.IsDeleted {
		return nil, models.NewNotFoundError("{{ r }}", id)
	}

	return &item, nil
}
{%- endif %}
{%- if 'create' in ops or 'update' in ops or 'replace' in ops or 'delete' in ops %}

// write stores item as the whole record. A create fails instead of
// overwriting an existing id.
func (repo *{{ lc }}Repository) write(ctx context.Context, item models.{{ r }}, create bool) error {
	av, err := attributevalue.MarshalMap(item)
	if err != nil {
		return err
	}

	input := &dynamodb.PutItemInput{
		TableName: aws.String(repo.tableName),
		Item:      av,
	}
	if create {
		input.ConditionExpression = aws.String("attribute_not_exists(id)")
	}
	_, err = repo.client.PutItem(ctx, input)
	return err
}
{%- endif %}
{%- endif %}
{%- if 'get_by_id' in ops %}

func (repo *{{ lc }}Repository) Get(ctx context.Context, id string) (*models.{{ r }}Dto, error) {
	item, err := repo.getItem(ctx, id)
	if err != nil {
		return nil, err
	}

	dto := models.To{{ r }}Dto(*item)
	return &dto, nil
}
{%- endif %}
{%- if 'list' in ops %}

// GetList returns up to limit records that are not soft-deleted.
func (repo *{{ lc }}Repository) GetList(ctx context.Context, limit int) ([]models.{{ r }}Dto, error) {
	results := make([]models.{{ r }}Dto, 0)
{%- if cloud_service == 'Azure Function App' %}
	query := fmt.Sprintf("SELECT * FROM c WHERE c.isDeleted = false OFFSET 0 LIMIT %d", limit)
	pager := repo.container.NewQueryItemsPager(query, azcosmos.NewPartitionKey(), nil)

	for pager.More() && len(results) < limit {
		resp, err := pager.NextPage(ctx)
		if err != nil {
			return nil, err
		}

		for _, data := range resp.Items {
			var item models.{{ r }}
			if err := json.Unmarshal(data, &item); err != nil {
				return nil, err
			}
			results = append(results, models.To{{ r }}Dto(item))
		}
	}
{%- elif cloud_service == 'GCP Cloud Function' %}
	iter := repo.collection.Where("isDeleted", "==", false).Limit(limit).Documents(ctx)
	defer iter.Stop()

	for {
		doc, err := iter.Next()
		if err == iterator.Done {
			break
		}
		if err != nil {
			return nil, err
		}

		var item models.{{ r }}
		if err := doc.DataTo(&item); err != nil {
			return nil, err
		}
		results = append(results, models.To{{ r }}Dto(item))
	}
{%- elif cloud_service == 'AWS Lambda' %}
	filter := expression.Equal(expression.Name("isDeleted"), expression.Value(false))
	expr, err := expression.NewBuilder().WithFilter(filter).Build()
	if err != nil {
		return nil, err
	}

	var lastKey map[string]types.AttributeValue
	for {
		resp, err := repo.client.Scan(ctx, &dynamodb.ScanInput{
			TableName:                 aws.String(repo.tableName),
			FilterExpression:          expr.Filter(),
			ExpressionAttributeNames:  expr.Names(),
			ExpressionAttributeValues: expr.Values(),
			ExclusiveStartKey:         lastKey,
			Limit:                     aws.Int32(int32(limit)),
		})
		if err != nil {
			return nil, err
		}

		for _, data := range resp.Items {
			var item models.{{ r }}
			if err := attributevalue.UnmarshalMap(data, &item); err != nil {
				return nil, err
			}
			results = append(results, models.To{{ r }}Dto(item))
		}

		if resp.LastEvaluatedKey == nil || len(results) >= limit {
			break
		}
		lastKey = resp.LastEvaluatedKey
	}
{%- endif %}

	if len(results) > limit {
		results = results[:limit]
	}
	return results, nil
}
{%- endif %}
{%- if 'create' in ops %}

func (repo *{{ lc }}Repository) Create(ctx context.Context, item models.{{ r }}) (*models.{{ r }}Dto, error) {
	if err := repo.write(ctx, item, true); err != nil {
		return nil, err
	}

	dto := models.To{{ r }}Dto(item)
	return &dto, nil
}
{%- endif %}
{%- if 'update' in ops %}

// Update changes the name when one is given and refreshes updatedTimestamp,
// keeping every other stored field.
func (repo *{{ lc }}Repository) Update(ctx context.Context, item models.{{ r }}) (*models.{{ r }}Dto, error) {
	updated, err := repo.getItem(ctx, item.Id)
	if err != nil {
		return nil, err
	}

	if item.Name != "" {
		updated.Name = item.Name
	}
	if item.UpdatedBy != "" {
		updated.UpdatedBy = item.UpdatedBy
	}
	updated.UpdatedTimestamp = models.Now()

	if err := repo.write(ctx, *updated, false); err != nil {
		return nil, err
	}

	dto := models.To{{ r }}Dto(*updated)
	return &dto, nil
}
{%- endif %}
{%- if 'replace' in ops %}

// Replace overwrites the client-settable fields, keeping id, createdTimestamp
// and createdBy, and refreshes updatedTimestamp.
func (repo *{{ lc }}Repository) Replace(ctx context.Context, item models.{{ r }}) (*models.{{ r }}Dto, error) {
	current, err := repo.getItem(ctx, item.Id)
	if err != nil {
		return nil, err
	}

	replacement := models.{{ r }}{
		BaseEntity: models.BaseEntity{
			Id:               current.Id,
			CreatedTimestamp: current.CreatedTimestamp,
			UpdatedTimestamp: models.Now(),
			CreatedBy:        current.CreatedBy,
			UpdatedBy:        item.UpdatedBy,
		},
		Name: item.Name,
	}

	if err := repo.write(ctx, replacement, false); err != nil {
		return nil, err
	}

	dto := models.To{{ r }}Dto(replacement)
	return &dto, nil
}
{%- endif %}
{%- if 'delete' in ops %}

// Delete soft-deletes the record: it is kept with isDeleted set to true.
func (repo *{{ lc }}Repository) Delete(ctx context.Context, id string) error {
	item, err := repo.getItem(ctx, id)
	if err != nil {
		return err
	}

	item.IsDeleted = true
	item.UpdatedTimestamp = models.Now()
	return repo.write(ctx, *item, false)
}
{%- endif %}
