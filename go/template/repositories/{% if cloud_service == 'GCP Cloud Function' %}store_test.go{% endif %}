import (
	"testing"
	"time"

	"github.com/stretchr/testify/assert"

	"{{project_endpoint}}/models"
)

func TestDecode_ConvertsLegacyFirestoreTimestamps(t *testing.T) {
	created := time.Date(2024, 1, 2, 3, 4, 5, 123456789, time.FixedZone("CET", 3600))
	data := map[string]any{
		"id": "11111111-1111-1111-1111-111111111111", "isDeleted": false,
		"createdTimestamp": created, "updatedTimestamp": "2024-01-03T00:00:00.000Z", "createdBy": "",
	}

	var item models.BaseEntity
	assert.NoError(t, decode(data, &item))

	assert.Equal(t, models.BaseEntity{
		Id:               "11111111-1111-1111-1111-111111111111",
		CreatedTimestamp: "2024-01-02T02:04:05.123Z",
		UpdatedTimestamp: "2024-01-03T00:00:00.000Z",
	}, item)
}
