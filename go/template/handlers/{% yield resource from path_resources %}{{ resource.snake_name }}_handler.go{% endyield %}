{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set ep = resource.endpoint -%}
{%- set uses_body = ('create' in ops) or ('update' in ops) or ('replace' in ops) -%}
{%- set uses_id = ops | select('in', ['get_by_id', 'update', 'replace', 'delete']) | list | length > 0 -%}
{%- set route_prefix = '/api' if cloud_service == 'Azure Function App' else '' -%}
package handlers

import (
{%- if cloud_service == 'AWS Lambda' %}
	"context"
{%- endif %}
{%- if 'delete' in ops %}
	"fmt"
{%- endif %}
	"log/slog"
	"net/http"
{%- if 'list' in ops %}
	"strconv"
{%- endif %}
{%- if cloud_service == 'AWS Lambda' and uses_body %}
	"strings"
{%- endif %}
{%- if cloud_service == 'AWS Lambda' %}

	"github.com/aws/aws-lambda-go/events"
{%- endif %}

	"{{project_endpoint}}/controllers"
	"{{project_endpoint}}/utils"
)
{%- if cloud_service != 'AWS Lambda' %}

// Register{{ r }}Routes registers the {{ route_prefix }}/{{ ep }} routes on mux. Other
// methods on these paths get the JSON 405 response.
func Register{{ r }}Routes(mux *http.ServeMux, controller controllers.{{ r }}Controller) {
{%- if "list" in ops %}
	mux.HandleFunc("GET {{ route_prefix }}/{{ ep }}", handleGet{{ r }}List(controller))
{%- endif %}
{%- if "get_by_id" in ops %}
	mux.HandleFunc("GET {{ route_prefix }}/{{ ep }}/{id}", handleGet{{ r }}(controller))
{%- endif %}
{%- if "create" in ops %}
	mux.HandleFunc("POST {{ route_prefix }}/{{ ep }}", handleCreate{{ r }}(controller))
{%- endif %}
{%- if "update" in ops %}
	mux.HandleFunc("PATCH {{ route_prefix }}/{{ ep }}/{id}", handleUpdate{{ r }}(controller))
{%- endif %}
{%- if "replace" in ops %}
	mux.HandleFunc("PUT {{ route_prefix }}/{{ ep }}/{id}", handleReplace{{ r }}(controller))
{%- endif %}
{%- if "delete" in ops %}
	mux.HandleFunc("DELETE {{ route_prefix }}/{{ ep }}/{id}", handleDelete{{ r }}(controller))
{%- endif %}
	mux.HandleFunc("{{ route_prefix }}/{{ ep }}", methodNotAllowed)
	mux.HandleFunc("{{ route_prefix }}/{{ ep }}/{id}", methodNotAllowed)
}
{%- if "list" in ops %}

func handleGet{{ r }}List(controller controllers.{{ r }}Controller) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		slog.Info("Get{{ r }}List processed a request.")

		limit, _ := strconv.Atoi(r.URL.Query().Get("limit"))
		result, err := controller.GetList(r.Context(), limit)
		if err != nil {
			utils.DetectError(r.Context(), w, err)
			return
		}

		utils.WriteJSON(w, http.StatusOK, result)
	}
}
{%- endif %}
{%- if "get_by_id" in ops %}

func handleGet{{ r }}(controller controllers.{{ r }}Controller) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		slog.Info("Get{{ r }} processed a request.")

		result, err := controller.Get(r.Context(), r.PathValue("id"))
		if err != nil {
			utils.DetectError(r.Context(), w, err)
			return
		}

		utils.WriteJSON(w, http.StatusOK, result)
	}
}
{%- endif %}
{%- if "create" in ops %}

func handleCreate{{ r }}(controller controllers.{{ r }}Controller) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		slog.Info("Create{{ r }} processed a request.")

		result, err := controller.Create(r.Context(), r.Body)
		if err != nil {
			utils.DetectError(r.Context(), w, err)
			return
		}

		utils.WriteJSON(w, http.StatusCreated, result)
	}
}
{%- endif %}
{%- if "update" in ops %}

func handleUpdate{{ r }}(controller controllers.{{ r }}Controller) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		slog.Info("Update{{ r }} processed a request.")

		result, err := controller.Update(r.Context(), r.PathValue("id"), r.Body)
		if err != nil {
			utils.DetectError(r.Context(), w, err)
			return
		}

		utils.WriteJSON(w, http.StatusOK, result)
	}
}
{%- endif %}
{%- if "replace" in ops %}

func handleReplace{{ r }}(controller controllers.{{ r }}Controller) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		slog.Info("Replace{{ r }} processed a request.")

		result, err := controller.Replace(r.Context(), r.PathValue("id"), r.Body)
		if err != nil {
			utils.DetectError(r.Context(), w, err)
			return
		}

		utils.WriteJSON(w, http.StatusOK, result)
	}
}
{%- endif %}
{%- if "delete" in ops %}

func handleDelete{{ r }}(controller controllers.{{ r }}Controller) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		slog.Info("Delete{{ r }} processed a request.")

		id := r.PathValue("id")
		if err := controller.Delete(r.Context(), id); err != nil {
			utils.DetectError(r.Context(), w, err)
			return
		}

		utils.WriteJSON(w, http.StatusOK, map[string]string{
			"message": fmt.Sprintf("{{ r }} with id %s was deleted successfully.", id),
		})
	}
}
{%- endif %}
{%- else %}

// Register{{ r }}Routes registers the /{{ ep }} and /{{ ep }}/{id} resource paths
// on router.
func Register{{ r }}Routes(router *Router, controller controllers.{{ r }}Controller) {
	handler := handle{{ r }}(controller)
	router.Handle("/{{ ep }}", handler)
	router.Handle("/{{ ep }}/{id}", handler)
}

// handle{{ r }} serves the /{{ ep }} routes. Methods that are not enabled get the
// JSON 405 response.
func handle{{ r }}(controller controllers.{{ r }}Controller) RouteHandler {
	return func(ctx context.Context, request events.APIGatewayProxyRequest) events.APIGatewayProxyResponse {
{%- if uses_id %}
		id := request.PathParameters["id"]
{% endif %}
		switch request.HTTPMethod + " " + request.Resource {
{%- if "list" in ops %}
		case "GET /{{ ep }}":
			slog.Info("Get{{ r }}List processed a request.")
			limit, _ := strconv.Atoi(request.QueryStringParameters["limit"])
			result, err := controller.GetList(ctx, limit)
			if err != nil {
				return utils.DetectError(ctx, err)
			}
			return utils.JSONResponse(http.StatusOK, result)
{%- endif %}
{%- if "get_by_id" in ops %}
		case "GET /{{ ep }}/{id}":
			slog.Info("Get{{ r }} processed a request.")
			result, err := controller.Get(ctx, id)
			if err != nil {
				return utils.DetectError(ctx, err)
			}
			return utils.JSONResponse(http.StatusOK, result)
{%- endif %}
{%- if "create" in ops %}
		case "POST /{{ ep }}":
			slog.Info("Create{{ r }} processed a request.")
			result, err := controller.Create(ctx, strings.NewReader(request.Body))
			if err != nil {
				return utils.DetectError(ctx, err)
			}
			return utils.JSONResponse(http.StatusCreated, result)
{%- endif %}
{%- if "update" in ops %}
		case "PATCH /{{ ep }}/{id}":
			slog.Info("Update{{ r }} processed a request.")
			result, err := controller.Update(ctx, id, strings.NewReader(request.Body))
			if err != nil {
				return utils.DetectError(ctx, err)
			}
			return utils.JSONResponse(http.StatusOK, result)
{%- endif %}
{%- if "replace" in ops %}
		case "PUT /{{ ep }}/{id}":
			slog.Info("Replace{{ r }} processed a request.")
			result, err := controller.Replace(ctx, id, strings.NewReader(request.Body))
			if err != nil {
				return utils.DetectError(ctx, err)
			}
			return utils.JSONResponse(http.StatusOK, result)
{%- endif %}
{%- if "delete" in ops %}
		case "DELETE /{{ ep }}/{id}":
			slog.Info("Delete{{ r }} processed a request.")
			if err := controller.Delete(ctx, id); err != nil {
				return utils.DetectError(ctx, err)
			}
			return utils.JSONResponse(http.StatusOK, map[string]string{
				"message": fmt.Sprintf("{{ r }} with id %s was deleted successfully.", id),
			})
{%- endif %}
		default:
			return methodNotAllowed()
		}
	}
}
{%- endif %}
