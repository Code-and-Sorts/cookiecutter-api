func TestGet{{ r }}List_ReturnsJSONArray(t *testing.T) {
	controller := &fake{{ r }}Controller{}

	status, body := call{{ r }}(t, controller, http.MethodGet, false, "?limit=5", "")

	assert.Equal(t, http.StatusOK, status)
	assert.JSONEq(t, `[]`, body)
	assert.Equal(t, 5, controller.limit)
}

func TestGet{{ r }}List_IgnoresInvalidLimit(t *testing.T) {
	controller := &fake{{ r }}Controller{}

	status, _ := call{{ r }}(t, controller, http.MethodGet, false, "?limit=abc", "")

	assert.Equal(t, http.StatusOK, status)
	assert.Equal(t, 0, controller.limit)
}
