func Test{{ r }}Routes_ReturnControllerErrorsAsJSON(t *testing.T) {
	requests := []struct {
		method string
		item   bool
	}{
{%- for op, method, item in routes if op and op in ops %}
		{http.{{ method }}, {{ 'true' if item else 'false' }}},
{%- endfor %}
	}

	for _, request := range requests {
		controller := &fake{{ r }}Controller{err: models.NewNotFoundError("{{ r }}", test{{ r }}ID)}

		status, body := call{{ r }}(t, controller, request.method, request.item, "", `{"any": "body"}`)

		assert.Equal(t, http.StatusNotFound, status, request.method)
		assert.JSONEq(t, `{"errorMessage": "{{ r }} with id `+test{{ r }}ID+` was not found."}`, body)
	}
}

func Test{{ r }}Routes_DisabledMethod_Returns405(t *testing.T) {
	requests := []struct {
		method string
		item   bool
	}{
{%- for op, method, item in routes if op not in ops %}
		{http.{{ method }}, {{ 'true' if item else 'false' }}},
{%- endfor %}
	}

	for _, request := range requests {
		status, body := call{{ r }}(t, &fake{{ r }}Controller{}, request.method, request.item, "", "")

		assert.Equal(t, http.StatusMethodNotAllowed, status, request.method)
		assert.JSONEq(t, `{"errorMessage": "Method not allowed."}`, body)
	}
}
