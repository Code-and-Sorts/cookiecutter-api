const test{{ r }}ID = "0f3a7ff7-a601-4d23-b33c-7f8f18b57a4c"
{%- if uses_json %}

// What the fake controller returns, as the handler should write it.
func fake{{ r }}JSON() string {
	data, _ := json.Marshal(models.{{ r }}Dto{BaseResponse: models.BaseResponse{Id: test{{ r }}ID}})
	return string(data)
}
{%- endif %}

{%- set fields = [('err', 'error', true), ('id', 'string', uses_id), ('limit', 'int', 'list' in ops), ('body', 'string', uses_body), ('userID', 'string', uses_user)] | selectattr(2) | list %}
{%- set width = fields | map(attribute=0) | map('length') | max %}

type fake{{ r }}Controller struct {
{%- for name, type, _ in fields %}
	{{ name ~ ' ' * (width - name | length) }} {{ type }}
{%- endfor %}
}
