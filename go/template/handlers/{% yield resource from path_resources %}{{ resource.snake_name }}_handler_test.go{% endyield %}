func call{{ r }}(t *testing.T, controller *fake{{ r }}Controller, method string, item bool, query, body string) (int, string) {
	t.Helper()
	target := "{{ route_prefix }}/{{ ep }}"
	if item {
		target += "/" + test{{ r }}ID
	}
	mux := NewRouter()
	Register{{ r }}Routes(mux, controller)
	w := httptest.NewRecorder()
	request := httptest.NewRequest(method, target+query, strings.NewReader(body))
	request.Header.Set("X-User-Id", "alice")

	Recover(mux).ServeHTTP(w, request)

	assert.Equal(t, "application/json", w.Header().Get("Content-Type"))
	return w.Code, w.Body.String()
}

func Test{{ r }}Routes_UnknownPath_Returns404(t *testing.T) {
	mux := NewRouter()
	Register{{ r }}Routes(mux, &fake{{ r }}Controller{})
	w := httptest.NewRecorder()

	mux.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "{{ route_prefix }}/{{ ep }}/"+test{{ r }}ID+"/extra", nil))

	assert.Equal(t, http.StatusNotFound, w.Code)
	assert.JSONEq(t, `{"errorMessage": "Not found."}`, w.Body.String())
}
{%- else %}

func call{{ r }}(t *testing.T, controller *fake{{ r }}Controller, method string, item bool, query, body string) (int, string) {
	t.Helper()
	request := events.APIGatewayProxyRequest{
		HTTPMethod: method,
		Resource:   "/{{ ep }}",
		Headers:    map[string]string{"x-user-id": "alice"},
		Body:       body,
	}
	if item {
		request.Resource = "/{{ ep }}/{id}"
		request.PathParameters = map[string]string{"id": test{{ r }}ID}
	}
	if query != "" {
		request.QueryStringParameters = map[string]string{"limit": query[len("?limit="):]}
	}
	router := NewRouter()
	Register{{ r }}Routes(router, controller)

	response, err := router.ServeRequest(context.Background(), request)

	assert.NoError(t, err)
	assert.Equal(t, "application/json", response.Headers["Content-Type"])
	return response.StatusCode, response.Body
}
{%- endif %}
