package handlers

import (
	"encoding/json"
	"strings"

	"github.com/aws/aws-lambda-go/events"
)

// jsonResponse builds an API Gateway response with a JSON-encoded body.
func jsonResponse(statusCode int, body any) (events.APIGatewayProxyResponse, error) {
	data, _ := json.Marshal(body)
	return events.APIGatewayProxyResponse{
		StatusCode: statusCode,
		Headers:    map[string]string{"Content-Type": "application/json"},
		Body:       string(data),
	}, nil
}

// hasItemID reports whether the request targets a single item route.
func hasItemID(request events.APIGatewayProxyRequest) bool {
	return strings.Contains(request.Resource, "{item_id}")
}
