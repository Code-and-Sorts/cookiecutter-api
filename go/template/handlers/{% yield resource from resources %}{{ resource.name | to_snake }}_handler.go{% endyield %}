func handleDelete{{ r }}(controller controllers.{{ r }}Controller) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		id := r.PathValue("id")
		log.Printf("Delete{{ r }} processed a request.")

		err := controller.Delete(r.Context(), id)
		if err != nil {
			log.Printf("Exception in Delete{{ r }}: %v", err)
			utils.DetectError(w, err)
