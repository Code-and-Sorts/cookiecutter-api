{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set uses_body = ('create' in ops) or ('update' in ops) or ('replace' in ops) -%}
package handlers

import (
{%- if cloud_service == 'AWS Lambda' %}
	"context"
{%- else %}
	"encoding/json"
{%- endif %}
{%- if 'delete' in ops %}
	"fmt"
{%- endif %}
	"log"
{%- if cloud_service != 'AWS Lambda' %}
	"net/http"
{%- endif %}
{%- if 'list' in ops %}
	"strconv"
{%- endif %}
{%- if cloud_service == 'AWS Lambda' and uses_body %}
	"strings"
{%- endif %}
{%- if cloud_service == 'AWS Lambda' %}

	"github.com/aws/aws-lambda-go/events"
{%- endif %}

	"{{project_endpoint}}/controllers"
	"{{project_endpoint}}/utils"
)
{%- if cloud_service == 'Azure Function App' or cloud_service == 'GCP Cloud Function' %}

// Register{{ r }}Routes registers the /api/{{ resource.endpoint }} routes on mux.
func Register{{ r }}Routes(mux *http.ServeMux, controller controllers.{{ r }}Controller) {
{%- if "list" in ops %}
	mux.HandleFunc("GET /api/{{ resource.endpoint }}", handleGet{{ r }}List(controller))
{%- endif %}
{%- if "get_by_id" in ops %}
	mux.HandleFunc("GET /api/{{ resource.endpoint }}/{id}", handleGet{{ r }}(controller))
{%- endif %}
{%- if "create" in ops %}
	mux.HandleFunc("POST /api/{{ resource.endpoint }}", handleCreate{{ r }}(controller))
{%- endif %}
{%- if "update" in ops %}
	mux.HandleFunc("PATCH /api/{{ resource.endpoint }}/{id}", handleUpdate{{ r }}(controller))
{%- endif %}
{%- if "replace" in ops %}
	mux.HandleFunc("PUT /api/{{ resource.endpoint }}/{id}", handleReplace{{ r }}(controller))
{%- endif %}
{%- if "delete" in ops %}
	mux.HandleFunc("DELETE /api/{{ resource.endpoint }}/{id}", handleDelete{{ r }}(controller))
{%- endif %}
}
{%- if "get_by_id" in ops %}

func handleGet{{ r }}(controller controllers.{{ r }}Controller) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		id := r.PathValue("id")
		log.Printf("Get{{ r }} processed a request.")

		result, err := controller.Get(r.Context(), id)
		if err != nil {
			log.Printf("Exception in Get{{ r }}: %v", err)
			utils.DetectError(w, err)
			return
		}

		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusOK)
		json.NewEncoder(w).Encode(result)
	}
}
{%- endif %}
{%- if "list" in ops %}

