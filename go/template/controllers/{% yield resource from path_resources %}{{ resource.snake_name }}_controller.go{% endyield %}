{%- set r = resource.name -%}
{%- set lc = resource.lower_camel_name -%}
{%- set snake = resource.snake_name -%}
{%- set ops = resource.operations -%}
package controllers

import (
	"context"
{%- if 'delete' in ops %}
	"fmt"
{%- endif %}
{%- if resource.has_body %}
	"io"
{%- endif %}
{%- if ops != ['delete'] %}

	"{{project_endpoint}}/models"
{%- endif %}
	"{{project_endpoint}}/services"
)

type {{ r }}Controller interface {
{%- if "get_by_id" in ops %}
	Get(ctx context.Context, id string) (*models.{{ r }}Dto, error)
{%- endif %}
{%- if "list" in ops %}
	GetList(ctx context.Context, limit int) ([]models.{{ r }}Dto, error)
{%- endif %}
{%- if "create" in ops %}
	Create(ctx context.Context, userID string, body io.Reader) (*models.{{ r }}Dto, error)
{%- endif %}
{%- if "update" in ops %}
	Update(ctx context.Context, id, userID string, body io.Reader) (*models.{{ r }}Dto, error)
{%- endif %}
{%- if "replace" in ops %}
	Replace(ctx context.Context, id, userID string, body io.Reader) (*models.{{ r }}Dto, error)
{%- endif %}
{%- if "delete" in ops %}
	Delete(ctx context.Context, id, userID string) (map[string]string, error)
{%- endif %}
}

type {{ lc }}Controller struct {
	service         services.{{ r }}Service
	schemaValidator services.SchemaValidator
}

func New{{ r }}Controller(service services.{{ r }}Service, schemaValidator services.SchemaValidator) {{ r }}Controller {
	return &{{ lc }}Controller{service: service, schemaValidator: schemaValidator}
}
{%- if "get_by_id" in ops %}

func (c *{{ lc }}Controller) Get(ctx context.Context, id string) (*models.{{ r }}Dto, error) {
	if err := requireID("{{ r }}", id); err != nil {
		return nil, err
	}
	return c.service.Get(ctx, id)
}
{%- endif %}
{%- if "list" in ops %}

// Never returns nil, so an empty list encodes as [] rather than null.
func (c *{{ lc }}Controller) GetList(ctx context.Context, limit int) ([]models.{{ r }}Dto, error) {
	items, err := c.service.GetList(ctx, CoerceLimit(limit))
	if err != nil {
		return nil, err
	}
	if items == nil {
		items = []models.{{ r }}Dto{}
	}
	return items, nil
}
{%- endif %}
{%- if "create" in ops %}

func (c *{{ lc }}Controller) Create(ctx context.Context, userID string, body io.Reader) (*models.{{ r }}Dto, error) {
	req := models.NewCreate{{ r }}Request()
	if _, err := decodeRequest(c.schemaValidator, body, "{{ snake }}_create_request", &req); err != nil {
		return nil, err
	}

	return c.service.Create(ctx, req, userID)
}
{%- endif %}
{%- if "update" in ops %}

func (c *{{ lc }}Controller) Update(ctx context.Context, id, userID string, body io.Reader) (*models.{{ r }}Dto, error) {
	if err := requireID("{{ r }}", id); err != nil {
		return nil, err
	}

	var req models.Update{{ r }}Request
	sent, err := decodeRequest(c.schemaValidator, body, "{{ snake }}_update_request", &req)
	if err != nil {
		return nil, err
	}
	req.Id = id
	req.Sent = sent

	return c.service.Update(ctx, req, userID)
}
{%- endif %}
{%- if "replace" in ops %}

func (c *{{ lc }}Controller) Replace(ctx context.Context, id, userID string, body io.Reader) (*models.{{ r }}Dto, error) {
	if err := requireID("{{ r }}", id); err != nil {
		return nil, err
	}

	req := models.NewReplace{{ r }}Request()
	if _, err := decodeRequest(c.schemaValidator, body, "{{ snake }}_replace_request", &req); err != nil {
		return nil, err
	}
	req.Id = id

	return c.service.Replace(ctx, req, userID)
}
{%- endif %}
{%- if "delete" in ops %}

func (c *{{ lc }}Controller) Delete(ctx context.Context, id, userID string) (map[string]string, error) {
	if err := requireID("{{ r }}", id); err != nil {
		return nil, err
	}
	if err := c.service.Delete(ctx, id, userID); err != nil {
		return nil, err
	}
	return map[string]string{"message": fmt.Sprintf("{{ r }} with id %s was deleted successfully.", id)}, nil
}
{%- endif %}
