func TestCreate{{ r }}_ReturnsValidationError_ForInvalidBodies(t *testing.T) {
	bodies := map[string]string{
		"empty name":     `{"name": ""}`,
		"missing name":   `{}`,
		"number name":    `{"name": 5}`,
		"malformed JSON": `invalid json`,
		"array body":     `[]`,
		"unknown field":  `{"name": "a", "color": "red"}`,
		"client id":      `{"name": "a", "id": "` + test{{ r }}ID + `"}`,
		"system field":   `{"name": "a", "createdBy": "someone"}`,
	}

	for name, body := range bodies {
		t.Run(name, func(t *testing.T) {
			mockService := new(Mock{{ r }}Service)
			controller := newTest{{ r }}Controller(mockService)

			result, err := controller.Create(context.Background(), "", strings.NewReader(body))

			assert.Nil(t, result)
			assert{{ r }}BadRequest(t, err)
			mockService.AssertNotCalled(t, "Create", mock.Anything, mock.Anything, mock.Anything)
		})
	}
}

func TestCreate{{ r }}_ReturnsValidationError_WhenBodyCannotBeRead(t *testing.T) {
