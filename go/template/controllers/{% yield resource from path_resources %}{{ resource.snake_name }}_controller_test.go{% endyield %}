func assert{{ r }}NotFound(t *testing.T, err error) {
	t.Helper()
	var notFound *models.NotFoundError
	if assert.ErrorAs(t, err, &notFound) {
		assert.Equal(t, "{{ r }} with id not-a-uuid was not found.", notFound.Message)
	}
}
