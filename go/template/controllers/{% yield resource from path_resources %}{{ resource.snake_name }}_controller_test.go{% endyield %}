// A JSON body with one property set to a raw JSON value, or removed when value is empty.
func with{{ r }}Property(body, name, value string) string {
	properties := map[string]json.RawMessage{}
	_ = json.Unmarshal([]byte(body), &properties)
	if value == "" {
		delete(properties, name)
	} else {
		properties[name] = json.RawMessage(value)
	}
	data, _ := json.Marshal(properties)
	return string(data)
}

// The request as JSON, so tests compare it field by field with the body sent.
func {{ lc }}RequestProperties(t *testing.T, req any) map[string]json.RawMessage {
	t.Helper()
	data, err := json.Marshal(req)
	assert.NoError(t, err)
	properties := map[string]json.RawMessage{}
	assert.NoError(t, json.Unmarshal(data, &properties))
	return properties
}

// Bodies every write must reject: a property the server sets, an unknown one, and each field's wrongly
// typed value, null unless nullable, and values just outside its rules.
func invalid{{ r }}Bodies(valid string, required, refused []string) []string {
	bodies := []string{`[]`, `null`, `{not json`, with{{ r }}Property(valid, "not_a_field", `1`)}
	for _, property := range [][2]string{
{%- for f in system %}
		{"{{ f.name }}", {{ json_string(f.sample) }}},
{%- endfor %}
	} {
		bodies = append(bodies, with{{ r }}Property(valid, property[0], property[1]))
	}
	for _, name := range refused {
		bodies = append(bodies, with{{ r }}Property(valid, name, `"x"`))
	}
	properties := map[string]json.RawMessage{}
	_ = json.Unmarshal([]byte(valid), &properties)
	for _, value := range [][2]string{
{%- for f in client %}
		{"{{ f.name }}", {{ json_string(f.invalid) }}},
{%- if not f.nullable %}
		{"{{ f.name }}", "null"},
{%- endif %}
{%- for v in f.violations %}
		{"{{ f.name }}", {{ json_string(v) }}},
{%- endfor %}
{%- endfor %}
	} {
		if _, ok := properties[value[0]]; ok {
			bodies = append(bodies, with{{ r }}Property(valid, value[0], value[1]))
		}
	}
	for _, name := range required {
		bodies = append(bodies, with{{ r }}Property(valid, name, ""))
	}
	return bodies
}
