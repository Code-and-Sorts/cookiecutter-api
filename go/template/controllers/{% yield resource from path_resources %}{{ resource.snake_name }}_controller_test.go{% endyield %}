func TestGet{{ r }}_Returns{{ r }}Dto(t *testing.T) {
	mockService := new(Mock{{ r }}Service)
	controller := newTest{{ r }}Controller(mockService)
	expected := &models.{{ r }}Dto{Id: test{{ r }}ID, Name: "mock{{ r }}"}
	mockService.On("Get", mock.Anything, test{{ r }}ID).Return(expected, nil)

	result, err := controller.Get(context.Background(), test{{ r }}ID)

	assert.NoError(t, err)
	assert.Equal(t, expected, result)
}

func TestGet{{ r }}_ReturnsNotFound_WhenIdIsNotUUID(t *testing.T) {
