func Test{{ Op }}{{ r }}_RejectsInvalidBodies(t *testing.T) {
	required := []string{ {%- for f in required %}"{{ f.name }}"{{ ", " if not loop.last }}{% endfor -%} }
	refused := []string{ {%- for f in refused %}"{{ f.name }}"{{ ", " if not loop.last }}{% endfor -%} }

	for _, body := range invalidBodies(valid{{ r }}{{ Op }}Body, required, refused, rejected{{ r }}Values) {
		t.Run(body, func(t *testing.T) {
			mockService := new(Mock{{ r }}Service)
			controller := newTest{{ r }}Controller(mockService)

			result, err := {{ call(op, "body") }}

			assert.Nil(t, result)
			assert{{ r }}BadRequest(t, err)
			mockService.AssertNotCalled(t, "{{ Op }}", mock.Anything, mock.Anything, mock.Anything)
		})
	}
}
{%- set boundaries = [] %}
{%- for f in accepted %}{% for v in f.boundaries %}{% set _ = boundaries.append((f.name, v)) %}{% endfor %}{% endfor %}
{%- if boundaries %}

func Test{{ Op }}{{ r }}_AcceptsEdgeValues(t *testing.T) {
	for _, value := range [][2]string{
{%- for name, v in boundaries %}
		{"{{ name }}", {{ json_string(v) }}},
{%- endfor %}
	} {
		mockService := new(Mock{{ r }}Service)
		controller := newTest{{ r }}Controller(mockService)
		mockService.On("{{ Op }}", mock.Anything, mock.Anything, "").Return(test{{ r }}Dto(), nil)

		_, err := {{ call(op, "withProperty(valid" ~ r ~ Op ~ "Body, value[0], value[1])") }}

		assert.NoError(t, err, value[0]+"="+value[1])
		properties := requestProperties(t, mockService.Calls[0].Arguments.Get(1))
		assert.JSONEq(t, value[1], string(properties[value[0]]))
	}
}
