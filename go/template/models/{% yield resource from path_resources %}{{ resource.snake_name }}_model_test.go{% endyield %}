{%- from 'go/_model.jinja' import json_string, pointer -%}
{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set fields = resource.fields -%}
{%- set shown = resource.client_fields | rejectattr("hidden") | list -%}
{#- Asserts a field a body left out holds its default: a fresh value for a dynamic one, none without a default. -#}
{%- macro expect_default(f, record) -%}
{%- if f.dynamic -%}
assert.NotNil(t, {{ record }}.{{ f.pascal }})
{%- elif f.defaulted -%}
assert.Equal(t, {{ pointer(f, f.default) }}, {{ record }}.{{ f.pascal }})
{%- else -%}
assert.Nil(t, {{ record }}.{{ f.pascal }})
{%- endif -%}
{%- endmacro -%}
package models

import (
	"encoding/json"
	"testing"

	"github.com/stretchr/testify/assert"
)

func sample{{ r }}() {{ r }} {
	item := {{ r }}{BaseEntity: NewBaseEntity()}
{%- for f in resource.client_fields %}
	item.{{ f.pascal }} = {{ pointer(f, f.sample) }}
{%- endfor %}
	return item
}

func Test{{ r }}Dto_HoldsTheIdAndEveryShownField(t *testing.T) {
	data, err := json.Marshal(To{{ r }}Dto(sample{{ r }}()))

	assert.NoError(t, err)
	properties := map[string]json.RawMessage{}
	assert.NoError(t, json.Unmarshal(data, &properties))
	assert.Len(t, properties, {{ 1 + (shown | length) }})
{%- for f in shown %}
	assert.JSONEq(t, {{ json_string(f.sample) }}, string(properties["{{ f.name }}"]))
{%- endfor %}
}

func Test{{ r }}Dto_ReadsAMissingFieldAsItsStaticDefault(t *testing.T) {
	data, err := json.Marshal(To{{ r }}Dto({{ r }}{}))

	assert.NoError(t, err)
	properties := map[string]json.RawMessage{}
	assert.NoError(t, json.Unmarshal(data, &properties))
{%- for f in shown %}
	assert.JSONEq(t, {{ json_string(f.read_default) }}, string(properties["{{ f.name }}"]))
{%- endfor %}
}
