{%- from 'go/_model.jinja' import json_string, pointer -%}
{%- set r = resource.name -%}
{%- set ops = resource.operations -%}
{%- set fields = resource.fields -%}
{%- set shown = (base_fields | rejectattr("system") | rejectattr("hidden") | list) + (fields | rejectattr("hidden") | list) -%}
package models

import (
	"encoding/json"
	"testing"

	"github.com/stretchr/testify/assert"
)

// A stored record holding every field's sample value.
func sample{{ r }}() {{ r }} {
	item := {{ r }}{BaseEntity: NewBaseEntity()}
{%- for f in base_fields | rejectattr("system") %}
	item.{{ f.pascal }} = {{ pointer(f, f.sample) }}
{%- endfor %}
{%- for f in fields %}
	item.{{ f.pascal }} = {{ pointer(f, f.sample) }}
{%- endfor %}
	return item
}

func Test{{ r }}Dto_HoldsTheIdAndEveryShownField(t *testing.T) {
	data, err := json.Marshal(To{{ r }}Dto(sample{{ r }}()))

	assert.NoError(t, err)
	properties := map[string]json.RawMessage{}
	assert.NoError(t, json.Unmarshal(data, &properties))
	assert.Len(t, properties, {{ 1 + (shown | length) }})
{%- for f in shown %}
	assert.JSONEq(t, {{ json_string(f.sample) }}, string(properties["{{ f.name }}"]))
{%- endfor %}
}

func Test{{ r }}Dto_ReadsAMissingFieldAsItsStaticDefault(t *testing.T) {
	data, err := json.Marshal(To{{ r }}Dto({{ r }}{}))

	assert.NoError(t, err)
	properties := map[string]json.RawMessage{}
	assert.NoError(t, json.Unmarshal(data, &properties))
{%- for f in shown %}
	assert.JSONEq(t, {{ json_string(f.default if (f.has_default and not f.dynamic and not f.nullable) else none) }}, string(properties["{{ f.name }}"]))
{%- endfor %}
}
{%- if "create" in ops %}

func TestCreate{{ r }}Request_DefaultsFieldsTheBodyLeavesOut(t *testing.T) {
	item := NewCreate{{ r }}Request().ToEntity()

	assert.Len(t, item.Id, 36)
{%- for f in fields if f.has_default %}
{%- if f.dynamic %}
	assert.NotNil(t, item.{{ f.pascal }})
{%- elif f.default is none %}
	assert.Nil(t, item.{{ f.pascal }})
{%- else %}
	assert.Equal(t, {{ pointer(f, f.default) }}, item.{{ f.pascal }})
{%- endif %}
{%- endfor %}
{%- for f in fields if not f.has_default %}
	assert.Nil(t, item.{{ f.pascal }})
{%- endfor %}
}
{%- endif %}
{%- if "replace" in ops %}

func TestReplace{{ r }}Request_ResetsAcceptedFieldsAndKeepsTheRest(t *testing.T) {
	stored := sample{{ r }}()
	created := stored.CreatedTimestamp

	NewReplace{{ r }}Request().ApplyTo(&stored)

	assert.Equal(t, created, stored.CreatedTimestamp)
{%- for f in fields %}
{%- if not f.in_replace %}
	assert.Equal(t, {{ pointer(f, f.sample) }}, stored.{{ f.pascal }})
{%- elif f.dynamic %}
	assert.NotNil(t, stored.{{ f.pascal }})
{%- elif f.default is none %}
	assert.Nil(t, stored.{{ f.pascal }})
{%- else %}
	assert.Equal(t, {{ pointer(f, f.default) }}, stored.{{ f.pascal }})
{%- endif %}
{%- endfor %}
}
{%- endif %}
{%- if "update" in ops %}

func TestUpdate{{ r }}Request_ChangesOnlyTheFieldsSent(t *testing.T) {
	stored := sample{{ r }}()
	unchanged := stored

	Update{{ r }}Request{BaseUpdateRequest: BaseUpdateRequest{Sent: map[string]bool{}}}.ApplyTo(&stored)
	assert.Equal(t, unchanged, stored)
{%- for f in fields | selectattr("in_update") %}

	Update{{ r }}Request{BaseUpdateRequest: BaseUpdateRequest{Sent: map[string]bool{"{{ f.name }}": true}}}.ApplyTo(&stored)
	assert.Nil(t, stored.{{ f.pascal }})
	stored = unchanged
{%- endfor %}
}
{%- endif %}
