	item := NewCreate{{ r }}Request().ToEntity()

	assert.Len(t, item.Id, 36)
{%- for f in fields %}
	{{ expect_default(f, "item") }}
{%- endfor %}
}
{%- endif %}
{%- if "replace" in ops %}

func TestReplace{{ r }}Request_ResetsAcceptedFieldsAndKeepsTheRest(t *testing.T) {
	stored := sample{{ r }}()
	created := stored.CreatedTimestamp

	NewReplace{{ r }}Request().ApplyTo(&stored)

	assert.Equal(t, created, stored.CreatedTimestamp)
{%- for f in fields %}
{%- if not f.in_replace %}
	assert.Equal(t, {{ pointer(f, f.sample) }}, stored.{{ f.pascal }})
{%- else %}
	{{ expect_default(f, "stored") }}
{%- endif %}
{%- endfor %}
}
{%- endif %}
{%- if "update" in ops %}

func TestUpdate{{ r }}Request_ChangesOnlyTheFieldsSent(t *testing.T) {
	stored := sample{{ r }}()
	unchanged := stored

	Update{{ r }}Request{BaseUpdateRequest: BaseUpdateRequest{Sent: map[string]bool{}}}.ApplyTo(&stored)
	assert.Equal(t, unchanged, stored)
{%- for f in fields | selectattr("in_update") %}

	Update{{ r }}Request{BaseUpdateRequest: BaseUpdateRequest{Sent: map[string]bool{"{{ f.name }}": true}}}.ApplyTo(&stored)
	assert.Nil(t, stored.{{ f.pascal }})
	stored = unchanged
{%- endfor %}
}
{%- endif %}
