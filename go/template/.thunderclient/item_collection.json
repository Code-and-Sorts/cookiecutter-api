{%- set route_prefix = '' if cloud_service == 'AWS Lambda' else '/api' -%}
{%- set ns = namespace(sort=0) -%}
{
    "clientName": "Thunder Client",
    "collectionName": "{{ project_class_name }} Requests",
    "collectionId": "17bc9346-e6fe-4e42-8430-7ad3bb80da7b",
    "dateExported": "2024-08-10T22:25:59.850Z",
    "version": "1.2",
    "folders": [],
    "requests": [
{%- for resource in resources %}
{%- set id_var = '{{' ~ (resource.name | to_lower_camel) ~ 'Id}}' %}
{%- set base_url = '{{baseUrl}}' ~ route_prefix ~ '/' ~ resource.endpoint %}
{%- for op in ["list", "get_by_id", "create", "update", "replace", "delete"] if op in resource.operations %}
{%- if op == "list" %}{% set label, method, url, status = "Get " ~ resource.name ~ " List", "GET", base_url, "200" %}
{%- elif op == "get_by_id" %}{% set label, method, url, status = "Get " ~ resource.name ~ " by ID", "GET", base_url ~ "/" ~ id_var, "200" %}
{%- elif op == "create" %}{% set label, method, url, status = "Create " ~ resource.name, "POST", base_url, "201" %}
{%- elif op == "update" %}{% set label, method, url, status = "Update " ~ resource.name, "PATCH", base_url ~ "/" ~ id_var, "200" %}
{%- elif op == "replace" %}{% set label, method, url, status = "Replace " ~ resource.name, "PUT", base_url ~ "/" ~ id_var, "200" %}
{%- else %}{% set label, method, url, status = "Delete " ~ resource.name, "DELETE", base_url ~ "/" ~ id_var, "200" %}
{%- endif %}
{%- if ns.sort > 0 %},{% endif %}
{%- set ns.sort = ns.sort + 10000 %}
        {
            "_id": "{{ resource.endpoint }}-{{ op | replace('_', '-') }}",
            "colId": "17bc9346-e6fe-4e42-8430-7ad3bb80da7b",
            "containerId": "",
            "name": "{{ label }}",
            "url": "{{ url }}",
            "method": "{{ method }}",
            "sortNum": {{ ns.sort }},
            "created": "2024-08-10T20:25:19.095Z",
            "modified": "2024-08-10T20:42:18.713Z",
            "headers": [],
{%- if op == "create" %}
            "body": {
                "type": "json",
                "raw": "{\n  \"name\": \"{{ resource.name }}1\",\n  \"createdBy\": \"ThunderClient\",\n  \"updatedBy\": \"ThunderClient\"\n}",
                "form": []
            },
{%- elif op == "update" %}
            "body": {
                "type": "json",
                "raw": "{\n  \"name\": \"{{ resource.name }}1-Update\",\n  \"updatedBy\": \"ThunderClient\"\n}",
                "form": []
            },
{%- elif op == "replace" %}
            "body": {
                "type": "json",
                "raw": "{\n  \"name\": \"{{ resource.name }}1-Replace\",\n  \"updatedBy\": \"ThunderClient\"\n}",
                "form": []
            },
{%- endif %}
            "tests": [
                {
                    "type": "res-code",
                    "custom": "",
