AWSTemplateFormatVersion: '2010-09-09'
Transform: AWS::Serverless-2016-10-31
Description: {{ project_description }}
Metadata:
  cfn-lint:
    config:
      # SAM's generated usage plan resources carry a redundant DependsOn.
      ignore_checks:
        - W3005

Globals:
  Function:
    Timeout: 30
  Api:
    Auth:
      ApiKeyRequired: true
      UsagePlan:
        CreateUsagePlan: PER_API

Resources:
  {{ project_class_name }}Function:
    Type: AWS::Serverless::Function
    Metadata:
      BuildMethod: go1.x
    Properties:
      Handler: bootstrap
      Runtime: provided.al2023
      CodeUri: .
      Description: {{ project_description }}
      Architectures:
        - x86_64
      Environment:
        Variables:
{%- for c in path_resources | unique(attribute='container') %}
          DYNAMODB_TABLE_NAME_{{ c.env_key }}: !Ref {{ c.container_class }}Table
{%- endfor %}
      Policies:
{%- for c in path_resources | unique(attribute='container') %}
        - DynamoDBCrudPolicy:
            TableName: !Ref {{ c.container_class }}Table
{%- endfor %}
      Events:
{%- for resource in resources %}
{%- if "get_by_id" in resource.operations %}
        Get{{ resource.name }}ById:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{id}
            Method: get
{%- endif %}
{%- if "list" in resource.operations %}
        Get{{ resource.name }}List:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}
            Method: get
{%- endif %}
{%- if "create" in resource.operations %}
        Create{{ resource.name }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}
            Method: post
{%- endif %}
{%- if "update" in resource.operations %}
        Update{{ resource.name }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{id}
            Method: patch
{%- endif %}
{%- if "replace" in resource.operations %}
        Replace{{ resource.name }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{id}
            Method: put
{%- endif %}
{%- if "delete" in resource.operations %}
        Delete{{ resource.name }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{id}
            Method: delete
{%- endif %}
{%- endfor %}
{%- if health_endpoint %}
        Health:
          Type: Api
          Properties:
            Path: /{{ health_endpoint }}
            Method: get
            Auth:
              ApiKeyRequired: false
{%- endif %}
        OpenApi:
          Type: Api
          Properties:
            Path: /openapi.json
            Method: get
            Auth:
              ApiKeyRequired: false
{% for c in path_resources | unique(attribute='container') %}
  {{ c.container_class }}Table:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: {{ c.container }}
      AttributeDefinitions:
        - AttributeName: id
          AttributeType: S
      KeySchema:
        - AttributeName: id
          KeyType: HASH
      BillingMode: PAY_PER_REQUEST
{% endfor %}
Outputs:
  {{ project_class_name }}Api:
    Description: API Gateway endpoint URL
    Value: !Sub "https://${ServerlessRestApi}.execute-api.${AWS::Region}.amazonaws.com/Prod/"
  {{ project_class_name }}ApiKeyId:
    Description: API key id; read the key with aws apigateway get-api-key --api-key <id> --include-value --query value --output text
    Value: !Ref ServerlessRestApiApiKey
  {{ project_class_name }}Function:
    Description: Lambda Function ARN
    Value: !GetAtt {{ project_class_name }}Function.Arn
{%- for c in path_resources | unique(attribute='container') %}
  {{ c.container_class }}TableName:
    Description: DynamoDB table name for the {{ c.container }} container
    Value: !Ref {{ c.container_class }}Table
{%- endfor %}
