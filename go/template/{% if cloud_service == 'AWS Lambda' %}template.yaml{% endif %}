AWSTemplateFormatVersion: '2010-09-09'
Transform: AWS::Serverless-2016-10-31
Description: {{ project_description }}

Globals:
  Function:
    Timeout: 30

Resources:
  {{ project_class_name }}Function:
    Type: AWS::Serverless::Function
    Metadata:
      BuildMethod: go1.x
    Properties:
      Handler: bootstrap
      Runtime: provided.al2023
      CodeUri: .
      Description: {{ project_description }}
      Architectures:
        - x86_64
      Environment:
        Variables:
{%- for container in resources | map(attribute='container') | unique %}
          DYNAMODB_TABLE_NAME_{{ container | upper | replace('-', '_') }}: !Ref {{ container | to_camel }}Table
{%- endfor %}
      Policies:
{%- for container in resources | map(attribute='container') | unique %}
        - DynamoDBCrudPolicy:
            TableName: !Ref {{ container | to_camel }}Table
{%- endfor %}
      Events:
{%- for resource in resources %}
{%- if "get_by_id" in resource.operations %}
        Get{{ resource.name }}ById:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{item_id}
            Method: get
{%- endif %}
{%- if "list" in resource.operations %}
        Get{{ resource.name }}List:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}
            Method: get
{%- endif %}
{%- if "create" in resource.operations %}
        Create{{ resource.name }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}
            Method: post
{%- endif %}
{%- if "update" in resource.operations %}
        Update{{ resource.name }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{item_id}
            Method: patch
{%- endif %}
{%- if "replace" in resource.operations %}
        Replace{{ resource.name }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{item_id}
            Method: put
{%- endif %}
{%- if "delete" in resource.operations %}
        Delete{{ resource.name }}:
          Type: Api
          Properties:
            Path: /{{ resource.endpoint }}/{item_id}
            Method: delete
{%- endif %}
{%- endfor %}
        Health:
          Type: Api
          Properties:
            Path: /health
            Method: get
{% for container in resources | map(attribute='container') | unique %}
  {{ container | to_camel }}Table:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: {{ container }}
      AttributeDefinitions:
        - AttributeName: id
          AttributeType: S
      KeySchema:
        - AttributeName: id
          KeyType: HASH
      BillingMode: PAY_PER_REQUEST
{% endfor %}
Outputs:
  {{ project_class_name }}Api:
    Description: API Gateway endpoint URL
    Value: !Sub "https://${ServerlessRestApi}.execute-api.${AWS::Region}.amazonaws.com/Prod/"
  {{ project_class_name }}Function:
    Description: Lambda Function ARN
    Value: !GetAtt {{ project_class_name }}Function.Arn
{%- for container in resources | map(attribute='container') | unique %}
  {{ container | to_camel }}TableName:
    Description: DynamoDB table name for the {{ container }} container
    Value: !Ref {{ container | to_camel }}Table
{%- endfor %}
