{%- for op in ["update", "replace"] if op in ops %}
{%- set Op = op | capitalize %}
{%- set accepted = client | selectattr("in_" ~ op) | list %}

func Test{{ Op }}{{ r }}_AppliesTheRequestToTheStoredRecord(t *testing.T) {
	mockRepo, service := setup{{ r }}ServiceTest()
	req := models.{{ Op }}{{ r }}Request{Id: test{{ r }}ID}
{%- if op == "update" %}
	req.Sent = map[string]bool{ {%- for f in accepted %}"{{ f.name }}": true{{ ", " if not loop.last }}{% endfor -%} }
{%- endif %}
{%- for f in accepted %}
	req.{{ f.pascal }} = {{ pointer(f, f.sample, "models.") }}
{%- endfor %}
	expected := test{{ r }}Dto()
	mockRepo.On("{{ Op }}", mock.Anything, test{{ r }}ID, "alice", mock.Anything).Return(expected, nil)

	result, err := service.{{ Op }}(context.Background(), req, "alice")

	assert.NoError(t, err)
	assert.Equal(t, expected, result)
	apply := mockRepo.Calls[0].Arguments.Get(3).(func(*models.{{ r }}))
	var stored models.{{ r }}
	apply(&stored)
{%- for f in accepted %}
	assert.Equal(t, req.{{ f.pascal }}, stored.{{ f.pascal }})
{%- endfor %}
}
{%- endfor %}
