{
    "IsEncrypted": false,
    "Values": {
        "AzureWebJobsStorage": "UseDevelopmentStorage=true",
        "FUNCTIONS_WORKER_RUNTIME": "custom",
        "CosmosDbEndpoint": "{{ '{{CosmosDbEndpoint}}' }}",
        "CosmosDbKey": "{{ '{{CosmosDbKey}}' }}",
        "CosmosDbDatabaseName": "{{ '{{CosmosDbDatabaseName}}' }}"{% for c in path_resources | unique(attribute='container') %},
        "CosmosDbContainerName_{{ c.container_class }}": "{{ c.container }}"{% endfor %}
    }
}
