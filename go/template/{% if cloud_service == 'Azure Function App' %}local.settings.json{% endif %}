{%- if cloud_service == 'Azure Function App' %}
{
    "IsEncrypted": false,
    "Values": {
        "AzureWebJobsStorage": "UseDevelopmentStorage=true",
        "FUNCTIONS_WORKER_RUNTIME": "custom",
        "CosmosDbEndpoint": "{{ '{{CosmosDbEndpoint}}' }}",
        "CosmosDbKey": "{{ '{{CosmosDbKey}}' }}",
        "CosmosDbDatabaseName": "{{ '{{CosmosDbDatabaseName}}' }}"{% for container in resources | map(attribute='container') | unique %},
        "CosmosDbContainerName_{{ container | to_camel }}": "{{ container }}"{% endfor %}
    }
}
{%- endif %}
{%- if cloud_service == 'AWS Lambda' %}
{
    "Values": {
{%- for container in resources | map(attribute='container') | unique %}
        "DYNAMODB_TABLE_NAME_{{ container | upper | replace('-', '_') }}": "{{ container }}"{% if not loop.last %},{% endif %}
{%- endfor %}
    }
}
{%- endif %}
