{
    "IsEncrypted": false,
    "Values": {
        "AzureWebJobsStorage": "UseDevelopmentStorage=true",
        "FUNCTIONS_WORKER_RUNTIME": "custom",
        "CosmosDbEndpoint": "{{ '{{CosmosDbEndpoint}}' }}",
        "CosmosDbKey": "{{ '{{CosmosDbKey}}' }}",
        "CosmosDbDatabaseName": "{{ '{{CosmosDbDatabaseName}}' }}"{% for container in resources | map(attribute='container') | unique %},
        "CosmosDbContainerName_{{ container | to_camel }}": "{{ container }}"{% endfor %}
    }
}
